---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import fs from 'fs';
import path from 'path';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
  noindex?: boolean;
  hideNavFooter?: boolean;
}

const {
  title = "Đào Xuân Quảng | AI, Digital Marketing & Solopreneur",
  description = "Website cá nhân chia sẻ về cuộc sống, kiến thức marketing global, setup hệ thống AI Agent cho doanh nghiệp và các sản phẩm số.",
  image = "/og-image.jpg",
  articleDate,
  noindex = false,
  hideNavFooter = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://daoxuanquang.com.vn');

// Dynamically list all markdown files on the server's disk to populate serverSlugs
const contentDir = path.resolve('./src/content');
const categories = ['ai', 'marketing', 'cuoc-song'];
const serverSlugsList: string[] = [];

for (const cat of categories) {
  const catDir = path.join(contentDir, cat);
  if (fs.existsSync(catDir)) {
    const files = fs.readdirSync(catDir).filter(f => f.endsWith('.md') || f.endsWith('.mdx'));
    for (const file of files) {
      serverSlugsList.push(file.replace(/\.mdx?$/, ''));
    }
  }
}
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Robots index control -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Immediate localStorage & DOM cleanup for deleted and legacy posts -->
    <script is:inline>
      (function() {
        try {
          var serverSlugs = {JSON.stringify(serverSlugsList)};
          var deleted = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
          if (!Array.isArray(deleted)) deleted = [];

          var normalizeText = function(s) {
            return (s || '')
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '')
              .replace(/[đĐ]/g, 'd')
              .toLowerCase()
              .replace(/[^a-z0-9]/g, '');
          };

          // Ensure serverSlugs are NEVER present in deleted_post_slugs
          var cleanDeleted = deleted.filter(function(ds) {
            var dsNorm = normalizeText(ds);
            var dsOnly = dsNorm.split('/').pop() || '';
            for (var k = 0; k < serverSlugs.length; k++) {
              var ssNorm = normalizeText(serverSlugs[k]);
              if (dsNorm === ssNorm || dsOnly === ssNorm) return false;
            }
            return true;
          });
          if (cleanDeleted.length !== deleted.length) {
            localStorage.setItem('deleted_post_slugs', JSON.stringify(cleanDeleted));
            deleted = cleanDeleted;
          }

          var normServerSlugs = serverSlugs.map(function(ss) { return normalizeText(ss); });
          var custom = localStorage.getItem('custom_saved_posts');
          if (custom) {
            var posts = JSON.parse(custom);
            var seen = {};
            var clean = [];
            for (var i = 0; i < posts.length; i++) {
              var p = posts[i];
              var t = normalizeText(p.title);
              var s = normalizeText(p.slug || p.id);
              var sOnly = s.split('/').pop() || '';

              var isDuplicate = false;
              for (var k = 0; k < normServerSlugs.length; k++) {
                var nss = normServerSlugs[k];
                if (s === nss || sOnly === nss || (t && t === nss) || (t && nss && (t.indexOf(nss) !== -1 || nss.indexOf(t) !== -1))) {
                  isDuplicate = true;
                  break;
                }
              }

              if (isDuplicate || deleted.indexOf(s) !== -1 || deleted.indexOf(sOnly) !== -1 || (t && seen[t])) {
                continue;
              }
              if (t) seen[t] = true;
              clean.push(p);
            }
            localStorage.setItem('custom_saved_posts', JSON.stringify(clean));
          }

          // DOM Purge helper for deleted post cards (EXACT slug matching only)
          var purgeDeletedDOM = function() {
            document.querySelectorAll('a[href]').forEach(function(a) {
              var rawHref = a.getAttribute('href') || '';
              var cleanHref = rawHref.split('?')[0].split('#')[0].replace(/\/$/, '').toLowerCase();
              var hrefSlug = cleanHref.split('/').pop() || '';
              if (!hrefSlug) return;

              // NEVER purge active serverSlugs
              if (serverSlugs.indexOf(hrefSlug) !== -1) return;

              for (var d = 0; d < deleted.length; d++) {
                var delItem = (deleted[d] || '').toLowerCase().replace(/\.mdx?$/, '');
                var delSlug = delItem.split('/').pop() || '';
                if (delSlug && hrefSlug === delSlug) {
                  var card = a.closest('.posts-grid-container > article, .grid > a, div.group, article') || a;
                  card.remove();
                  break;
                }
              }
            });
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', purgeDeletedDOM);
          } else {
            purgeDeletedDOM();
          }
        } catch(e) {}
      })();
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- Pre-render Theme Check (Critical to prevent FOUC) -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      
      if (typeof localStorage !== 'undefined') {
        // Watch for changes to localstorage to keep multiple tabs in sync
        window.addEventListener('storage', (e) => {
          if (e.key === 'theme') {
            const isDark = e.newValue === 'dark';
            document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
          }
        });
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-white text-slate-800 dark:bg-dark-bg dark:text-slate-200 transition-colors duration-300 overflow-x-hidden">
    <!-- Navbar -->
    {!hideNavFooter && <Navbar />}

    <!-- Main Content -->
    <main class={`flex-grow flex flex-col ${!hideNavFooter ? 'pt-16' : ''}`}>
      <slot />
    </main>

    <!-- Footer -->
    {!hideNavFooter && <Footer />}

    <!-- Dynamic Article Fallback Renderer -->
    <script>
      document.addEventListener('DOMContentLoaded', async () => {
        try {
          const newYtText = 'Cách đây không lâu, thấy người ta rầm rộ khoe làm YouTube bằng AI kiếm vài nghìn USD mỗi tháng, tôi cũng mang hết tiền tiết kiệm đi học, đêm ngày thức trắng tạo video tự động. Nhưng đời không như là mơ. Vừa làm được một thời gian ngắn thì nền tảng liên tục siết chặt chính sách, bóp tương tác và càn quét nội dung AI rác. Công sức và chi phí đổ sông đổ biển, cày 14 tiếng một ngày mà thu nhập vẫn là số 0 tròn trĩnh, kiệt quệ hoàn toàn cả về thể xác lẫn tinh thần.';

          // 1. Direct DOM sweep for any article containing old Dropshipping text
          const articleEl = document.querySelector('article');
          if (articleEl && (articleEl.innerHTML.includes('Dropshipping') || articleEl.innerHTML.includes('khoe làm Dropshipping'))) {
            articleEl.innerHTML = articleEl.innerHTML.replace(
              /Thời gian trước, thấy người ta khoe làm Dropshipping[\s\S]*?kiệt quệ hoàn toàn cả thể xác lẫn tinh thần\./gi,
              newYtText
            );
          }

          // 3. Auto-convert ALL CAPS headings in article body to Sentence Case
          document.querySelectorAll('article h1, article h2, article h3, article h4, .prose h1, .prose h2, .prose h3, .prose h4').forEach((el) => {
            const t = el.textContent || '';
            const lettersOnly = t.replace(/[^a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/g, '');
            if (lettersOnly.length > 4 && lettersOnly === lettersOnly.toUpperCase()) {
              let lower = t.toLowerCase();
              lower = lower.charAt(0).toUpperCase() + lower.slice(1);
              el.textContent = lower.replace(/\b(ai|seo|sop|hot|vps|ui|ux|ads|cpm|cpc)\b/gi, (m) => m.toUpperCase());
            }
          });

          // 4. Auto-upgrade standalone paragraph lines into H2/H3 headings if they look like section titles
          document.querySelectorAll('.prose p').forEach((pEl) => {
            const t = (pEl.textContent || '').trim();
            if (!t || pEl.querySelector('img, a, iframe')) return;

            const cleanText = t.replace(/["'”]/g, '').trim();
            const hasLetters = /[a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/.test(cleanText);
            const isEndsWithPeriod = cleanText.endsWith('.') || cleanText.endsWith(',');
            
            const isH3Pattern = /^(phương pháp|bước|cách|gợi ý|lưu ý|\d+\.\d+)\s*\d*[:\.]/i.test(cleanText);
            const isH2Explicit = /^(bài này|\d+\.|tóm lại|cái bẫy|đừng|hãy|kết luận|nguyên nhân|giải pháp|tổng kết)/i.test(cleanText);
            const isShortTitleLine = hasLetters && cleanText.length >= 4 && cleanText.length <= 110 && !isEndsWithPeriod && !t.includes('http');

            if (isH3Pattern || isH2Explicit || isShortTitleLine) {
              const isH3 = isH3Pattern;
              const newEl = document.createElement(isH3 ? 'h3' : 'h2');
              newEl.className = isH3 
                ? 'text-lg sm:text-xl font-bold text-brand-green dark:text-emerald-400 mt-8 mb-3 pl-3 border-l-4 border-brand-green leading-snug'
                : 'text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-10 mb-4 border-b-2 border-slate-200 dark:border-slate-800 pb-2.5 leading-snug';
              newEl.textContent = formatCleanTitle(t.replace(/^#+\s*/, ''));
              pEl.replaceWith(newEl);
            }
          });

          const pathname = window.location.pathname.replace(/\/$/, '');
          const parts = pathname.split('/').filter(Boolean);
          const validCategories = ['cuoc-song', 'marketing', 'ai'];

          // If URL is /category/slug
          if (parts.length === 2 && validCategories.includes(parts[0])) {
            const category = parts[0];
            const slug = parts[1];

            let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
            let post = customPosts.find((p: any) => p.slug === slug || p.id === `${category}/${slug}` || p.id === slug);

            if (!post) {
              try {
                const res = await fetch('/api/posts');
                if (res.ok) {
                  const data = await res.json();
                  if (data.posts) {
                    post = data.posts.find((p: any) => p.slug === slug || p.id === `${category}/${slug}`);
                  }
                }
              } catch (e) {}
            }

            // Always update <time> tag on article page if pubDate was updated in Admin
            if (post && post.pubDate) {
              const timeEl = document.getElementById('article-pub-date') || document.querySelector('article header time, main time, time');
              if (timeEl) {
                const pubDateObj = new Date(post.pubDate);
                if (!isNaN(pubDateObj.getTime())) {
                  const formattedDate = pubDateObj.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' });
                  timeEl.setAttribute('datetime', pubDateObj.toISOString());
                  timeEl.textContent = `📅 ${formattedDate}`;
                }
              }
            }

            // Check if actual article detail h1 is missing on page
            const existingArticleTitle = document.querySelector('article h1');
            if (!existingArticleTitle && post) {
              if (post.content) {
                if (post.content.includes('Dropshipping') || post.content.includes('khoe làm Dropshipping')) {
                  post.content = post.content.replace(
                    /Thời gian trước, thấy người ta khoe làm Dropshipping[\s\S]*?kiệt quệ hoàn toàn cả thể xác lẫn tinh thần\./gi,
                    'Cách đây không lâu, thấy người ta rầm rộ khoe làm YouTube bằng AI kiếm vài nghìn USD mỗi tháng, tôi cũng mang hết tiền tiết kiệm đi học, đêm ngày thức trắng tạo video tự động. Nhưng đời không như là mơ. Vừa làm được một thời gian ngắn thì nền tảng liên tục siết chặt chính sách, bóp tương tác và càn quét nội dung AI rác. Công sức và chi phí đổ sông đổ biển, cày 14 tiếng một ngày mà thu nhập vẫn là số 0 tròn trĩnh, kiệt quệ hoàn toàn cả về thể xác lẫn tinh thần.'
                  );
                  try {
                    let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
                    const idx = customPosts.findIndex((p: any) => p.slug === slug || p.id === `${category}/${slug}` || p.id === slug);
                    if (idx !== -1) {
                      customPosts[idx].content = post.content;
                      localStorage.setItem('custom_saved_posts', JSON.stringify(customPosts));
                    }
                  } catch(e) {}
                }
              }

              const pubDateObj = post.pubDate ? new Date(post.pubDate) : new Date();
              const formattedDate = pubDateObj.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' });

              let formattedContent = post.content || '';
                const rawLines = formattedContent.split(/\r?\n/).map((l: string) => l.trim()).filter(Boolean);
                formattedContent = rawLines.map((line: string) => {
                  const cleanLine = line.replace(/^[#\-\*]+\s*/, '');
                  const cleanText = cleanLine.replace(/["'”]/g, '').trim();
                  const hasLetters = /[a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/.test(cleanText);
                  const isEndsWithPeriod = cleanText.endsWith('.') || cleanText.endsWith(',');
                  
                  const isH3 = line.startsWith('###') || cleanText.toLowerCase().startsWith('phương pháp');
                  const isExplicitH2 = line.startsWith('##') || line.startsWith('#');
                  const isExplicitPattern = /^(bài này|\d+\.|phương pháp \d+|tóm lại|cái bẫy|đừng|hãy|kết luận)/i.test(cleanText);
                  const isAllCaps = hasLetters && cleanText.length >= 4 && cleanText.length < 120 && cleanText === cleanText.toUpperCase();
                  const isShortHeadingLine = hasLetters && cleanText.length >= 4 && cleanText.length <= 110 && !isEndsWithPeriod && !line.includes('http');

                  const isH2 = isExplicitH2 || isExplicitPattern || isAllCaps || isShortHeadingLine;
                  
                  if (isH3) {
                    return `<h3 class="text-lg sm:text-xl font-bold text-brand-green dark:text-emerald-400 mt-8 mb-3 pl-3 border-l-4 border-brand-green leading-snug">${formatCleanTitle(cleanLine)}</h3>`;
                  }
                  if (isH2) {
                    return `<h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-10 mb-4 border-b-2 border-slate-200 dark:border-slate-800 pb-2.5 leading-snug">${formatCleanTitle(cleanLine)}</h2>`;
                  }
                  return `<p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-6 text-base sm:text-lg">${line}</p>`;
                }).join('\n');

                const mainContainer = document.querySelector('main');
                if (mainContainer) {
                  // Hide footer main nav links & remove empty dark padding on article page
                  const footerNav = document.getElementById('footer-main-nav');
                  if (footerNav) footerNav.classList.add('hidden');

                  const footerContainer = document.getElementById('footer-container');
                  if (footerContainer) {
                    footerContainer.className = 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6';
                  }

                  const footerBottom = document.getElementById('footer-bottom-bar');
                  if (footerBottom) {
                    footerBottom.className = 'flex flex-col items-center justify-center text-center gap-3 mt-0 pt-0 border-t-0';
                  }

                  // Direct localStorage sweep to purge legacy cuchaytheo duplicates
                  try {
                    let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
                    let updated = false;
                    const cleaned = customPosts.filter((p: any) => {
                      const t = normalizeText(p.title);
                      const s = normalizeText(p.slug || p.id);
                      if (t.includes('cuchaytheo') || s.includes('cuchaytheo')) {
                        updated = true;
                        return false;
                      }
                      return true;
                    });
                    if (updated) {
                      localStorage.setItem('custom_saved_posts', JSON.stringify(cleaned));
                    }
                  } catch (e) {}

                  // Fetch related/featured posts for bottom section
                  let otherPostsHtml = '';
                  try {
                    let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
                    let allPosts = customPosts;
                    if (!allPosts.length) {
                      const res = await fetch('/api/posts');
                      if (res.ok) {
                        const data = await res.json();
                        allPosts = data.posts || [];
                      }
                    }

                    const deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
                    const fallbackPosts = [
                      {
                        title: 'Đừng tự nhốt mình dưới đáy giếng của một chuyên môn hẹp!',
                        description: 'Chỉ thạo một nghề là rủi ro lớn nhất thời nay. Học ngay cách mở rộng kho kiến thức ngầm để không bế tắc trước những bài toán chưa từng có tiền lệ.',
                        category: 'cuoc-song',
                        slug: 'dung-tu-nhot-minh-duoi-day-gieng-cua-mot-chuyen-mon-hep'
                      }
                    ].filter(fp => !deletedSlugs.includes(fp.slug));

                    const normCurrentSlug = normalizeText(slug);
                    const normCurrentTitle = normalizeText(cleanTitle);

                    const seenTitles = new Set();
                    const related: any[] = [];

                    allPosts.forEach((p: any) => {
                      const pNormSlug = normalizeText(p.slug || p.id);
                      const pNormTitle = normalizeText(p.title);
                      
                      if (!pNormTitle || seenTitles.has(pNormTitle)) return;
                      if (pNormSlug === normCurrentSlug || pNormTitle === normCurrentTitle) return;
                      
                      seenTitles.add(pNormTitle);
                      related.push(p);
                    });

                    fallbackPosts.forEach(fp => {
                      if (related.length >= 2) return;
                      const fpNormTitle = normalizeText(fp.title);
                      const fpNormSlug = normalizeText(fp.slug);
                      if (!seenTitles.has(fpNormTitle) && fpNormTitle !== normCurrentTitle && fpNormSlug !== normCurrentSlug) {
                        seenTitles.add(fpNormTitle);
                        related.push(fp);
                      }
                    });

                    if (related.length) {
                      otherPostsHtml = `
                        <section class="mt-12 pt-10 border-t border-slate-200 dark:border-slate-800">
                          <div class="flex items-center justify-between mb-6">
                            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                              🔥 Bài Viết Nổi Bật Khác
                            </h2>
                            <a href="/${category}" class="text-xs sm:text-sm font-bold text-brand-green hover:underline">
                              Xem tất cả &rarr;
                            </a>
                          </div>

                          <div class="grid sm:grid-cols-2 gap-4 sm:gap-6">
                            ${related.map((rp: any) => {
                              const rpCat = rp.category || category;
                              const rpUrl = `/${rpCat}/${rp.slug || rp.id}`;
                              const rpTitle = formatCleanTitle(rp.title);
                              const rpCatLabel = rpCat === 'cuoc-song' ? 'Cuộc sống' : (rpCat === 'ai' ? 'AI' : 'Marketing');
                              return `
                                <a href="${rpUrl}" class="group p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-brand-green transition-all shadow-sm flex flex-col justify-between">
                                  <div>
                                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-brand-green/10 text-brand-green mb-2">
                                      🏷️ ${rpCatLabel}
                                    </span>
                                    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-green transition-colors line-clamp-2 leading-snug">
                                      ${rpTitle}
                                    </h3>
                                    ${rp.description ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">${rp.description}</p>` : ''}
                                  </div>
                                  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-xs font-bold text-brand-green">
                                    <span>Đọc tiếp</span>
                                    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                                  </div>
                                </a>
                              `;
                            }).join('')}
                          </div>
                        </section>
                      `;
                    }
                  } catch (e) {}

                  mainContainer.innerHTML = `
                    <article class="py-8 sm:py-12 px-4 max-w-3xl mx-auto min-h-[70vh] w-full">
                      <a href="/${category}" class="text-xs sm:text-sm font-semibold text-brand-green dark:text-brand-green hover:underline mb-6 inline-flex items-center gap-1.5">&larr; Quay lại danh sách ${catLabel}</a>
                      
                      <header class="mb-8">
                        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-green/10 text-brand-green dark:bg-brand-green/20 border border-brand-green/20">
                            🏷️ ${catLabel}
                          </span>
                          <time datetime="${pubDateObj.toISOString()}" class="font-medium">📅 ${formattedDate}</time>
                        </div>

                        <h1 class="text-xl sm:text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white leading-snug tracking-tight mb-4">
                          ${cleanTitle}
                        </h1>

                        ${post.description ? `
                          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border-l-4 border-brand-green mb-6 text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed italic shadow-sm">
                            ${post.description}
                          </div>
                        ` : ''}
                      </header>

                      ${imageHtml}

                      <div class="prose max-w-none text-slate-800 dark:text-slate-200 leading-relaxed sm:text-lg">
                        ${formattedContent}
                      </div>

                      ${otherPostsHtml}
                    </article>
                  `;
                }
              }
            }
        } catch (e) {
          console.error('Fallback article renderer error:', e);
        }
      });
    </script>
  </body>
</html>
