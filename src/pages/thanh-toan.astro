---
// Trang thanh toán chuyên biệt cho người dùng di động
export const prerender = false;

import fs from 'fs';
import path from 'path';

const url = new URL(Astro.request.url);
const orderId = url.searchParams.get('id')?.trim() || '';

let orderData: any = null;
if (orderId) {
  try {
    const ordersFilePath = path.resolve('./src/data/orders.json');
    if (fs.existsSync(ordersFilePath)) {
      const orders = JSON.parse(fs.readFileSync(ordersFilePath, 'utf-8') || '[]');
      orderData = orders.find((o: any) => o.id && o.id.toUpperCase() === orderId.toUpperCase());
    }
  } catch (e) {
    console.error('Error fetching order:', e);
  }
}

const is9Nguon = orderData?.productId === 'ebook-9-cach-tao-thu-nhap-tu-blog' || 
                 (orderData?.product && orderData.product.includes('9 Nguồn')) ||
                 (orderData?.amount && String(orderData.amount).includes('59.000'));

const displayAmount = orderData?.amount || (is9Nguon ? '59.000đ' : '299.000đ');
const numericAmount = is9Nguon ? 59000 : 299000;
const productName = orderData?.product || (is9Nguon ? 'Ebook: 9 Nguồn Thu Nhập Từ Blog' : 'Ebook Tạo Blog – Cỗ máy bán hàng tự động bằng AI');
const customerName = orderData?.customerName || '';
const customerEmail = orderData?.email || '';
const isAlreadyPaid = orderData?.status === 'Đã thanh toán';
const transferNote = orderId || 'EB2610';
const readerUrl = is9Nguon ? '/doc-sach/9-nguon-thu-nhap-tu-blog' : '/doc-sach/tao-blog-co-may-ban-hang-tu-dong';

const qrUrl = `https://qr.sepay.vn/img?acc=0000485725573&bank=MBBank&amount=${numericAmount}&des=${encodeURIComponent(transferNote)}&template=compact`;
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Thanh toán đơn hàng {orderId ? `#${orderId}` : ''} | Đào Xuân Quảng</title>
  <meta name="description" content="Trang thanh toán chuyển khoản nhanh qua VietQR cho đơn hàng Ebook." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #EA580C;
      --primary-hover: #C2410C;
      --primary-light: #FFF7ED;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text-main: #0F172A;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --success: #10B981;
      --success-light: #ECFDF5;
      --success-border: #A7F3D0;
      --radius: 20px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding: 16px 12px 60px;
    }

    .container {
      max-width: 520px;
      margin: 0 auto;
    }

    /* Top Bar */
    .brand-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 6px 18px;
    }
    .brand-logo {
      font-weight: 800;
      font-size: 16px;
      color: var(--text-main);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .badge-secure {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 600;
      background: #EFF6FF;
      color: #2563EB;
      padding: 4px 10px;
      border-radius: 99px;
      border: 1px solid #DBEAFE;
    }

    /* Card */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05), 0 20px 25px -5px rgba(0, 0, 0, 0.02);
      overflow: hidden;
      margin-bottom: 20px;
    }

    .card-header {
      background: linear-gradient(180deg, #FFF7ED 0%, #FFFFFF 100%);
      padding: 24px 20px 16px;
      text-align: center;
      border-bottom: 1px solid #FFEDD5;
    }

    .order-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #FEF3C7;
      color: #B45309;
      font-size: 12px;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 99px;
      margin-bottom: 10px;
      border: 1px solid #FDE68A;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #D97706;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    .card-title {
      font-size: 20px;
      font-weight: 800;
      color: #1E293B;
      margin-bottom: 6px;
    }
    .card-sub {
      font-size: 13.5px;
      color: var(--text-muted);
    }

    .card-body {
      padding: 22px 18px;
    }

    /* QR Box */
    .qr-wrapper {
      text-align: center;
      margin-bottom: 24px;
    }
    .qr-frame {
      display: inline-block;
      padding: 14px;
      background: #FFFFFF;
      border-radius: 20px;
      border: 2px solid #FED7AA;
      box-shadow: 0 8px 24px rgba(234, 88, 12, 0.12);
      position: relative;
    }
    .qr-img {
      display: block;
      width: 240px;
      height: 240px;
      border-radius: 12px;
      max-width: 100%;
    }
    @media (max-width: 380px) {
      .qr-img { width: 210px; height: 210px; }
    }

    .btn-download-qr {
      margin-top: 14px;
      width: 100%;
      max-width: 280px;
      background: #F1F5F9;
      color: #1E293B;
      font-size: 13.5px;
      font-weight: 700;
      padding: 11px 18px;
      border-radius: 12px;
      border: 1px solid #CBD5E1;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-download-qr:hover {
      background: #E2E8F0;
      color: #0F172A;
    }

    /* Mobile Tip Box */
    .mobile-tip {
      background: #F8FAFC;
      border: 1px dashed #CBD5E1;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 12.5px;
      color: #475569;
      margin-top: 12px;
      text-align: left;
      line-height: 1.5;
    }
    .mobile-tip b {
      color: #0F172A;
    }

    /* Info Rows */
    .info-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 22px;
    }
    .info-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      gap: 10px;
    }
    .info-row.highlight {
      background: #FFF7ED;
      border: 2px solid #FB923C;
    }
    .info-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
    }
    .info-row.highlight .info-label {
      color: #EA580C;
    }
    .info-value-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
      overflow: hidden;
    }
    .info-value {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--text-main);
      text-align: right;
      word-break: break-all;
    }
    .info-value.mono {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      letter-spacing: 0.5px;
    }
    .info-value.amount {
      color: #EA580C;
      font-size: 18px;
      font-weight: 800;
    }
    .info-value.code {
      color: #C2410C;
      font-size: 17px;
      font-weight: 900;
    }

    /* Copy Button */
    .btn-copy {
      flex-shrink: 0;
      background: #FFFFFF;
      color: #334155;
      border: 1px solid #CBD5E1;
      padding: 6px 10px;
      font-size: 11.5px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .btn-copy:hover {
      background: #F1F5F9;
      color: #0F172A;
    }
    .btn-copy.copied {
      background: #10B981 !important;
      color: #FFFFFF !important;
      border-color: #10B981 !important;
    }

    /* Commitment Box */
    .commit-box {
      background: var(--success-light);
      border: 1px solid var(--success-border);
      border-radius: 14px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }
    .commit-icon {
      font-size: 20px;
      flex-shrink: 0;
    }
    .commit-text {
      font-size: 13px;
      font-weight: 700;
      color: #065F46;
      line-height: 1.4;
    }

    /* Status Polling Bar */
    .status-bar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 16px;
      background: #F1F5F9;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 600;
      color: #475569;
      margin-bottom: 16px;
    }
    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid #CBD5E1;
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Zalo Help Button */
    .btn-zalo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #0068FF;
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      padding: 13px 20px;
      border-radius: 14px;
      box-shadow: 0 4px 14px rgba(0, 104, 255, 0.25);
      transition: all 0.2s ease;
      text-align: center;
    }
    .btn-zalo:hover {
      background: #0056D2;
      transform: translateY(-1px);
    }

    /* Success Screen */
    .success-screen {
      display: none;
      text-align: center;
      padding: 30px 20px;
    }
    .success-icon-wrap {
      width: 72px;
      height: 72px;
      background: #ECFDF5;
      color: #10B981;
      border: 3px solid #A7F3D0;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      margin-bottom: 18px;
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes popIn {
      0% { transform: scale(0); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .success-title {
      font-size: 24px;
      font-weight: 900;
      color: #065F46;
      margin-bottom: 8px;
    }
    .success-sub {
      font-size: 15px;
      color: #475569;
      margin-bottom: 22px;
      line-height: 1.6;
    }
    .btn-read-now {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #10B981;
      color: #FFFFFF;
      text-decoration: none;
      font-size: 16px;
      font-weight: 800;
      padding: 15px 36px;
      border-radius: 99px;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
      transition: all 0.2s ease;
    }
    .btn-read-now:hover {
      background: #059669;
      transform: translateY(-2px);
    }
  </style>
</head>
<body>

<div class="container">
  
  <div class="brand-bar">
    <a href="/" class="brand-logo">
      <span>📚</span>
      <span>Đào Xuân Quảng · Ebook</span>
    </a>
    <div class="badge-secure">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>Bảo mật 100%</span>
    </div>
  </div>

  <div class="card">
    
    <!-- MÀN HÌNH CHỜ THANH TOÁN -->
    <div id="checkout-view" style={isAlreadyPaid ? 'display:none;' : 'display:block;'}>
      <div class="card-header">
        <div class="order-badge">
          <span class="pulse-dot"></span>
          <span>Đơn hàng: {orderId || 'Chờ tạo'}</span>
        </div>
        <h1 class="card-title">Quét mã QR để hoàn tất</h1>
        <p class="card-sub">{productName}</p>
      </div>

      <div class="card-body">
        
        <!-- KHUNG MÃ QR -->
        <div class="qr-wrapper">
          <div class="qr-frame">
            <img 
              id="qr-image" 
              class="qr-img" 
              src={qrUrl} 
              alt={`VietQR thanh toán đơn hàng ${orderId}`} 
              width="240" 
              height="240" 
            />
          </div>

          <div>
            <button type="button" id="btn-download-qr" class="btn-download-qr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Tải ảnh QR về máy</span>
            </button>
          </div>

          <div class="mobile-tip">
            💡 <b>Thanh toán nhanh trên điện thoại:</b> Bấm <b>Tải ảnh QR về máy</b> &rarr; Mở app ngân hàng (MBBank, Vietcombank, Techcombank, VPBank...) &rarr; Chọn chức năng <b>Quét QR từ ảnh</b> là xong ngay!
          </div>
        </div>

        <!-- 5 DÒNG THÔNG TIN CÓ NÚT SAO CHÉP -->
        <div class="info-list">
          
          <!-- 1. Ngân hàng -->
          <div class="info-row">
            <span class="info-label">Ngân hàng</span>
            <div class="info-value-wrap">
              <span class="info-value">MBBank (Quân Đội)</span>
              <button type="button" class="btn-copy" data-copy="MBBank">📋 Sao chép</button>
            </div>
          </div>

          <!-- 2. Số tài khoản -->
          <div class="info-row">
            <span class="info-label">Số tài khoản</span>
            <div class="info-value-wrap">
              <span class="info-value mono">0000485725573</span>
              <button type="button" class="btn-copy" data-copy="0000485725573">📋 Sao chép</button>
            </div>
          </div>

          <!-- 3. Chủ tài khoản -->
          <div class="info-row">
            <span class="info-label">Chủ tài khoản</span>
            <div class="info-value-wrap">
              <span class="info-value">DAO XUAN QUANG</span>
              <button type="button" class="btn-copy" data-copy="DAO XUAN QUANG">📋 Sao chép</button>
            </div>
          </div>

          <!-- 4. Số tiền -->
          <div class="info-row">
            <span class="info-label">Số tiền</span>
            <div class="info-value-wrap">
              <span class="info-value amount" id="val-amount">{displayAmount}</span>
              <button type="button" class="btn-copy" data-copy={String(numericAmount)}>📋 Sao chép</button>
            </div>
          </div>

          <!-- 5. Nội dung CK -->
          <div class="info-row highlight">
            <span class="info-label">Nội dung CK</span>
            <div class="info-value-wrap">
              <span class="info-value mono code" id="val-code">{transferNote}</span>
              <button type="button" class="btn-copy" data-copy={transferNote}>📋 Sao chép</button>
            </div>
          </div>

        </div>

        <!-- DÒNG CAM KẾT -->
        <div class="commit-box">
          <div class="commit-icon">⚡</div>
          <div class="commit-text">
            Cam kết: Ebook tự gửi vào email trong 1 phút sau khi chuyển khoản
          </div>
        </div>

        <!-- THANH TRẠNG THÁI TỰ ĐỘNG CHECK -->
        <div class="status-bar" id="polling-status">
          <div class="spinner"></div>
          <span>Đang chờ nhận tiền tự động từ SePay...</span>
        </div>

        <!-- NÚT NHẮN ZALO HỖ TRỢ -->
        <a href="https://zalo.me/0702286928" target="_blank" rel="noopener" class="btn-zalo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.87 1.5 5.43 3.84 7.02l-.99 3.65c-.1.38.27.72.64.59l4.24-1.46c.72.13 1.48.2 2.27.2 5.52 0 10-4.03 10-9s-4.48-9-10-9zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/></svg>
          <span>Cần hỗ trợ? Nhắn Zalo: 0702 286 928</span>
        </a>

      </div>
    </div>

    <!-- MÀN HÌNH THANH TOÁN THÀNH CÔNG -->
    <div id="success-view" class="success-screen" style={isAlreadyPaid ? 'display:block;' : 'display:none;'}>
      <div class="success-icon-wrap">✓</div>
      <h2 class="success-title">Thanh toán thành công!</h2>
      <p class="success-sub">
        Hệ thống đã nhận được tiền cho đơn hàng <strong id="success-order-id">{orderId}</strong>.<br />
        Ebook đã được gửi tới email của bạn: <strong id="success-email" style="color:#065F46;">{customerEmail || 'hộp thư đến'}</strong>
      </p>

      <div style="margin-top: 24px;">
        <a id="btn-read-ebook" href={readerUrl} class="btn-read-now">
          📖 Mở Đọc Ebook Ngay Bây Giờ &rarr;
        </a>
      </div>

      <p style="font-size:12.5px;color:#64748B;margin-top:16px;">
        💡 <em>Vui lòng kiểm tra hộp thư đến (hoặc hòm thư Quảng cáo/Spam nếu chưa thấy sau 1 phút).</em>
      </p>
    </div>

  </div>

  <footer style="text-align:center;font-size:12px;color:#94A3B8;padding:10px 0;">
    © 2026 Đào Xuân Quảng · Hệ thống xác nhận thanh toán tự động qua SePay & VietQR
  </footer>

</div>

<script is:inline define:vars={{ orderId, isAlreadyPaid, qrUrl, transferNote, readerUrl }}>
  (function(){
    // 1. Xử lý nút Sao chép cho mọi dòng
    document.querySelectorAll('.btn-copy').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        var text = btn.getAttribute('data-copy') || '';
        if (!text) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function(){
            showCopied(btn);
          }).catch(function(){
            fallbackCopy(text, btn);
          });
        } else {
          fallbackCopy(text, btn);
        }
      });
    });

    function showCopied(btn) {
      var origText = btn.innerHTML;
      btn.innerHTML = 'Đã chép! ✓';
      btn.classList.add('copied');
      setTimeout(function(){
        btn.innerHTML = origText;
        btn.classList.remove('copied');
      }, 1600);
    }

    function fallbackCopy(text, btn) {
      var input = document.createElement('textarea');
      input.value = text;
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      document.body.removeChild(input);
      showCopied(btn);
    }

    // 2. Xử lý tải ảnh mã QR về máy điện thoại
    var downloadBtn = document.getElementById('btn-download-qr');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function(){
        var btn = this;
        var origHtml = btn.innerHTML;
        btn.innerHTML = '<span>Đang tải ảnh...</span>';

        fetch(qrUrl)
          .then(function(res){ return res.blob(); })
          .then(function(blob){
            var blobUrl = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = blobUrl;
            a.download = 'vietqr-' + (orderId || 'ebook') + '.jpg';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(function(){ URL.revokeObjectURL(blobUrl); }, 2000);
            btn.innerHTML = '<span>Đã lưu ảnh QR! ✓</span>';
            setTimeout(function(){ btn.innerHTML = origHtml; }, 2000);
          })
          .catch(function(){
            // Fallback mở trực tiếp tab ảnh
            window.open(qrUrl, '_blank');
            btn.innerHTML = origHtml;
          });
      });
    }

    // 3. Tự động kiểm tra trạng thái đơn hàng (Polling) mỗi 2.5 giây
    if (orderId && !isAlreadyPaid) {
      var pollTimer = setInterval(function(){
        fetch('/api/check-order?id=' + encodeURIComponent(orderId) + '&t=' + Date.now())
          .then(function(res){ return res.json(); })
          .then(function(data){
            if (data && data.paid) {
              clearInterval(pollTimer);
              showSuccess(data);
            }
          })
          .catch(function(){});
      }, 2500);
    }

    function showSuccess(data) {
      var checkoutView = document.getElementById('checkout-view');
      var successView = document.getElementById('success-view');
      var successOrderEl = document.getElementById('success-order-id');
      var successEmailEl = document.getElementById('success-email');

      if (checkoutView) checkoutView.style.display = 'none';
      if (successView) {
        if (data && data.orderId && successOrderEl) successOrderEl.textContent = data.orderId;
        if (data && data.email && successEmailEl) successEmailEl.textContent = data.email;
        successView.style.display = 'block';
        successView.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      // Track Meta Pixel Purchase nếu có
      if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
        window.fbq('track', 'Purchase', {
          content_name: 'Ebook',
          currency: 'VND',
          value: data?.amount ? Number(String(data.amount).replace(/[^\d]/g, '')) : 299000
        }, { eventID: orderId });
      }
    }

  })();
</script>

</body>
</html>
