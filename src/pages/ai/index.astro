---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('ai');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatCleanTitle = (t: string) => {
  if (!t) return '';
  const lettersOnly = t.replace(/[^a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/g, '');
  if (lettersOnly.length > 5 && lettersOnly === lettersOnly.toUpperCase()) {
    let lower = t.toLowerCase();
    lower = lower.charAt(0).toUpperCase() + lower.slice(1);
    return lower.replace(/\b(ai|seo|sop|hot|vps|ui|ux|ads|cpm|cpc)\b/gi, (m) => m.toUpperCase());
  }
  return t;
};
---

<Layout title="AI | Đào Xuân Quảng" description="Tư duy hệ thống, ứng dụng AI cho doanh nghiệp và tự động hóa vận hành.">
  <section class="py-16 px-4 max-w-7xl mx-auto">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 text-slate-900 dark:text-white">AI</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Phát triển ứng dụng AI, tự động hóa quy trình nghiệp vụ và xây dựng hệ thống thông minh.
      </p>
    </div>

    <div class="posts-grid-container grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map((post) => (
        <article data-post-slug={post.id} data-post-title={post.data.title} class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden">
          <div>
            {post.data.image && (
              <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
                <img 
                  src={post.data.image} 
                  alt={formatCleanTitle(post.data.title)} 
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                />
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('vi-VN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>•</span>
                <span class="font-semibold text-gold-accent">AI</span>
              </div>

              <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                <a href={`/ai/${post.id}`}>
                  {formatCleanTitle(post.data.title)}
                </a>
              </h2>
              
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6">
            <a href={`/ai/${post.id}`} class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
              Đọc tiếp &rarr;
            </a>
          </div>
        </article>
      ))}

      {sortedPosts.length === 0 && (
        <div class="posts-empty-state col-span-full p-8 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center text-slate-500">
          Đang cập nhật các bài viết mới...
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const formatCleanTitle = (t: string) => {
        if (!t) return '';
        const lettersOnly = t.replace(/[^a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/g, '');
        if (lettersOnly.length > 5 && lettersOnly === lettersOnly.toUpperCase()) {
          let lower = t.toLowerCase();
          lower = lower.charAt(0).toUpperCase() + lower.slice(1);
          return lower.replace(/\b(ai|seo|sop|hot|vps|ui|ux|ads|cpm|cpc)\b/gi, (m) => m.toUpperCase());
        }
        return t;
      };

      const normalizeText = (s: string) => (s || '').toLowerCase().replace(/[^a-z0-9]/gi, '');

      // 1. Sanitize deleted_post_slugs in localStorage
      let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
      const broadCategories = ['cuoc-song', 'marketing', 'ai'];
      const cleanedDeletedSlugs = deletedSlugs.filter((s: string) => !broadCategories.includes(s));
      if (cleanedDeletedSlugs.length !== deletedSlugs.length) {
        localStorage.setItem('deleted_post_slugs', JSON.stringify(cleanedDeletedSlugs));
        deletedSlugs = cleanedDeletedSlugs;
      }

      // Collect existing card identifiers to avoid duplicates
      const existingNormalizedTitles = new Set();
      const existingNormalizedSlugs = new Set();
      document.querySelectorAll('[data-post-slug]').forEach(el => {
        const fullId = el.getAttribute('data-post-slug') || '';
        const titleAttr = el.getAttribute('data-post-title') || '';
        const slugOnly = fullId.split('/').pop() || '';
        
        if (deletedSlugs.includes(fullId) || deletedSlugs.includes(slugOnly)) {
          el.remove();
        } else {
          existingNormalizedSlugs.add(normalizeText(fullId));
          existingNormalizedSlugs.add(normalizeText(slugOnly));
          if (titleAttr) existingNormalizedTitles.add(normalizeText(titleAttr));
        }
      });

      // 3. Render custom posts saved from Admin
      let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
      let updatedCustomPosts = false;
      const filteredCustomPosts: any[] = [];

      customPosts.forEach((p: any) => {
        const pSlug = p.slug || p.id?.split('/').pop() || '';
        const normSlug = normalizeText(pSlug);
        const normTitle = normalizeText(p.title);

        if (existingNormalizedSlugs.has(normSlug) || existingNormalizedTitles.has(normTitle)) {
          updatedCustomPosts = true;
          return;
        }
        filteredCustomPosts.push(p);
      });

      if (updatedCustomPosts) {
        localStorage.setItem('custom_saved_posts', JSON.stringify(filteredCustomPosts));
      }

      const categoryPosts = filteredCustomPosts.filter((p: any) => p.category === 'ai' && !deletedSlugs.includes(p.slug) && !deletedSlugs.includes(p.id));
      const gridContainer = document.querySelector('.posts-grid-container');
      const emptyStateContainer = document.querySelector('.posts-empty-state');

      if (categoryPosts.length > 0 && gridContainer) {
        if (emptyStateContainer) emptyStateContainer.remove();
        
        categoryPosts.forEach((post: any) => {
          const postSlug = post.slug || post.id?.split('/').pop() || '';
          if (!postSlug) return;

          const articleEl = document.createElement('article');
          articleEl.setAttribute('data-post-slug', postSlug);
          articleEl.className = 'rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden';
          
          const pubDateObj = post.pubDate ? new Date(post.pubDate) : new Date();
          const formattedDate = pubDateObj.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' });
          const cleanTitle = formatCleanTitle(post.title);

          const imageHtml = post.image ? `
            <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
              <img src="${post.image}" alt="${cleanTitle}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
            </div>
          ` : '';

          articleEl.innerHTML = `
            <div>
              ${imageHtml}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                  <time datetime="${pubDateObj.toISOString()}">${formattedDate}</time>
                  <span>•</span>
                  <span class="font-semibold text-gold-accent">AI</span>
                </div>
                <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                  <a href="/ai/${postSlug}">${cleanTitle}</a>
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">${post.description}</p>
              </div>
            </div>
            <div class="px-6 pb-6">
              <a href="/ai/${postSlug}" class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
                Đọc tiếp &rarr;
              </a>
            </div>
          `;
          gridContainer.prepend(articleEl);
        });
      }
    } catch (e) {
      console.error('Render ai posts error:', e);
    }
  });
</script>
