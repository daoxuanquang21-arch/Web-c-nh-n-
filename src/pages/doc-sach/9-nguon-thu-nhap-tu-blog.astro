---
import MetaPixel from '../../components/MetaPixel.astro';
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>9 Nguồn Thu Nhập Từ Blog – Ebook</title>
<meta name="description" content="Bạn từng nghe có người kiếm được tiền từ blog — nhưng không biết họ làm thế nào? Cuốn sách nhỏ này mở ra 9 con đường, giải thích dễ hiểu cho cả người chưa từng viết bài nào.">
<link rel="canonical" href="https://daoxuanquang.com.vn/doc-sach/9-nguon-thu-nhap-tu-blog" />
<meta property="og:type" content="book">
<meta property="og:title" content="9 Nguồn Thu Nhập Từ Blog – Ebook">
<meta property="og:description" content="Khám phá 9 con đường kiếm tiền từ blog, giải thích dễ hiểu bằng số liệu và ví dụ thực tế.">
<meta property="og:url" content="https://daoxuanquang.com.vn/doc-sach/9-nguon-thu-nhap-tu-blog">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Crect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%23D7141A%22/%3E%3Ctext x=%2250%22 y=%2268%22 font-size=%2254%22 text-anchor=%22middle%22 fill=%22white%22 font-family=%22Arial%22 font-weight=%22bold%22%3E9%3C/text%3E%3C/svg%3E">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800;900&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

<MetaPixel />

<style is:global is:inline>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --paper:#EFE8DA; --ink:#231F18; --muted:#6B6355; --line:#DCD2BF; --card:#FBF8F2;
  --c1:#E63946; --c2:#F77F00; --c3:#D9A400; --c4:#2A9D8F; --c5:#3A86FF;
  --c6:#7B2CBF; --c7:#D63384; --c8:#06A77D; --c9:#1D3557;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#1B1813; --ink:#F1ECE2; --muted:#B2A994; --line:#3A3429; --card:#25211A;
    --c9:#6C8EC9; --c3:#F2C230;
  }
}
:root[data-theme="dark"]{
  --paper:#1B1813; --ink:#F1ECE2; --muted:#B2A994; --line:#3A3429; --card:#25211A;
  --c9:#6C8EC9; --c3:#F2C230;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);
  font-family:"Lora",Georgia,"Times New Roman",serif;font-size:1.0625rem;line-height:1.75}
h1,h2,h3,h4,.sans{font-family:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Arial,sans-serif}
img{max-width:100%}
a{color:inherit}
a:focus-visible,button:focus-visible{outline:3px solid var(--c5);outline-offset:3px;border-radius:4px}
.wrap{max-width:46rem;margin:0 auto;padding:0 1.25rem}

/* ===== COVER ===== */
.cover{min-height:100vh;display:grid;align-content:center;padding:3rem 1.25rem}
.cover-inner{max-width:62rem;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}
.cover h1{font-size:clamp(2.4rem,6vw,4.2rem);line-height:1.05;font-weight:900;margin:0 0 1rem;letter-spacing:-.02em}
.cover .sub{font-size:1.15rem;color:var(--muted);margin:0 0 1.5rem;max-width:28rem}
.cover .author{font-family:"Be Vietnam Pro",sans-serif;font-weight:600;font-size:.95rem;color:var(--muted)}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}
.tile{aspect-ratio:1;border-radius:14px;color:#fff;padding:.75rem;display:flex;flex-direction:column;justify-content:space-between;
  text-decoration:none;font-family:"Be Vietnam Pro",sans-serif;transition:transform .2s ease}
.tile:hover{transform:translateY(-4px) rotate(-1deg)}
.tile b{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:900;line-height:1}
.tile span{font-size:clamp(.68rem,1.4vw,.85rem);font-weight:600;line-height:1.25}
.tile:nth-child(1){background:var(--c1)}.tile:nth-child(2){background:var(--c2)}.tile:nth-child(3){background:var(--c3);color:#1B1F2A}
.tile:nth-child(4){background:var(--c4)}.tile:nth-child(5){background:var(--c5)}.tile:nth-child(6){background:var(--c6)}
.tile:nth-child(7){background:var(--c7)}.tile:nth-child(8){background:var(--c8)}.tile:nth-child(9){background:var(--c9)}
@media (max-width:760px){.cover-inner{grid-template-columns:1fr;gap:2rem}.cover{min-height:auto}}

/* ===== GENERIC SECTIONS ===== */
section.part{padding:4rem 0;border-top:1px solid var(--line)}
section.part h2{font-size:clamp(1.7rem,4vw,2.3rem);line-height:1.2;margin:0 0 1.25rem;font-weight:800;letter-spacing:-.01em}
p{margin:0 0 1.1rem}
.lead{font-size:1.18rem;color:var(--ink)}
.toc ol{list-style:none;padding:0;margin:0;display:grid;gap:.4rem}
.toc a{display:flex;gap:1rem;align-items:baseline;padding:.6rem .2rem;text-decoration:none;border-bottom:1px dashed var(--line);font-family:"Be Vietnam Pro",sans-serif}
.toc a:hover{background:var(--card)}
.toc .n{font-weight:900;font-size:1.3rem;min-width:2rem}
.toc .t{font-weight:600}
.toc small{display:block;color:var(--muted);font-weight:400;font-size:.85rem}

/* ===== CHAPTERS ===== */
.chapter{padding:4.5rem 0 3.5rem;border-top:1px solid var(--line);position:relative}
.ch-head{display:grid;grid-template-columns:auto 1fr;gap:1.25rem;align-items:end;margin-bottom:1.75rem}
.ch-num{font-family:"Be Vietnam Pro",sans-serif;font-weight:900;font-size:clamp(5rem,16vw,8.5rem);line-height:.8;color:var(--cc)}
.ch-head h2{font-size:clamp(1.6rem,4vw,2.25rem);line-height:1.15;margin:0;font-weight:800}
.ch-head .tag{font-family:"Be Vietnam Pro",sans-serif;font-size:.9rem;color:var(--muted);margin-top:.35rem}
.chapter h3{font-size:1.15rem;font-weight:800;margin:2rem 0 .6rem;color:var(--cc)}
.chapter ul,.chapter ol{padding-left:1.3rem;margin:0 0 1.1rem}
.chapter li{margin-bottom:.45rem}
.chapter li::marker{color:var(--cc);font-weight:700}
.meter{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin:1.5rem 0}
.meter div{background:var(--card);border:1px solid var(--line);border-top:5px solid var(--cc);border-radius:10px;padding:.75rem .85rem;font-family:"Be Vietnam Pro",sans-serif}
.meter small{display:block;color:var(--muted);font-size:.78rem}
.meter strong{font-size:.98rem}
@media (max-width:560px){.meter{grid-template-columns:1fr}}
.proscons{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1rem 0}
.proscons div{background:var(--card);border-radius:12px;padding:1rem 1.1rem;border:1px solid var(--line)}
.proscons h4{margin:0 0 .5rem;font-size:.95rem}
.proscons ul{margin:0;padding-left:1.1rem;font-size:.97rem}
.pros h4{color:#06A77D}.cons h4{color:#E63946}
@media (max-width:560px){.proscons{grid-template-columns:1fr}}
.tip{background:color-mix(in srgb,var(--cc) 12%,var(--card));border-left:5px solid var(--cc);border-radius:0 12px 12px 0;padding:1rem 1.2rem;margin:1.5rem 0}
.tip strong{font-family:"Be Vietnam Pro",sans-serif;color:var(--cc)}
.tip p:last-child{margin:0}
#c1{--cc:var(--c1)}#c2{--cc:var(--c2)}#c3{--cc:var(--c3)}#c4{--cc:var(--c4)}#c5{--cc:var(--c5)}
#c6{--cc:var(--c6)}#c7{--cc:var(--c7)}#c8{--cc:var(--c8)}#c9{--cc:var(--c9)}

/* ===== TABLE ===== */
.table-scroll{overflow-x:auto;margin:1.5rem 0;border:1px solid var(--line);border-radius:12px;background:var(--card)}
table{border-collapse:collapse;width:100%;min-width:620px;font-family:"Be Vietnam Pro",sans-serif;font-size:.9rem}
th,td{padding:.7rem .8rem;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:800;background:color-mix(in srgb,var(--ink) 5%,var(--card))}
tr:last-child td{border-bottom:0}
td .dot{display:inline-block;width:.7rem;height:.7rem;border-radius:50%;margin-right:.45rem;vertical-align:middle}
.stars{letter-spacing:.1em;color:var(--c2)}

/* ===== ROADMAP ===== */
.stage{display:grid;grid-template-columns:7rem 1fr;gap:1.25rem;padding:1.25rem 0;border-bottom:1px dashed var(--line)}
.stage:last-child{border-bottom:0}
.stage .lvl{font-family:"Be Vietnam Pro",sans-serif;font-weight:800;font-size:.9rem}
.stage .lvl span{display:block;font-weight:400;color:var(--muted);font-size:.8rem}
.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.5rem}
.chip{font-family:"Be Vietnam Pro",sans-serif;font-size:.8rem;font-weight:600;color:#fff;padding:.2rem .6rem;border-radius:99px}
@media (max-width:560px){.stage{grid-template-columns:1fr;gap:.25rem}}

.checklist{list-style:none;padding:0}
.checklist li{padding-left:2rem;position:relative;margin-bottom:.7rem}
.checklist li::before{content:"";position:absolute;left:0;top:.35rem;width:1.1rem;height:1.1rem;border:2px solid var(--c8);border-radius:5px}
footer{padding:3rem 1.25rem 4rem;text-align:center;color:var(--muted);font-family:"Be Vietnam Pro",sans-serif;font-size:.85rem;border-top:1px solid var(--line)}
.rainbow{height:8px;background:linear-gradient(90deg,var(--c1) 0 11.1%,var(--c2) 0 22.2%,var(--c3) 0 33.3%,var(--c4) 0 44.4%,var(--c5) 0 55.5%,var(--c6) 0 66.6%,var(--c7) 0 77.7%,var(--c8) 0 88.8%,var(--c9) 0)}

.calc{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:1.1rem 1.25rem;margin:1.25rem 0;font-family:"Be Vietnam Pro",sans-serif;font-size:.95rem}
.calc h4{margin:0 0 .6rem;font-size:1rem;color:var(--cc,var(--ink))}
.calc .row{display:flex;justify-content:space-between;gap:1rem;padding:.35rem 0;border-bottom:1px dashed var(--line)}
.calc .row:last-of-type{border-bottom:0}
.calc .row b{white-space:nowrap}
.calc .total{margin-top:.5rem;padding-top:.6rem;border-top:2px solid var(--cc,var(--ink));font-weight:800;display:flex;justify-content:space-between;gap:1rem}
.calc .note{color:var(--muted);font-size:.82rem;margin:.6rem 0 0}
.mistakes{list-style:none;padding-left:0!important}
.mistakes li{padding-left:1.8rem;position:relative}
.mistakes li::before{content:"✕";position:absolute;left:.2rem;color:#E63946;font-weight:900;font-family:"Be Vietnam Pro",sans-serif}
.tools{display:flex;flex-wrap:wrap;gap:.45rem;margin:.4rem 0 1.2rem}
.tools span{font-family:"Be Vietnam Pro",sans-serif;font-size:.85rem;font-weight:600;padding:.25rem .7rem;border-radius:99px;border:1.5px solid var(--cc,var(--line));color:var(--cc,var(--ink))}
details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:.9rem 1.1rem;margin-bottom:.6rem}
summary{cursor:pointer;font-family:"Be Vietnam Pro",sans-serif;font-weight:700}
details p{margin:.7rem 0 0}
.week{display:grid;grid-template-columns:6.5rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px dashed var(--line)}
.week:last-child{border-bottom:0}
.week b{font-family:"Be Vietnam Pro",sans-serif;color:var(--c5)}
.week ul{margin:0;padding-left:1.1rem}
@media (max-width:560px){.week{grid-template-columns:1fr;gap:.25rem}}

/* ===== FUNNEL ===== */
.bridge{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;margin:2rem 0 0;padding:1.1rem 1.25rem;border-radius:14px;
  background:color-mix(in srgb,var(--c5) 10%,var(--card));border:1.5px dashed var(--c5);font-family:"Be Vietnam Pro",sans-serif}
.bridge .ic{font-size:1.8rem;line-height:1}
.bridge p{margin:0;font-size:.95rem;line-height:1.55}
.bridge a{color:var(--c5);font-weight:700}
.offer{padding:5rem 0;background:linear-gradient(160deg,color-mix(in srgb,var(--c5) 14%,var(--paper)),color-mix(in srgb,var(--c6) 12%,var(--paper)));border-top:1px solid var(--line)}
.offer-grid{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:2.5rem;align-items:start;max-width:58rem;margin:0 auto;padding:0 1.25rem}
@media (max-width:760px){.offer-grid{grid-template-columns:minmax(0,1fr)}.bookmock{margin:0 auto}}
.bookmock{width:15rem;aspect-ratio:3/4;border-radius:6px 14px 14px 6px;background:var(--c9);color:#fff;padding:1.4rem 1.2rem;position:relative;
  box-shadow:-6px 0 0 rgba(0,0,0,.25) inset, 0 20px 40px -15px rgba(29,53,87,.55);display:flex;flex-direction:column;justify-content:space-between;font-family:"Be Vietnam Pro",sans-serif}
.bookmock .bars{display:flex;gap:4px}
.bookmock .bars i{flex:1;height:6px;border-radius:3px}
.bookmock h3{font-size:1.65rem;line-height:1.1;margin:0;font-weight:900;color:#fff}
.bookmock small{opacity:.8;font-size:.8rem}
.offer h2{font-size:clamp(1.8rem,4vw,2.5rem);line-height:1.15;margin:0 0 1rem;font-weight:900}
.offer .inside{list-style:none;padding:0;margin:1rem 0 1.5rem}
.offer .inside li{padding:.45rem 0 .45rem 1.9rem;position:relative;border-bottom:1px dashed var(--line)}
.offer .inside li::before{content:"✓";position:absolute;left:.25rem;color:var(--c8);font-weight:900;font-family:"Be Vietnam Pro",sans-serif}
.pricebox{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:1.4rem;margin:1.5rem 0;font-family:"Be Vietnam Pro",sans-serif}
.pricebox .old{text-decoration:line-through;color:var(--muted);margin-right:.6rem}
.pricebox .new{font-size:2rem;font-weight:900;color:var(--c1)}
.pricebox .code{display:inline-block;margin-top:.5rem;font-weight:800;border:2px dashed var(--c2);color:var(--c2);padding:.15rem .6rem;border-radius:8px}
.btn{display:inline-block;background:var(--c1);color:#fff!important;text-decoration:none;font-family:"Be Vietnam Pro",sans-serif;font-weight:800;
  padding:.95rem 1.6rem;border-radius:12px;font-size:1.05rem;margin-top:1rem;box-shadow:0 6px 0 color-mix(in srgb,var(--c1) 60%,#000)}
.btn:hover{filter:brightness(1.07)}
.btn:active{transform:translateY(3px);box-shadow:0 3px 0 color-mix(in srgb,var(--c1) 60%,#000)}
.guarantee{font-size:.9rem;color:var(--muted);margin-top:1rem}
.forwho{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.25rem 0}
.forwho div{background:var(--card);border-radius:12px;padding:1rem;border:1px solid var(--line);font-size:.95rem}
.forwho h4{margin:0 0 .4rem;font-family:"Be Vietnam Pro",sans-serif;font-size:.95rem}
@media (max-width:560px){.forwho{grid-template-columns:1fr}}
.authorbox{display:flex;gap:1rem;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1rem 1.2rem;margin:1.5rem 0;font-family:"Be Vietnam Pro",sans-serif}
.authorbox .av{flex:none;width:3.4rem;height:3.4rem;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:900;font-size:1.4rem;background:linear-gradient(135deg,var(--c5),var(--c6))}
.authorbox strong{display:block;font-size:1.05rem}
.authorbox span{font-size:.9rem;color:var(--muted)}
.authorbox a,.author a,footer a{color:var(--c5);font-weight:700;text-decoration:none}
@media (min-width:761px){.offer-grid>.bookmock{position:sticky;top:calc(2rem + env(safe-area-inset-top,0px))}}
.toc .extras{margin-top:2.5rem}
.toc .extras-label{font-family:"Be Vietnam Pro",sans-serif;font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 .75rem}
.toc .extras-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}
.toc .extras-grid a{display:block;padding:.75rem .9rem;border:1px solid var(--line);border-bottom:1px solid var(--line);border-radius:10px;background:var(--card);transition:border-color .15s ease,transform .15s ease}
.toc .extras-grid a:hover{border-color:var(--ink);transform:translateY(-2px);background:var(--card)}
.toc .extras-grid small{display:block;font-size:.72rem;color:var(--muted);font-weight:600;margin-bottom:.15rem}
.toc .extras-grid span{font-weight:700;font-size:.95rem}
.toc a.extras-offer{display:flex;justify-content:space-between;align-items:center;margin-top:.6rem;padding:.9rem 1.1rem;border-radius:10px;border:0;background:var(--c1);color:#fff}
.toc a.extras-offer:hover{background:var(--c1);filter:brightness(1.06)}
.toc a.extras-offer small{display:block;font-size:.72rem;opacity:.9;font-weight:600;color:#fff}
.toc a.extras-offer strong{font-size:.98rem}
.toc a.extras-offer b{font-size:1.3rem}
@media (max-width:560px){.toc .extras-grid{grid-template-columns:1fr 1fr}}
.toc p a{display:inline;padding:0;border:0;background:none}
.toc p a:hover{background:none;text-decoration:underline}
.gloss{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin:1.25rem 0 0}
.gloss div{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.8rem 1rem}
.gloss dt{font-family:"Be Vietnam Pro",sans-serif;font-weight:800;color:var(--c5);margin-bottom:.2rem}
.gloss dd{margin:0;font-size:.95rem;line-height:1.55}
@media (max-width:560px){.gloss{grid-template-columns:1fr}}
.inside-groups{margin:1rem 0 1.5rem}
.ig-title{font-family:"Be Vietnam Pro",sans-serif;font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--c5);margin:1.4rem 0 .2rem}
.inside-groups .inside{margin:0}
.ig-n{font-family:"Be Vietnam Pro",sans-serif;font-weight:800;font-size:.78rem;color:var(--muted);margin-right:.45rem}
.bonus{margin-top:1.5rem;background:var(--card);border:1.5px dashed var(--c2);border-radius:14px;padding:1rem 1.2rem .4rem}
.bonus .ig-title{color:var(--c2)}
.bonus .inside li{border-bottom:0}
.bonus .inside li::before{content:"★";color:var(--c2)}
.quick{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1rem 1.2rem;margin:0 0 1.75rem}
.quick-top{display:flex;justify-content:space-between;align-items:center;gap:.75rem;margin-bottom:.5rem}
.quick-label{font-family:"Be Vietnam Pro",sans-serif;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--cc)}
.pill{font-family:"Be Vietnam Pro",sans-serif;font-size:.75rem;font-weight:700;padding:.2rem .65rem;border-radius:99px;white-space:nowrap}
.pill.now{background:color-mix(in srgb,var(--c8) 16%,var(--card));color:var(--c8)}
.pill.later{background:color-mix(in srgb,var(--muted) 14%,var(--card));color:var(--muted)}
.quick p{margin:0;font-size:1rem;line-height:1.6}
.quick p.when{margin-top:.5rem;font-family:"Be Vietnam Pro",sans-serif;font-size:.88rem;color:var(--muted)}
.kicker{font-family:"Be Vietnam Pro",sans-serif;font-weight:800;color:var(--c1);text-transform:uppercase;letter-spacing:.06em;font-size:.82rem;margin:0 0 .6rem}
.deadline{font-family:"Be Vietnam Pro",sans-serif;font-weight:700;color:var(--c1);margin:.6rem 0 0}
.testi{display:grid;gap:.8rem;margin:1.5rem 0}
.testi blockquote{margin:0;background:var(--card);border:1px solid var(--line);border-left:5px solid var(--c8);border-radius:0 12px 12px 0;padding:1rem 1.2rem}
.testi cite{display:block;font-style:normal;font-family:"Be Vietnam Pro",sans-serif;font-size:.85rem;color:var(--muted);margin-top:.5rem}
.ps{font-style:italic;color:var(--muted);border-top:1px solid var(--line);padding-top:1rem;margin-top:2rem}
.sticky-cta{position:fixed;left:0;right:0;bottom:0;padding:.65rem 1rem;padding-bottom:calc(.65rem + env(safe-area-inset-bottom,0px));
  background:var(--card);border-top:1px solid var(--line);display:flex;gap:1rem;justify-content:center;align-items:center;
  font-family:"Be Vietnam Pro",sans-serif;font-size:.92rem;transform:translateY(110%);transition:transform .3s ease;z-index:20;box-shadow:0 -8px 24px -12px rgba(0,0,0,.25)}
.sticky-cta.show{transform:none}
.sticky-cta a{background:var(--c1);color:#fff;text-decoration:none;font-weight:800;padding:.5rem 1rem;border-radius:10px;white-space:nowrap}
.sticky-cta button{background:none;border:0;color:var(--muted);font-size:1.2rem;cursor:pointer;padding:.2rem .4rem}
@media (max-width:560px){.sticky-cta span.txt{display:none}}
@media print{.sticky-cta{display:none}}

/* ===== ILLUSTRATIONS ===== */
figure.ill{margin:0 0 2rem}
figure.ill svg{display:block;width:100%;height:auto;border-radius:16px}
figure.ill figcaption{font-family:"Be Vietnam Pro",sans-serif;font-size:.82rem;color:var(--muted);margin-top:.5rem;text-align:center}
