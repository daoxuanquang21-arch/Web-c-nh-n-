<div class="sticky-cta" id="sticky" role="region" aria-label="Ebook Tạo Blog Bằng AI">
  <span class="txt">Dựng xong blog trong vài buổi tối với ebook <strong data-fill="name">Tạo Blog Bằng AI</strong></span>
  <a data-link href="https://daoxuanquang.com.vn/ebook-tao-blog" target="_blank" rel="noopener">Xem ebook</a>
  <button type="button" aria-label="Đóng" onclick="this.parentNode.remove()">×</button>
</div>
<script is:inline>
(function(){
  var P = window.PRODUCT || {};
  document.querySelectorAll('[data-fill]').forEach(function(el){
    var v = P[el.getAttribute('data-fill')]; if (v) el.textContent = v;
  });
  document.querySelectorAll('[data-link]').forEach(function(a){
    if (P.link) { a.href = P.link; a.target = "_blank"; a.rel = "noopener"; }
  });
  document.querySelectorAll('[data-site]').forEach(function(a){
    if (P.website) a.href = 'https://' + P.website.replace(/^https?:\/\//,'');
  });
  var T = (P.testimonials || []).filter(function(t){ return t && t.text; });
  var box = document.getElementById('testimonials');
  if (box && T.length) {
    var h = document.createElement('h3'); h.textContent = 'Người đọc nói gì'; h.style.cssText='margin:2rem 0 .5rem;font-size:1.2rem';
    var wrap = document.createElement('div'); wrap.className = 'testi';
    T.forEach(function(t){
      var q = document.createElement('blockquote'); q.textContent = '“' + t.text + '”';
      var c = document.createElement('cite'); c.textContent = '— ' + (t.name || '') + (t.role ? ', ' + t.role : '');
      q.appendChild(c); wrap.appendChild(q);
    });
    box.appendChild(h); box.appendChild(wrap);
  }
  window.addEventListener('beforeprint', function(){ document.querySelectorAll('details').forEach(function(d){ d.setAttribute('open',''); }); });
  var bar = document.getElementById('sticky'), offer = document.getElementById('offer');
  var offerVisible = false;
  if ('IntersectionObserver' in window && offer) {
    new IntersectionObserver(function(e){ offerVisible = e[0].isIntersecting; update(); }).observe(offer);
  }
  function update(){
    if (!document.body.contains(bar)) return;
    var past = window.scrollY > window.innerHeight * 1.2;
    bar.classList.toggle('show', past && !offerVisible);
  }
  window.addEventListener('scroll', update, {passive:true});
})();
</script>
