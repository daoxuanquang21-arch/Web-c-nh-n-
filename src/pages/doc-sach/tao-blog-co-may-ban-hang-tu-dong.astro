.pf-kick{font-family:var(--sans);font-size:.9rem;font-weight:700;color:var(--jade);margin-bottom:10px}
.preface .pf-head{font-family:var(--sans);font-weight:800;font-size:clamp(1.7rem,3.8vw,2.4rem);line-height:1.22;letter-spacing:-.02em;color:var(--ink);margin:0 0 22px}
.stairs{list-style:none;padding:0;margin:28px 0 30px;position:relative}
