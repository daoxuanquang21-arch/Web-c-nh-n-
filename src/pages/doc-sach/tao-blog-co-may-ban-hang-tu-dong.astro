.pe6 ol{list-style:none;padding:0;margin:0 0 12px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pe6 li{display:flex;gap:10px;align-items:flex-start;background:var(--gold-soft);border-radius:10px;padding:10px 12px;margin:0;font-size:.85rem}
.pe6 li svg{width:20px;height:20px;color:var(--gold);flex:none;margin-top:1px}.pe6 li b{display:block;color:var(--ink);font-size:.92rem}
.pe6 p{margin:0 0 12px;font-size:.88rem}
@media (max-width:700px){.pe6 ol{grid-template-columns:1fr 1fr}}@media (max-width:420px){.pe6 ol{grid-template-columns:1fr}}
.prompt pre b.pk{color:var(--jade);font-weight:700}
.who{display:inline-block;vertical-align:middle;margin-left:8px;font-family:var(--sans);font-size:.72rem;font-weight:700;border-radius:999px;padding:3px 10px;white-space:nowrap}
.who.ai{background:var(--jade);color:#fff}.who.me{background:var(--ink);color:var(--paper)}.who.both{background:var(--gold-soft);color:var(--ink);border:1px solid var(--gold)}
.who.ref{background:var(--code);color:var(--muted)}
.who-box{margin:22px 0;border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:16px 18px;font-family:var(--sans);font-size:.92rem;line-height:1.55}
.who-box>b{display:block;font-size:1.08rem;color:var(--ink)}.who-box>span{color:var(--muted)}
.who-row{display:flex;gap:12px;align-items:center;margin-top:10px}.who-row .who{margin-left:0;flex:none;min-width:118px;text-align:center}
ul.me-list{list-style:none;padding:0;margin:8px 0 18px;font-family:var(--sans);font-size:.94rem}
ul.me-list li{display:flex;gap:10px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin:8px 0;line-height:1.55}
ul.me-list svg{width:20px;height:20px;color:var(--ink);flex:none;margin-top:2px}
@media (max-width:560px){.who-row{flex-direction:column;align-items:flex-start;gap:4px}}
.adm{font-family:var(--sans)}.adm-f{margin:0 0 10px}.adm-f label{display:block;font-size:.74rem;font-weight:700;color:var(--muted);margin-bottom:3px}
.adm-f .fld{display:block;min-width:0}.adm-f small{display:block;text-align:right;font-size:.7rem;color:var(--jade)}
.adm-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.adm-ed{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--paper)}
.adm-tb{display:flex;flex-wrap:wrap;gap:4px;padding:6px;border-bottom:1px solid var(--line);background:var(--surface)}
.adm-tb>*{border:1px solid var(--line);border-radius:5px;padding:2px 7px;font-size:.74rem;font-style:normal;text-decoration:none;color:var(--ink);background:var(--paper)}
.adm-tb i{font-style:italic}.adm-tb u{text-decoration:underline}.adm-tb .sel{outline:2px dashed var(--gold);outline-offset:1px}
.adm-body{padding:10px 12px;font-size:.84rem;line-height:1.6}.adm-body p{margin:0 0 6px}.adm-body h5{margin:6px 0;font-size:.95rem;color:var(--ink)}
.adm-img{border:1px dashed var(--line);border-radius:6px;padding:8px;color:var(--muted);font-size:.78rem}
@media (max-width:560px){.adm-row{grid-template-columns:1fr}}

/* ===== next step / offer ===== */
.ns{padding:56px 0 30px}
.ns .pf-kick{margin-bottom:10px}
.ns h2.ns-h{font-size:clamp(1.7rem,3.8vw,2.4rem);line-height:1.2;margin:0 0 18px;letter-spacing:-.02em}
.ns h2.ns-h span{color:var(--jade)}
.ns p{font-size:1.08rem;line-height:1.85}
.ns h3{font-size:1.3rem;margin:36px 0 12px}
.pain{list-style:none;padding:0;margin:14px 0 22px;font-family:var(--sans);font-size:.96rem}
.pain li{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px dashed var(--line);margin:0;line-height:1.55}
.pain li svg{width:20px;height:20px;color:var(--red);flex:none;margin-top:2px}
.dream{background:linear-gradient(135deg,#2A170E,#3D1F10);color:#F3E3D7;border-radius:18px;padding:26px 26px 12px;margin:24px 0}
.dream p{color:#F3E3D7;font-style:italic}
.dream b{color:#FFB27A;font-style:normal}
.gets{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:16px 0 22px;font-family:var(--sans);font-size:.92rem;line-height:1.5}
.gets div{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px}
.gets svg{width:26px;height:26px;color:var(--jade);flex:none}
.gets b{display:block;color:var(--ink);font-size:.98rem;margin-bottom:2px}
.guar{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 22px;font-family:var(--sans);font-size:.92rem;line-height:1.55}
.guar div{background:var(--jade-soft);border-radius:12px;padding:14px 16px}
.guar b{display:flex;gap:8px;align-items:center;color:var(--ink);margin-bottom:4px}.guar svg{width:20px;height:20px;color:var(--jade)}
.fit{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0 24px;font-family:var(--sans);font-size:.9rem;line-height:1.55}
.fit>div{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--surface)}
.fit h5{margin:0 0 8px;font-size:.95rem;color:var(--ink)}
.fit ul{margin:0;padding-left:1.1em}.fit li{margin:4px 0}
.ns-cta{text-align:center;background:var(--surface);border:2px solid var(--jade);border-radius:18px;padding:26px 20px;margin:30px 0 10px;font-family:var(--sans)}
.ns-cta p{font-family:var(--sans);font-size:.98rem;margin:0 0 16px;color:var(--text)}
.ns-cta .cta{animation:ctaPulse 2.2s ease-in-out infinite}
.ns-cta small{display:block;margin-top:12px;color:var(--muted);font-size:.84rem}
.ns-cta small a{color:var(--jade);font-weight:600}
.ns-cta .cta small{color:#fff;opacity:.9;margin-top:0;font-size:.76rem}
@media (max-width:640px){.gets,.guar,.fit{grid-template-columns:1fr}}
.guar.guar3{grid-template-columns:repeat(3,1fr)}
.deal.deal-big{font-size:1rem;padding:16px 18px;margin:18px 0 10px}
@media (max-width:820px){.guar.guar3{grid-template-columns:1fr}}
.proof{margin:18px 0 24px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--surface)}
.proof img{display:block;width:100%;height:auto}
.proof figcaption{font-family:var(--sans);font-size:.85rem;line-height:1.55;color:var(--text);padding:12px 16px;margin:0;border-top:1px solid var(--line)}
.proof figcaption b{color:var(--ink)}
.guar.guar3{grid-template-columns:1fr 1fr}
.guar .star{grid-column:1/-1;position:relative;background:linear-gradient(135deg,#F76B1C,#C2370A);color:#fff;border-radius:16px;padding:22px 22px 18px;box-shadow:0 14px 30px -14px rgba(194,55,10,.65);animation:ctaPulse 2.6s ease-in-out infinite}
.guar .star b{color:#fff;font-size:1.25rem;display:flex;gap:10px;align-items:center;margin:6px 0 6px}
.guar .star b svg{width:28px;height:28px;color:#fff}
.guar .star p{margin:0 0 8px;font-size:1.02rem;line-height:1.6;color:#fff}
.guar .star strong{color:#FFF1C2}
.guar .star small{display:block;font-size:.85rem;color:#FFE1CC;font-style:italic}
.star-tag{display:inline-block;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:3px 12px;font-size:.75rem;font-weight:700;letter-spacing:.02em}
@media (prefers-reduced-motion:reduce){.guar .star{animation:none}}
.hstats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;font-family:var(--sans)}
.hstats>div{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:4px;min-height:84px;padding:12px 10px;border-radius:14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,200,160,.22)}
.hstats b{font-size:1.7rem;line-height:1;color:#FF8A4C;font-weight:800}
.hstats svg{width:26px;height:26px;color:#FF8A4C}
.hstats span{font-size:.8rem;color:#F3E3D7;line-height:1.3}
@media (max-width:760px){.hstats{grid-template-columns:repeat(3,1fr)}}
@media (max-width:420px){.hstats{grid-template-columns:repeat(2,1fr)}.hstats>div:last-child{grid-column:1/-1}}
.cost td:nth-child(2) b{color:var(--jade)}
.cost-sum{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:4px 0 18px;font-family:var(--sans)}
.cost-sum>div{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:14px;text-align:center;line-height:1.35}
.cost-sum span{display:block;font-size:.78rem;font-weight:700;color:var(--muted)}
.cost-sum b{display:block;font-size:1.45rem;color:var(--ink);margin:4px 0}
.cost-sum small{font-size:.78rem;color:var(--muted)}
.cost-sum .hl2{border:2px solid var(--jade);background:var(--jade-soft)}.cost-sum .hl2 b{color:var(--jade)}
@media (max-width:560px){.cost-sum{grid-template-columns:1fr}}
.hero h1 .h1-sub{display:block;font-size:.62em;line-height:1.15;margin-top:10px;color:#FF8A4C;letter-spacing:-.02em}
@media print{body.paged .pg{display:block!important}.pgbar,.pg-end,.pgno{display:none!important}}

@media print{nav.toc,.topbar,#progress,.copy,.scrim{display:none!important}.shell{display:block}section.chapter{break-inside:auto}}
</style>
