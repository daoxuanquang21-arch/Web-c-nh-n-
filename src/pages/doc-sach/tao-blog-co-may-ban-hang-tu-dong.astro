@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .serp .st{color:#8AB4F8}}
.serp .sd{font-size:.84rem;color:var(--text);line-height:1.5}
.serp-lbl{display:flex;gap:6px;align-items:center;font-weight:700;font-size:.82rem;margin:10px 0 4px}
.stack{display:flex;height:30px;border-radius:8px;overflow:hidden;margin:6px 0 8px}
.stack i{display:block;height:100%}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.8rem;margin-bottom:12px}
.legend span{display:inline-flex;gap:6px;align-items:center}.legend i{width:10px;height:10px;border-radius:3px;display:inline-block}
.tree{margin:0 0 12px;text-align:center}
.tree .pillar{display:inline-flex;gap:8px;align-items:center;background:var(--jade);color:#fff;padding:10px 16px;border-radius:10px;font-weight:700}
.tree .kids{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:18px;position:relative;text-align:left}
.tree .kids::before{content:"";position:absolute;top:-12px;left:50%;width:2px;height:12px;background:var(--line)}
.tree .kids div{border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:.82rem;line-height:1.4;background:var(--paper)}
.minichart{display:flex;align-items:flex-end;gap:12px;height:120px;padding:0 4px;border-bottom:2px solid var(--line);margin:4px 0 6px}
.minichart div{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;font-size:.78rem}
.minichart i{display:block;width:100%;max-width:56px;background:var(--c,var(--jade));border-radius:6px 6px 0 0}
.minichart b{color:var(--ink);margin-bottom:4px}
.mclbl{display:flex;gap:12px;font-size:.78rem;color:var(--muted);margin-bottom:12px}.mclbl span{flex:1;text-align:center}
.rw{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 12px}
.rw>div{border-radius:10px;padding:12px 14px;font-size:.87rem}
.rw .a{background:var(--red-soft)}.rw .m{background:var(--jade-soft)}
.rw h5{margin:0 0 6px;display:flex;gap:6px;align-items:center;font-size:.82rem;color:var(--ink)}
.chipset{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}
.chipset span{display:inline-flex;gap:7px;align-items:center;border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-size:.84rem;background:var(--paper)}
.chipset svg{color:var(--jade)}
.persona{display:flex;gap:16px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;font-family:var(--sans);font-size:.92rem;line-height:1.55;margin:18px 0}
.persona .av{flex:none;width:60px;height:60px;border-radius:50%;background:var(--jade-soft);color:var(--jade);display:grid;place-items:center}
.persona .av svg{width:32px;height:32px}
.persona b{color:var(--ink)}
@media (max-width:560px){.stats{grid-template-columns:1fr}.vs,.rw{grid-template-columns:1fr}.bars .r{grid-template-columns:1fr 54px}.bars .r .t{grid-column:1/-1;grid-row:2}.field-h span{margin-left:0;width:100%}.ch-ico{width:48px;height:48px}}


/* ===== v3: terminal & code ===== */
.cmd{margin:14px 0 20px;border-radius:10px;overflow:hidden;background:#1E140F;border:1px solid #3A2a20}
.cmd-h{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:7px 10px 7px 14px;background:#2C1D15;color:#F3D9C6;font-family:var(--sans);font-size:.82rem;font-weight:600}
.cmd-h .ph-t{display:flex;gap:8px;align-items:center}.cmd-h .ph-t .ico{color:#FF8A4C}
.cmd .copy{background:#3A271C;color:#FBE9DC;border-color:#5A3B2A}
.cmd .copy.done{background:#E8590C;border-color:#E8590C}
.cmd pre{margin:0;padding:14px 16px;overflow-x:auto;white-space:pre;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;font-size:.84rem;line-height:1.65;color:#FBEDE3;tab-size:4}
.term .win-bar{background:#2C1D15;border-color:#3A2A20}.term .win-bar .url{background:#1E140F;color:#B59C8B}
.term .win-body{background:#1E140F;color:#F3E3D7;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.8rem;line-height:1.7}
.term .g{color:#5FD4A0}.term .m{color:#B59C8B}
.term{border-color:#3A2A20}


/* ===== v4: affiliate & AI ops ===== */
.aff{border:2px solid var(--jade);border-radius:14px;background:var(--surface);margin:26px 0;font-family:var(--sans);overflow:hidden;font-size:.93rem;line-height:1.6}
