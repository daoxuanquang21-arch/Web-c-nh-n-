---
import MetaPixel from '../../components/MetaPixel.astro';
---
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tạo Blog – cỗ máy bán hàng tự động bằng AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style is:inline>
:root{
  --ink:#2A1A12; --paper:#FFFAF6; --surface:#FFFFFF; --text:#3A2A21; --muted:#7A6455;
  --line:#F0DFD2; --jade:#E8590C; --jade-soft:#FFF1E8; --gold:#F59E0B; --gold-soft:#FFF4DE;
  --red:#B4372F; --red-soft:#FBE7E5; --code:#FBEFE6;
  --sans:"Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --serif:"Lora",Georgia,"Times New Roman",serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ink:#F8E9DE; --paper:#17110D; --surface:#211813; --text:#EADBD0; --muted:#B59C8B;
    --line:#3B2C22; --jade:#FF8A4C; --jade-soft:#3A1F10; --gold:#FBBF24; --gold-soft:#33240F;
    --red:#F08A80; --red-soft:#3A1C1A; --code:#2B1F18;
  }
}
:root[data-theme="dark"]{
  --ink:#F8E9DE; --paper:#17110D; --surface:#211813; --text:#EADBD0; --muted:#B59C8B;
  --line:#3B2C22; --jade:#FF8A4C; --jade-soft:#3A1F10; --gold:#FBBF24; --gold-soft:#33240F;
  --red:#F08A80; --red-soft:#3A1C1A; --code:#2B1F18;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth; scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{margin:0;background:var(--paper);color:var(--text);font-family:var(--serif);font-size:1.0625rem;line-height:1.75;-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:var(--jade);text-underline-offset:3px}
:focus-visible{outline:3px solid #F59E0B;outline-offset:2px;border-radius:3px}
h1,h2,h3,h4{font-family:var(--sans);color:var(--ink);line-height:1.25;letter-spacing:-.01em}
h3{font-size:1.25rem;margin:2.2em 0 .6em}
h4{font-size:1.05rem;margin:1.6em 0 .4em}
p{margin:0 0 1em}
ul,ol{padding-left:1.4em;margin:0 0 1.1em}
li{margin:.3em 0}
strong{color:var(--ink);font-weight:600}
code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.88em;background:var(--code);padding:.12em .4em;border-radius:4px}

/* progress */
#progress{position:fixed;top:0;left:0;height:3px;background:var(--jade);width:0;z-index:60}

/* topbar (mobile) */
.topbar{position:sticky;top:0;z-index:50;display:none;align-items:center;justify-content:space-between;gap:12px;
  padding:10px 16px;padding-top:calc(10px + env(safe-area-inset-top,0px));margin-top:calc(-1 * env(safe-area-inset-top,0px));
  background:var(--surface);border-bottom:1px solid var(--line);font-family:var(--sans)}
.topbar b{color:var(--ink);font-size:.95rem}
.btn{font-family:var(--sans);font-size:.9rem;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--ink);
  padding:8px 14px;border-radius:8px;cursor:pointer}
.btn:hover{border-color:var(--jade)}

/* layout */
.shell{display:grid;grid-template-columns:300px minmax(0,1fr);min-height:100%}
nav.toc{position:sticky;top:0;height:100vh;height:100dvh;overflow-y:auto;background:var(--surface);border-right:1px solid var(--line);
  padding:28px 22px 40px;font-family:var(--sans);font-size:.9rem}
.toc .brand{display:block;font-weight:800;font-size:1.05rem;color:var(--ink);text-decoration:none;line-height:1.3;margin-bottom:6px}
.toc .sub{color:var(--muted);font-size:.8rem;margin-bottom:22px}
.toc .phase{font-weight:700;color:var(--muted);font-size:.78rem;margin:20px 0 6px}
.toc a.item{display:flex;gap:10px;padding:6px 8px;border-radius:6px;color:var(--text);text-decoration:none;line-height:1.35}
.toc a.item span{color:var(--muted);font-variant-numeric:tabular-nums;min-width:20px;font-weight:600}
.toc a.item:hover{background:var(--code)}
.toc a.item.active{background:var(--jade-soft);color:var(--ink)}
.toc a.item.active span{color:var(--jade)}
.toc .tools{margin-top:24px;display:flex;gap:8px;flex-wrap:wrap}
main{min-width:0}
.wrap{max-width:46rem;margin:0 auto;padding:0 24px}

/* hero */
.hero{background:radial-gradient(120% 140% at 85% 0%,#4A2412 0%,#2A170E 55%,#20120B 100%);color:#fff;border-bottom:4px solid #E8590C;padding:72px 0 64px}
:root[data-theme="dark"] .hero{background:radial-gradient(120% 140% at 85% 0%,#3A1C0E 0%,#1C100A 60%,#140B07 100%)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .hero{background:radial-gradient(120% 140% at 85% 0%,#3A1C0E 0%,#1C100A 60%,#140B07 100%)}}
.hero .wrap{max-width:58rem}
.hero h1{color:#fff;font-size:clamp(2.2rem,5vw,3.6rem);font-weight:800;margin:0 0 18px;letter-spacing:-.03em;line-height:1.08}
.hero p.lead{font-size:1.15rem;color:#E9D3C3;max-width:40rem;margin-bottom:40px}
.hero .meta{font-family:var(--sans);font-size:.9rem;color:#FFE1CC}
/* route map */
.route{position:relative;margin:8px 0 34px;padding:22px 0 0}
.route-line{position:absolute;left:0;right:0;top:41px;height:4px;background:linear-gradient(90deg,#FF8A4C 0 28.6%,#FBBF24 28.6% 71.4%,#F97316 71.4% 85.7%,#FDBA74 85.7% 100%);opacity:.75;border-radius:4px}
.stops{position:relative;display:grid;grid-template-columns:repeat(14,1fr);gap:0}
.stop{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#fff;font-family:var(--sans)}
.stop i{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-weight:700;font-size:.9rem;
  background:#2A170E;border:3px solid var(--c);color:#fff;transition:transform .15s}
.stop:hover i{transform:scale(1.12);background:var(--c);color:#2A170E}
.stop small{font-size:.68rem;margin-top:8px;text-align:center;line-height:1.25;max-width:70px;color:#D9BFAE}
.phase-legend{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;font-family:var(--sans);margin-top:26px}
.phase-legend div{border-top:3px solid var(--c);padding-top:10px}
.phase-legend b{display:block;color:#fff;font-size:.95rem}
.phase-legend span{font-size:.82rem;color:#C9AE9C}

/* chapters */
section.chapter{padding:64px 0 24px;border-bottom:1px solid var(--line)}
.ch-head{display:flex;gap:18px;align-items:flex-start;margin-bottom:22px}
.ch-num{flex:none;font-family:var(--sans);font-weight:800;font-size:2.6rem;line-height:1;color:var(--c,var(--jade));letter-spacing:-.04em}
.ch-head h2{font-size:clamp(1.55rem,3vw,2rem);margin:.15em 0 .3em}
.ch-head .ph{font-family:var(--sans);font-size:.85rem;color:var(--muted)}
.goal{font-family:var(--sans);font-size:.95rem;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--c,var(--jade));
  padding:14px 18px;border-radius:0 10px 10px 0;margin:0 0 28px;line-height:1.6}
.goal b{color:var(--ink)}

/* callouts */
.note,.warn,.tip{font-family:var(--sans);font-size:.94rem;line-height:1.65;padding:14px 18px;border-radius:10px;margin:22px 0}
.note{background:var(--code)}
.tip{background:var(--jade-soft)}
.warn{background:var(--red-soft)}
.note b,.tip b,.warn b{display:block;margin-bottom:4px;color:var(--ink)}
.warn b{color:var(--red)}

/* analogy table */
.tbl{overflow-x:auto;margin:20px 0 26px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-family:var(--sans);font-size:.9rem;line-height:1.5}
th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}
th{background:var(--code);color:var(--ink);font-weight:700}
tr:last-child td{border-bottom:0}

/* steps */
ol.steps{list-style:none;padding:0;counter-reset:s;margin:22px 0}
ol.steps>li{counter-increment:s;position:relative;padding:0 0 18px 48px;margin:0}
ol.steps>li::before{content:counter(s);position:absolute;left:0;top:2px;width:32px;height:32px;border-radius:50%;background:var(--jade);color:#fff;
  font-family:var(--sans);font-weight:700;font-size:.85rem;display:grid;place-items:center}
ol.steps>li::after{content:"";position:absolute;left:15px;top:38px;bottom:4px;width:2px;background:var(--line)}
ol.steps>li:last-child::after{display:none}
ol.steps>li>b:first-child{font-family:var(--sans);display:block;color:var(--ink)}

/* mock screenshot */
figure.shot{margin:22px 0 28px}
.win{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface);font-family:var(--sans);font-size:.84rem;line-height:1.45;box-shadow:0 8px 24px -14px rgba(22,35,63,.35)}
.win-bar{display:flex;align-items:center;gap:6px;padding:9px 12px;background:var(--code);border-bottom:1px solid var(--line)}
.win-bar i{width:10px;height:10px;border-radius:50%;background:#E5655B}.win-bar i+i{background:#E8B43C}.win-bar i+i+i{background:#4DB868}
.win-bar .url{flex:1;margin-left:10px;background:var(--surface);border-radius:6px;padding:3px 10px;color:var(--muted);font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.win-body{padding:16px;overflow-x:auto}
.win-body .row{display:flex;gap:10px;align-items:center;margin:6px 0;flex-wrap:wrap}
.fld{border:1px solid var(--line);border-radius:6px;padding:6px 10px;min-width:140px;background:var(--paper);color:var(--text)}
.lbl{color:var(--muted);min-width:120px}
.pbtn{background:#E8590C;color:#fff;border-radius:5px;padding:6px 12px;font-weight:600;display:inline-block}
.pbtn.g{background:#C2410C}
.hl{outline:2px dashed var(--gold);outline-offset:3px;border-radius:5px}
.wp{display:grid;grid-template-columns:150px 1fr;min-height:180px}
.wp-side{background:#1D2327;color:#C3C4C7;padding:10px 0}
.wp-side div{padding:5px 14px}.wp-side .on{background:#2271B1;color:#fff}
.wp-main{padding:14px 18px}
figcaption{font-family:var(--sans);font-size:.82rem;color:var(--muted);margin-top:8px}

/* prompt box */
.prompt{position:relative;margin:18px 0 22px;border:1px solid var(--line);border-radius:10px;background:var(--surface);overflow:hidden}
.prompt-h{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 12px 8px 16px;background:var(--gold-soft);font-family:var(--sans);font-size:.85rem;font-weight:600;color:var(--ink)}
.prompt pre{margin:0;padding:14px 16px;white-space:pre-wrap;word-wrap:break-word;font-family:var(--sans);font-size:.9rem;line-height:1.6;color:var(--text)}
.copy{white-space:nowrap;flex:none;font-family:var(--sans);font-size:.78rem;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:6px;padding:4px 10px;cursor:pointer}
.copy.done{background:var(--jade);color:#fff;border-color:var(--jade)}

/* checklist */
.check{list-style:none;padding:0;margin:14px 0 22px}
.check li{margin:0;border-bottom:1px solid var(--line)}
.check label{display:flex;gap:12px;align-items:flex-start;padding:10px 4px;cursor:pointer;font-family:var(--sans);font-size:.94rem;line-height:1.5}
.check input{width:20px;height:20px;margin-top:1px;accent-color:var(--jade);flex:none}
.check input:checked+span{color:var(--muted);text-decoration:line-through}
.meter{font-family:var(--sans);display:flex;align-items:center;gap:14px;margin:10px 0 6px;font-size:.9rem}
.meter .bar{flex:1;height:10px;background:var(--code);border-radius:6px;overflow:hidden}
.meter .bar i{display:block;height:100%;background:var(--jade);width:0;transition:width .3s}

/* glossary */
dl.gloss{display:grid;grid-template-columns:minmax(120px,190px) 1fr;gap:0;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface);font-family:var(--sans);font-size:.92rem}
dl.gloss dt,dl.gloss dd{margin:0;padding:10px 14px;border-bottom:1px solid var(--line);line-height:1.5}
dl.gloss dt{font-weight:700;color:var(--ink);background:var(--code)}
#glossSearch{width:100%;font:inherit;font-family:var(--sans);padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--text);margin:8px 0 14px}

/* fix cards */
details.fix{border:1px solid var(--line);border-radius:10px;background:var(--surface);margin:10px 0;font-family:var(--sans);font-size:.94rem}
details.fix summary{cursor:pointer;padding:12px 16px;font-weight:600;color:var(--ink)}
details.fix[open] summary{border-bottom:1px solid var(--line)}
details.fix .b{padding:12px 16px 4px;line-height:1.65}

.calendar{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:18px 0 24px;font-family:var(--sans);font-size:.86rem}
.calendar div{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;line-height:1.45}
.calendar b{display:block;color:var(--jade);font-size:.8rem}

footer{padding:56px 0 80px;font-family:var(--sans);font-size:.88rem;color:var(--muted)}

@media (max-width:960px){
  .shell{grid-template-columns:1fr}
  .topbar{display:flex}
  nav.toc{position:fixed;inset:0 auto 0 0;width:min(320px,86vw);z-index:70;transform:translateX(-102%);transition:transform .2s;
    padding-top:calc(28px + env(safe-area-inset-top,0px));box-shadow:0 0 40px rgba(0,0,0,.25)}
  nav.toc.open{transform:none}
  .scrim{position:fixed;inset:0;background:rgba(10,16,27,.45);z-index:65;display:none}
  .scrim.on{display:block}
  .stops{grid-template-columns:repeat(7,1fr);row-gap:26px}
  .route-line{display:none}
  .phase-legend{grid-template-columns:repeat(2,1fr)}
  .hero{padding:48px 0 44px}
}
@media (max-width:560px){
  body{font-size:1rem}
  .stops{grid-template-columns:repeat(5,1fr)}
  .ch-num{font-size:2rem}
  .wp{grid-template-columns:96px 1fr}
  dl.gloss{grid-template-columns:1fr}
  dl.gloss dt{border-bottom:0}
}

/* ===== v2: icons & thực chiến ===== */
.ico{width:1.15em;height:1.15em;vertical-align:-.2em;flex:none}
.ch-ico{flex:none;width:58px;height:58px;border-radius:16px;display:grid;place-items:center;color:var(--c,var(--jade));
  background:color-mix(in srgb,var(--c,var(--jade)) 13%,transparent);border:1px solid color-mix(in srgb,var(--c,var(--jade)) 30%,transparent)}
.ch-ico svg{width:30px;height:30px}
.ch-head{align-items:center}
.ch-head .ch-num{font-size:1rem;letter-spacing:0;display:block;margin-bottom:-2px}
.ch-text .ph{display:flex;gap:8px;align-items:center}
.goal,.note,.warn,.tip{position:relative;padding-left:54px}
.co-ico{position:absolute;left:16px;top:14px;width:24px;height:24px}
.goal .co-ico{color:var(--c,var(--jade))}
.note .co-ico{color:var(--muted)} .tip .co-ico{color:var(--jade)} .warn .co-ico{color:var(--red)}
.tip.todo{background:var(--surface);border:2px dashed var(--jade)}
.prompt-h .ph-t{display:flex;gap:8px;align-items:center}
.prompt-h .ph-t .ico{color:var(--gold)}
/* stats strip */
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:-10px 0 30px;font-family:var(--sans)}
.stats>div{display:flex;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px;line-height:1.3}
.stats svg{width:26px;height:26px;color:var(--c,var(--jade));flex:none}
.stats>div>div>span{display:block;font-size:.72rem;color:var(--muted)}
.stats b{font-size:.88rem;color:var(--ink);font-weight:600}
.dots{display:inline-flex;gap:3px;margin-left:6px;vertical-align:1px}.dots i{width:7px;height:7px;border-radius:50%;background:var(--line)}.dots i.on{background:var(--c,var(--jade))}
/* icon cards */
.icards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin:20px 0 28px;font-family:var(--sans)}
.icard{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;line-height:1.45}
.icard>svg{width:34px;height:34px;color:var(--jade);margin-bottom:8px}
.icard b{display:block;color:var(--ink);font-size:1rem}
.icard .as{display:block;font-size:.8rem;color:var(--gold);font-weight:600;margin:2px 0 6px}
:root[data-theme="light"] .icard .as{color:#9A6A07}
.icard p{margin:0;font-size:.86rem;color:var(--text)}
.igrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:10px;margin:14px 0 24px;font-family:var(--sans);font-size:.9rem;line-height:1.5}
.igrid div{display:flex;gap:12px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.igrid svg{width:24px;height:24px;color:var(--jade);flex:none;margin-top:1px}
.igrid b{color:var(--ink)}
td .ico{color:var(--jade);margin-right:6px}
.hero .chips{display:flex;flex-wrap:wrap;gap:8px;font-family:var(--sans);font-size:.85rem}
.hero .chips span{display:inline-flex;gap:7px;align-items:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,200,160,.22);color:#F3E3D7;padding:6px 12px;border-radius:999px}
.hero .chips svg{color:#FF8A4C}
details.fix summary{display:flex;gap:10px;align-items:center}
details.fix summary .ico{color:var(--red)}
/* thực chiến */
.field{margin:30px 0 22px;border-radius:14px;background:var(--surface);border:1px solid var(--line);border-top:5px solid var(--c,var(--jade));font-family:var(--sans);font-size:.93rem;line-height:1.6;overflow:hidden}
.field-h{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;padding:14px 18px;background:color-mix(in srgb,var(--c,var(--jade)) 9%,transparent)}
.field-h svg{width:26px;height:26px;color:var(--c,var(--jade))}
.field-h b{font-size:1.05rem;color:var(--ink)}
.field-h span{font-size:.78rem;color:var(--muted);margin-left:auto}
.field-b{padding:16px 18px 6px}
.field-b p{margin:0 0 12px}
.lesson{display:flex;gap:10px;align-items:flex-start;background:var(--jade-soft);border-radius:8px;padding:10px 12px;margin:4px 0 14px}
.lesson svg{width:20px;height:20px;color:var(--jade);flex:none;margin-top:2px}
.vs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 12px}
.vs>div{border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.vs .ok{border-color:var(--jade);background:var(--jade-soft)}
.vs h5{margin:0 0 6px;font-size:.92rem;color:var(--ink);display:flex;gap:8px;align-items:center}
.vs ul{list-style:none;padding:0;margin:0}.vs li{display:flex;gap:8px;margin:4px 0;font-size:.86rem}
.vs li svg{width:17px;height:17px;flex:none;margin-top:3px}
.yes{color:var(--jade)}.no{color:var(--red)}
.bars{margin:0 0 12px}
.bars .r{display:grid;grid-template-columns:minmax(120px,40%) 1fr 54px;gap:10px;align-items:center;margin:8px 0;font-size:.86rem}
.bars .t{height:12px;background:var(--code);border-radius:6px;overflow:hidden}
.bars .t i{display:block;height:100%;border-radius:6px;background:var(--c,var(--jade))}
.bars .r b{text-align:right;color:var(--ink);font-variant-numeric:tabular-nums}
.tl{list-style:none;padding:0;margin:0 0 12px;border-left:2px solid var(--line)}
.tl li{position:relative;padding:0 0 10px 18px;margin:0}
.tl li::before{content:"";position:absolute;left:-7px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--surface);border:2px solid var(--c,var(--jade))}
.tl li.bad::before{border-color:var(--red);background:var(--red)}
.tl time{font-weight:700;color:var(--ink);margin-right:6px;font-variant-numeric:tabular-nums}
.serp{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:0 0 10px;font-family:Arial,var(--sans);background:var(--paper)}
.serp small{display:block;color:var(--muted);font-size:.78rem}
