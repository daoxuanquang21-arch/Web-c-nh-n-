.stairs .dot svg{width:22px;height:22px}
.stairs li:last-child .dot{background:var(--jade);color:#fff}
.stairs time{display:block;font-family:var(--sans);font-weight:800;font-size:.85rem;color:var(--jade);margin-bottom:2px}
.stairs b{display:block;font-family:var(--sans);font-size:1.08rem;color:var(--ink);margin-bottom:4px}
.stairs p{margin:0;font-size:1.02rem!important;line-height:1.7!important;color:var(--text)}
.honest{font-family:var(--sans);font-size:.9rem;color:var(--muted);border-top:1px dashed var(--line);padding-top:12px;margin:-6px 0 26px;line-height:1.6}

.preface{padding:64px 0 40px;border-bottom:1px solid var(--line)}
.preface .pf-quote{font-family:var(--sans);font-weight:800;font-size:clamp(1.6rem,3.6vw,2.35rem);line-height:1.25;letter-spacing:-.02em;color:var(--ink);margin:0 0 8px;position:relative;padding-top:38px}
.preface .pf-quote::before{content:"\201C";position:absolute;top:-18px;left:-4px;font-size:5.5rem;line-height:1;color:var(--jade);font-family:Georgia,serif}
.pf-quote span{display:block;color:var(--jade)}
.pf-label{font-family:var(--sans);font-size:.85rem;color:var(--muted);margin-bottom:34px}
.preface h2{font-size:1.5rem;margin:40px 0 14px}
.preface p{font-size:1.1rem;line-height:1.85}
.preface p.turn{font-size:1.25rem}
.future{background:var(--surface);border:1px solid var(--line);border-left:5px solid var(--jade);border-radius:0 14px 14px 0;padding:22px 24px 10px;margin:26px 0}
.future p{font-style:italic}
.turn{font-family:var(--sans);font-size:1.25rem;font-weight:700;color:var(--ink);text-align:center;margin:34px 0;line-height:1.5}
.promise{background:var(--jade-soft);border-radius:16px;padding:26px 26px 14px;margin:30px 0}
.promise h3{margin:0 0 14px;display:flex;gap:10px;align-items:center;font-size:1.2rem}
.promise h3 svg{width:28px;height:28px;color:var(--jade)}
.promise ul{list-style:none;padding:0;margin:0 0 12px;font-family:var(--sans);font-size:.98rem}
.promise li{display:flex;gap:10px;align-items:flex-start;margin:10px 0;line-height:1.6}
.promise li svg{width:22px;height:22px;color:var(--jade);flex:none;margin-top:1px}
.sign{margin-top:30px;font-family:var(--sans)}
.sign .nm{font-size:1.6rem;font-weight:800;color:var(--jade);letter-spacing:-.01em}
.sign small{display:block;color:var(--muted);font-size:.88rem}


/* ===== pager ===== */
body.paged .pg{display:none}
body.paged .pg.on{display:block}
body.paged main{padding-bottom:calc(84px + env(safe-area-inset-bottom,0px))}
body.paged .pg.on.in-r{animation:pgR .28s ease}
body.paged .pg.on.in-l{animation:pgL .28s ease}
@keyframes pgR{from{opacity:0;transform:translateX(36px)}to{opacity:1;transform:none}}
@keyframes pgL{from{opacity:0;transform:translateX(-36px)}to{opacity:1;transform:none}}
body.paged section.chapter,body.paged .preface{border-bottom:0}
.pgbar{position:fixed;left:300px;right:0;bottom:0;z-index:55;display:none;align-items:center;gap:10px;
  padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));background:color-mix(in srgb,var(--surface) 92%,transparent);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line);font-family:var(--sans)}
body.paged .pgbar{display:flex}
.pgbar button{font-family:var(--sans);font-weight:700;font-size:.9rem;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 14px;cursor:pointer;display:inline-flex;gap:6px;align-items:center;white-space:nowrap}
.pgbar button:hover:not(:disabled){border-color:var(--jade);color:var(--jade)}
.pgbar button:disabled{opacity:.35;cursor:default}
.pgbar #pgNext{background:var(--jade);border-color:var(--jade);color:#fff}
.pgbar #pgNext:hover:not(:disabled){filter:brightness(1.08);color:#fff}
.pgmid{flex:1;min-width:0;text-align:center;line-height:1.25}
.pgmid b{display:block;font-size:.95rem;color:var(--ink);font-variant-numeric:tabular-nums}
.pgmid span{display:block;font-size:.78rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pgdots{display:flex;gap:4px;justify-content:center;margin-top:5px;flex-wrap:wrap}
.pgdots i{width:6px;height:6px;border-radius:50%;background:var(--line)}.pgdots i.on{background:var(--jade);width:16px;border-radius:4px}
.pgno{display:inline-flex;align-items:center;gap:8px;font-family:var(--sans);font-size:.78rem;font-weight:700;color:var(--jade);background:var(--jade-soft);border-radius:999px;padding:4px 12px;margin:0 0 6px}
.hero .pgno{background:rgba(255,255,255,.08);color:#FF8A4C;margin-bottom:22px}
.pg-end{margin:40px 0 10px;padding-top:22px;border-top:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:12px;font-family:var(--sans)}
.hero .pg-end{border-top-color:rgba(255,255,255,.12);align-items:flex-start}
.pg-end .num{font-size:.85rem;color:var(--muted);letter-spacing:.04em}
.hero .pg-end .num{color:#C9AE9C}
.pg-next{display:inline-flex;align-items:center;gap:10px;background:var(--jade);color:#fff;border:0;border-radius:12px;padding:13px 20px;font-family:var(--sans);font-weight:700;font-size:1rem;cursor:pointer;text-align:left;max-width:100%}
.pg-next small{display:block;font-weight:500;font-size:.78rem;opacity:.85}
.pg-next:hover{filter:brightness(1.08)}
.swipe-hint{font-size:.78rem;color:var(--muted)}
.hero .swipe-hint{color:#C9AE9C}
.toc a.item .pgn{margin-left:auto;font-size:.72rem;color:var(--muted);font-weight:500;min-width:auto}
@media (max-width:960px){.pgbar{left:0}.pgbar button .bl{display:none}.pgbar button{padding:10px 12px}}
@media (prefers-reduced-motion:reduce){body.paged .pg.on{animation:none!important}}
.zalo{display:inline-flex;gap:8px;align-items:center;margin-top:10px;background:var(--jade);color:#fff!important;text-decoration:none;border-radius:10px;padding:8px 14px;font-weight:600;font-size:.95rem}.zalo b{color:#fff}.zalo svg{width:18px!important;height:18px!important;color:#fff!important;margin:0!important}.zalo:hover{filter:brightness(1.08)}
.aifirst{margin:26px 0;border-radius:16px;background:var(--surface);border:2px solid var(--jade);padding:20px 22px 8px;font-family:var(--sans);font-size:.95rem;line-height:1.65}
.af-h{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.af-h>svg{width:44px;height:44px;flex:none;color:#fff;background:var(--jade);border-radius:12px;padding:9px}
.af-h b{display:block;font-size:1.15rem;color:var(--ink)}.af-h span{color:var(--muted);font-size:.9rem}
.aifirst>p{margin:0 0 12px}
.af-steps{list-style:none;padding:0;margin:4px 0 14px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.af-steps li{display:flex;gap:10px;align-items:flex-start;background:var(--jade-soft);border-radius:10px;padding:12px;margin:0;font-size:.87rem;line-height:1.5}
.af-steps li svg{width:22px;height:22px;color:var(--jade);flex:none;margin-top:1px}
.af-steps b{display:block;color:var(--ink);font-size:.93rem;margin-bottom:2px}
.af-note{display:flex;gap:10px;align-items:flex-start;font-size:.88rem;color:var(--text);border-top:1px dashed var(--line);padding-top:10px}
.af-note svg{width:18px;height:18px;color:var(--jade);flex:none;margin-top:3px}
@media (max-width:700px){.af-steps{grid-template-columns:1fr}}
.pick{display:flex;gap:14px;align-items:flex-start;background:var(--jade);color:#fff;border-radius:14px;padding:16px 18px;margin:12px 0 18px;font-family:var(--sans);font-size:.95rem;line-height:1.6}
.pick svg{width:26px;height:26px;flex:none;margin-top:2px}.pick b{color:#fff;font-size:1.05rem}
.rec-tag{display:inline-block;vertical-align:middle;margin-left:8px;font-size:.72rem;font-weight:700;background:var(--jade);color:#fff;border-radius:999px;padding:3px 10px}
details.opt{border:1px dashed var(--line);border-radius:12px;margin:18px 0;background:var(--surface);font-family:var(--sans)}
details.opt summary{cursor:pointer;display:flex;gap:12px;align-items:center;padding:14px 16px;list-style:none}
details.opt summary::-webkit-details-marker{display:none}
details.opt summary::after{content:"▾";margin-left:auto;color:var(--muted)}details.opt[open] summary::after{content:"▴"}
details.opt .tag{flex:none;font-size:.72rem;font-weight:700;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 10px}
details.opt summary b{display:block;color:var(--ink);font-size:1.05rem}details.opt summary small{color:var(--muted);font-size:.84rem}
details.opt .opt-b{padding:0 18px 8px;font-family:var(--serif)}
.cta{padding:12px 16px 12px 20px!important;animation:ctaPulse 2.2s ease-in-out infinite}
.cta-txt{display:flex;flex-direction:column;line-height:1.25}.cta-txt b{font-size:1.02rem;color:#fff}.cta-txt small{font-size:.76rem;font-weight:500;opacity:.9}
.cta-arr{font-size:1.6rem;line-height:1;margin-left:6px;transition:transform .15s}.cta:hover .cta-arr{transform:translateX(4px)}
@keyframes ctaPulse{0%,100%{box-shadow:0 6px 16px -6px rgba(232,66,12,.55),0 0 0 0 rgba(247,107,28,.45)}50%{box-shadow:0 6px 16px -6px rgba(232,66,12,.55),0 0 0 10px rgba(247,107,28,0)}}
@media (prefers-reduced-motion:reduce){.cta{animation:none}}
.pe6{margin:22px 0;border:2px solid var(--gold);border-radius:16px;background:var(--surface);padding:18px 20px 6px;font-family:var(--sans);font-size:.92rem;line-height:1.55}
.pe6-h{display:flex;gap:12px;align-items:center;margin-bottom:12px}.pe6-h>svg{width:40px;height:40px;flex:none;background:var(--gold);color:#fff;border-radius:10px;padding:8px}
