.aff-h b{font-size:1.08rem;color:var(--ink)}
.aff-h span{font-size:.78rem;color:var(--muted);margin-left:auto}
.aff-b{padding:16px 18px 18px}
.aff-b p{margin:0 0 12px}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0 16px}
.plan{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--paper);position:relative}
.plan.rec{border:2px solid var(--jade)}
.plan b{display:block;color:var(--ink);font-size:1.05rem}
.plan .tl2{display:block;font-size:.76rem;color:var(--jade);font-weight:700;margin-bottom:4px}
.plan ul{list-style:none;padding:0;margin:6px 0 0;font-size:.84rem}.plan li{margin:3px 0;display:flex;gap:6px;align-items:center}
.plan li svg{width:15px;height:15px;color:var(--muted);flex:none;margin-top:4px}.plan li{align-items:flex-start!important}.plan li span{overflow-wrap:anywhere}
.cta{display:inline-flex;gap:10px;align-items:center;background:linear-gradient(135deg,#F76B1C,#E8420C);box-shadow:0 6px 16px -6px rgba(232,66,12,.55);color:#fff;text-decoration:none;font-weight:700;padding:12px 20px;border-radius:10px;font-size:1rem}
.cta:hover{filter:brightness(1.1)}.cta svg{width:20px;height:20px}


.disc{font-size:.8rem;color:var(--muted);margin-top:12px;line-height:1.5}
.cmp2 td:nth-child(2),.cmp2 td:nth-child(3){text-align:center}
@media (max-width:560px){.plans{grid-template-columns:1fr}.aff-h span{margin-left:0;width:100%}}

.deal{display:flex;gap:10px;align-items:flex-start;background:#FFF1E8;border:1px dashed #F76B1C;border-radius:10px;padding:10px 14px;margin:4px 0 14px;color:#7A2E06;font-size:.92rem;line-height:1.5}
.deal svg{width:22px;height:22px;flex:none;color:#E8420C;margin-top:1px}
.deal b{color:#B23A06}
:root[data-theme="dark"] .deal{background:#3A1F10;color:#F8C9A8;border-color:#F76B1C}:root[data-theme="dark"] .deal b{color:#FFB27A}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .deal{background:#3A1F10;color:#F8C9A8;border-color:#F76B1C}:root:not([data-theme="light"]) .deal b{color:#FFB27A}}

/* ===== preface ===== */
.twohr{background:var(--surface);border:2px solid var(--jade);border-radius:18px;padding:26px 26px 18px;margin:34px 0;font-family:var(--sans)}
.twohr-top{display:flex;gap:18px;align-items:center;margin-bottom:14px}
