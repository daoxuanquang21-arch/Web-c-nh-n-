<script is:inline>
(function(){
  var store={get:function(k){try{return localStorage.getItem(k)}catch(e){return null}},set:function(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
  var main=document.querySelector('main'), wrap=main.querySelector(':scope > .wrap'), hero=main.querySelector(':scope > header.hero');
  var foot=wrap.querySelector('footer');
  var pages=[hero].concat([].slice.call(wrap.children).filter(function(el){return el.tagName==='SECTION'}));
  if(foot) pages[pages.length-1].appendChild(foot);
  var total=pages.length;
  function titleOf(el,i){
    if(el===hero) return 'Bìa sách';
    var n=el.querySelector('.ch-num'), t=el.querySelector('h2');
    if(el.id==='loi-mo-dau') return 'Lời mở đầu';
    return (n?n.textContent+' · ':'')+(t?t.textContent:'Trang '+(i+1));
  }
  var titles=pages.map(titleOf);
  pages.forEach(function(el,i){
    el.classList.add('pg');
    var host=el===hero?el.querySelector('.wrap'):el;
    var no=document.createElement('div'); no.className='pgno'; no.textContent='Trang '+(i+1)+' / '+total;
    host.insertBefore(no,host.firstChild);
    var end=document.createElement('div'); end.className='pg-end';
    var html='<span class="num">— Trang '+(i+1)+' / '+total+' —</span>';
    if(i<total-1) html+='<button class="pg-next" data-go="'+(i+1)+'"><span><small>Trang tiếp theo</small>'+titles[i+1]+'</span> ›</button><span class="swipe-hint">hoặc gạt ngang màn hình để lật trang</span>';
    else html+='<button class="pg-next" data-go="0"><span><small>Bạn đã đọc hết sách</small>Quay về bìa</span> ›</button>';
    end.innerHTML=html; host.appendChild(end);
  });
  document.body.classList.add('paged');
  var dots=document.getElementById('pgDots');
  dots.innerHTML=pages.map(function(){return '<i></i>'}).join('');
  var toc=document.getElementById('toc'), links=[].slice.call(toc.querySelectorAll('a[href^="#"]'));
  function pageOf(el){for(var i=0;i<pages.length;i++){if(pages[i]===el||pages[i].contains(el))return i}return -1}
  links.forEach(function(a){var t=document.querySelector(a.getAttribute('href'));var pi=t?pageOf(t):-1;
    if(pi>=0&&a.classList.contains('item')){var s=document.createElement('span');s.className='pgn';s.textContent='tr. '+(pi+1);a.appendChild(s)}});
  var cur=-1, bar=document.getElementById('progress');
  function show(i,dir,anchor){
    i=Math.max(0,Math.min(total-1,i));
    pages.forEach(function(p,k){p.classList.toggle('on',k===i);p.classList.remove('in-r','in-l')});
    if(dir&&cur!==-1&&i!==cur){void pages[i].offsetWidth;pages[i].classList.add(i>cur?'in-r':'in-l')}
    cur=i; store.set('eb-page',String(i));
    document.getElementById('pgNum').textContent='Trang '+(i+1)+' / '+total;
    document.getElementById('pgTitle').textContent=titles[i];
    document.getElementById('pgPrev').disabled=i===0;
    document.getElementById('pgNext').disabled=i===total-1;
    [].forEach.call(dots.children,function(d,k){d.classList.toggle('on',k===i)});
    links.forEach(function(a){var t=document.querySelector(a.getAttribute('href'));a.classList.toggle('active',!!t&&pageOf(t)===i&&a.classList.contains('item'))});
    var id=pages[i].id||(i===0?'top':'');
    if(id&&history.replaceState&&location.protocol!=='about:'){try{history.replaceState(null,'','#'+id)}catch(err){}}
    if(anchor&&anchor!==pages[i]){requestAnimationFrame(function(){anchor.scrollIntoView({block:'start'})})}
    else window.scrollTo(0,0);
    prog();
  }
  function prog(){var d=document.documentElement,max=d.scrollHeight-d.clientHeight,f=max>0?d.scrollTop/max:1;bar.style.width=((cur+f)/total*100)+'%'}
  addEventListener('scroll',prog,{passive:true});
  document.getElementById('pgPrev').addEventListener('click',function(){show(cur-1,true)});
  document.getElementById('pgNext').addEventListener('click',function(){show(cur+1,true)});
  document.addEventListener('click',function(e){
    var b=e.target.closest('.pg-next'); if(b){show(+b.dataset.go,true);return}
    var a=e.target.closest('a[href^="#"]'); if(!a)return;
    var h=a.getAttribute('href'); if(h==='#'||h==='#0')return;
    var t=document.querySelector(h); if(!t)return;
    var pi=pageOf(t); if(pi<0)return;
    e.preventDefault(); show(pi,pi!==cur,t);
  });
  document.addEventListener('keydown',function(e){
    if(/input|textarea|select/i.test((e.target.tagName||''))||e.altKey||e.ctrlKey||e.metaKey)return;
    if(e.key==='ArrowRight'){show(cur+1,true)} else if(e.key==='ArrowLeft'){show(cur-1,true)}
  });
  var sx=0,sy=0,st=0,skip=false;
  document.addEventListener('touchstart',function(e){var t=e.touches[0];sx=t.clientX;sy=t.clientY;st=Date.now();
    skip=!!e.target.closest('pre,.tbl,table,.win-body,.stops,.stack,input,textarea,#toc,.pgbar')},{passive:true});
  document.addEventListener('touchend',function(e){if(skip)return;var t=e.changedTouches[0],dx=t.clientX-sx,dy=t.clientY-sy;
    if(Date.now()-st<700&&Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy)*1.6){show(cur+(dx<0?1:-1),true)}},{passive:true});
  var start=0, hash=null; try{hash=location.hash&&location.hash!=='#top'?document.querySelector(location.hash):null}catch(err){hash=null}
  if(hash&&pageOf(hash)>=0){start=pageOf(hash);show(start,false,hash)}
  else{var sv=parseInt(store.get('eb-page')||'0',10);show(isNaN(sv)?0:sv,false)}
})();
</script>
