      // POST EDIT OR CREATE DIALOG TRIGGER
      const postModal = document.getElementById('post-editor-modal');
      const addPostBtn = document.getElementById('add-post-btn');
      const closeEditorBtn = document.getElementById('close-editor-btn');
      const postForm = document.getElementById('post-form') as HTMLFormElement;
      
      const pTitle = document.getElementById('post-title') as HTMLInputElement;
      const pDesc = document.getElementById('post-description') as HTMLTextAreaElement;
      const pContent = document.getElementById('post-content') as HTMLTextAreaElement;
      const pCat = document.getElementById('post-category') as HTMLSelectElement;
      const pSlug = document.getElementById('post-slug') as HTMLInputElement;
      const pPubDate = document.getElementById('post-pubdate') as HTMLInputElement;
      const pStatus = document.getElementById('post-status') as HTMLSelectElement;
      const pImg = document.getElementById('post-image') as HTMLInputElement | null;
      const pTags = document.getElementById('post-tags') as HTMLInputElement | null;
      const editorTitleText = document.getElementById('editor-title');
      const savePostBtn = document.getElementById('save-post-btn');

      let isEditMode = false;
      let editPostId = '';

      function runRealtimeSEOAnalyzer() {
        try {
          const pKeyword = document.getElementById('post-primary-keyword') as HTMLInputElement;
          const kw = (pKeyword?.value || '').trim().toLowerCase();
          const title = (pTitle?.value || '').trim();
          const desc = (pDesc?.value || '').trim();
          const content = (pContent?.value || '').trim();

          let passedCount = 0;

          const setItem = (id: string, status: 'pass' | 'warn' | 'fail', titleText: string, descText: string) => {
            const el = document.getElementById(id);
            if (!el) return;
            const icon = el.querySelector('.seo-icon');
            const titleEl = el.querySelector('.seo-title');
            const descEl = el.querySelector('.seo-desc');

            if (titleEl) titleEl.textContent = titleText;
            if (descEl) descEl.textContent = descText;

            if (status === 'pass') {
              passedCount++;
              if (icon) {
                icon.textContent = '✓';
                icon.className = 'seo-icon text-emerald-400 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            } else if (status === 'warn') {
              if (icon) {
                icon.textContent = '⚠️';
                icon.className = 'seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            } else {
              if (icon) {
                icon.textContent = '✕';
                icon.className = 'seo-icon text-rose-500 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            }
          };

          // 1. Primary keyword in title
          if (!kw) {
            setItem('seo-item-1', 'fail', 'Từ khóa chính xuất hiện trong tiêu đề', 'Vui lòng nhập từ khóa chính ở trên');
          } else if (title.toLowerCase().includes(kw)) {
            setItem('seo-item-1', 'pass', 'Từ khóa chính xuất hiện trong tiêu đề', `Từ khóa '${kw}' đã có trong tiêu đề`);
          } else {
            setItem('seo-item-1', 'fail', 'Từ khóa chính xuất hiện trong tiêu đề', `Tiêu đề nên chứa từ khóa '${kw}'`);
          }

          // 2. Title length (6-12 words)
          const titleWords = title ? title.split(/\s+/).filter(Boolean).length : 0;
          if (titleWords >= 6 && titleWords <= 12) {
            setItem('seo-item-2', 'pass', `Độ dài tiêu đề tốt (6-12 từ, hiện tại: ${titleWords} từ)`, 'Tiêu đề đạt độ dài lý tưởng');
          } else {
            setItem('seo-item-2', 'warn', `Độ dài tiêu đề tốt (6-12 từ, hiện tại: ${titleWords} từ)`, 'Tiêu đề lý tưởng là từ 6-12 từ');
          }

          // 3. Primary keyword in Sapo
          if (!kw) {
            setItem('seo-item-3', 'fail', 'Từ khóa chính xuất hiện trong Sapo', 'Vui lòng nhập từ khóa chính');
          } else if (desc.toLowerCase().includes(kw)) {
            setItem('seo-item-3', 'pass', 'Từ khóa chính xuất hiện trong Sapo', `Sapo đã chứa từ khóa '${kw}'`);
          } else {
            setItem('seo-item-3', 'fail', 'Từ khóa chính xuất hiện trong Sapo', `Sapo cần chứa từ khóa '${kw}'`);
          }

          // 4. Primary keyword in first 60 chars of Sapo
          if (kw && desc.toLowerCase().indexOf(kw) >= 0 && desc.toLowerCase().indexOf(kw) < 60) {
            setItem('seo-item-4', 'pass', 'Từ khóa nằm trong 60 ký tự đầu Sapo', 'Từ khóa nằm ở vị trí ưu tiên đầu Sapo');
          } else {
            setItem('seo-item-4', 'warn', 'Từ khóa nằm trong 60 ký tự đầu Sapo', 'Đẩy từ khóa lên đầu Sapo giúp AI dễ nhận biết hơn');
          }

          // 5. Sapo length (145-160 chars)
          const descLen = desc.length;
          if (descLen >= 145 && descLen <= 160) {
            setItem('seo-item-5', 'pass', `Độ dài Sapo tối ưu (145-160 ký tự, hiện tại: ${descLen})`, 'Độ dài Sapo đã đạt chuẩn SEO');
          } else {
            setItem('seo-item-5', 'warn', `Độ dài Sapo tối ưu (145-160 ký tự, hiện tại: ${descLen})`, 'Nên điều chỉnh Sapo về khoảng 145-160 ký tự');
          }

          // 6. Sapo contains brand / author
          const brandRegex = /(quảng|đào xuân quảng|daoxuanquang|anna|wepower)/i;
          if (brandRegex.test(desc)) {
            setItem('seo-item-6', 'pass', 'Sapo chứa tên thương hiệu hoặc tác giả', 'Đã có thông tin tác giả/thương hiệu tăng E-E-A-T');
          } else {
            setItem('seo-item-6', 'warn', 'Sapo chứa tên thương hiệu hoặc tác giả', 'Nên chèn tác giả (e.g. Đào Xuân Quảng) tăng E-E-A-T');
          }

          // 7. In-depth content (>= 1500 words)
          const contentWords = content ? content.split(/\s+/).filter(Boolean).length : 0;
          if (contentWords >= 1500) {
            setItem('seo-item-7', 'pass', `Bài viết chuyên sâu (Tối thiểu 1500 từ, hiện tại: ${contentWords} từ)`, 'Đã đạt độ dài chuyên sâu chuẩn v3.0');
          } else {
            setItem('seo-item-7', 'warn', `Bài viết chuyên sâu (Tối thiểu 1500 từ, hiện tại: ${contentWords} từ)`, 'Nên triển khai nội dung chi tiết hơn (đích: 2200-4000 từ)');
          }

          // 8. No forbidden characters (!, ngoặc kép, bold markdown **)
          const forbiddenCharsRegex = /[!"“”]|\*\*/;
          if (!forbiddenCharsRegex.test(content) && !forbiddenCharsRegex.test(title) && !forbiddenCharsRegex.test(desc)) {
            setItem('seo-item-8', 'pass', 'Không có ký tự cấm (!, ngoặc kép, bold markdown **)', 'Nội dung sạch, không vi phạm ký tự cấm');
          } else {
            setItem('seo-item-8', 'fail', 'Có ký tự cấm (!, ngoặc kép, bold markdown **)', 'Vui lòng xóa !, ngoặc kép hoặc markdown **');
          }

          // 9. No forbidden words (cam kết, 100%, tuyệt đối, chắc chắn, thần tốc, tuyệt vời)
          const forbiddenWordsRegex = /(cam kết|100%|tuyệt đối|chắc chắn|thần tốc|tuyệt vời|chữa khỏi|trị dứt điểm)/i;
          if (!forbiddenWordsRegex.test(content) && !forbiddenWordsRegex.test(title) && !forbiddenWordsRegex.test(desc)) {
            setItem('seo-item-9', 'pass', 'Không sử dụng từ ngữ bị cấm (cam kết, 100%, tuyệt đối...)', 'Nội dung không chứa từ ngữ quảng cáo quá đà');
          } else {
            setItem('seo-item-9', 'fail', 'Sử dụng từ ngữ bị cấm (cam kết, 100%, tuyệt đối...)', 'Phát hiện từ ngữ bị cấm trong bài viết');
          }

          // 10. All H2, H3 headings are questions (?)
          const headings = content.match(/<h[23][^>]*>(.*?)<\/h[23]>|#{2,3}\s+(.*)/gi) || [];
          const questionHeadings = headings.filter(h => h.trim().endsWith('?') || h.trim().endsWith('?</span>') || h.includes('?'));
          if (headings.length > 0 && questionHeadings.length === headings.length) {
            setItem('seo-item-10', 'pass', 'Tất cả headings H2, H3 là câu hỏi (?)', '100% headings H2/H3 đã có dấu ?');
          } else {
            setItem('seo-item-10', 'warn', 'Tất cả headings H2, H3 là câu hỏi (?)', 'Bổ sung dấu ? cho tất cả H2, H3');
          }

          // 11. Has Quote-box Featured Snippet
          if (/class=['"]quote-box['"]|quote-box/i.test(content)) {
            setItem('seo-item-11', 'pass', 'Có Quote-box Featured Snippet', 'Đã có Quote-box 40-60 từ tối ưu Featured Snippet');
          } else {
            setItem('seo-item-11', 'warn', 'Có Quote-box Featured Snippet', 'Bổ sung class=\'quote-box\' sau các H2');
          }

          // 12. Internal links count (>= 8 links)
          const linkMatches = content.match(/<a\s+[^>]*href=["'][^"']+["'][^>]*>|\[.*?\]\(.*?\)/gi) || [];
          const internalLinkCount = linkMatches.length;
          if (internalLinkCount >= 8) {
            setItem('seo-item-12', 'pass', `Số lượng internal links (Tối thiểu 8 links, hiện tại: ${internalLinkCount})`, 'Đã đủ 8 internal links phân bổ chuẩn');
          } else {
            setItem('seo-item-12', 'warn', `Số lượng internal links (Tối thiểu 8 links, hiện tại: ${internalLinkCount})`, 'Bổ sung thêm links liên kết');
          }

          // 13. Bold internal links (strong/bold)
          if (/<strong[^>]*>\s*<a|<a[^>]*>\s*<strong|<b>\s*<a|<a[^>]*>\s*<b>|\*\*\[.*?\]\(.*?\)\*\*/i.test(content)) {
            setItem('seo-item-13', 'pass', 'Có internal links được in đậm (strong/bold)', 'Đã bôi đậm internal links cho AI dễ quét');
          } else {
            setItem('seo-item-13', 'warn', 'Có internal links được in đậm (strong/bold)', 'Cần bôi đậm (strong) liên kết để AI dễ quét');
          }

          // Score badge update
          const scoreBadge = document.getElementById('seo-score-badge');
          if (scoreBadge) {
            scoreBadge.textContent = `${passedCount}/13 Tiêu chuẩn`;
            if (passedCount >= 10) {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-xs font-mono font-bold text-emerald-400';
            } else if (passedCount >= 5) {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-xs font-mono font-bold text-amber-400';
            } else {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-rose-500/20 border border-rose-500/40 text-xs font-mono font-bold text-rose-400';
            }
          }
        } catch (err) {
          console.error('Realtime SEO analyzer calculation error:', err);
        }
      }

      function generateVietnameseSlug(str: string): string {
        return str
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .replace(/([^0-9a-z-\s])/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }

      let isSlugManuallyEdited = false;

      if (pSlug) {
        pSlug.addEventListener('input', () => {
          isSlugManuallyEdited = true;
        });
      }

      // Attach event listeners for real-time analysis & auto-slug
      const pKeywordInput = document.getElementById('post-primary-keyword');
      if (pKeywordInput) pKeywordInput.addEventListener('input', runRealtimeSEOAnalyzer);
      
      if (pTitle) {
        pTitle.addEventListener('input', () => {
          if (!isEditMode && !isSlugManuallyEdited && pSlug) {
            pSlug.value = generateVietnameseSlug(pTitle.value);
          }
          runRealtimeSEOAnalyzer();
        });
      }
      if (pDesc) pDesc.addEventListener('input', runRealtimeSEOAnalyzer);
      if (pContent) pContent.addEventListener('input', runRealtimeSEOAnalyzer);

      function toggleCategoryEditorMode() {
        const cat = pCat?.value;
        const keywordRow = document.getElementById('seo-keyword-banner-row');
        const mainEditor = document.getElementById('main-editor-container');
        const seoWidget = document.getElementById('seo-analyzer-widget');
        const contentLabel = document.getElementById('post-content-label');

        if (cat === 'cuoc-song') {
          // Mode Tối giản cho Cuộc sống & Tư duy
          if (keywordRow) keywordRow.classList.add('hidden');
          if (seoWidget) seoWidget.classList.add('hidden');
          if (mainEditor) {
            mainEditor.classList.remove('lg:col-span-7');
            mainEditor.classList.add('lg:col-span-12');
          }
          if (editorTitleText && !isEditMode) editorTitleText.textContent = '☕ Soạn Thảo Bài Viết Cuộc Sống & Tư Duy (Tối Giản)';
          if (contentLabel) contentLabel.textContent = 'NỘI DUNG BÀI VIẾT * (VIẾT TỰ DO - KHÔNG CẦN THẺ HTML)';
          if (pContent) {
            pContent.placeholder = 'Dán hoặc gõ toàn bộ bài viết tâm sự / tư duy của bạn ở đây... (trình bày tự do không cần thẻ HTML, hệ thống sẽ tự động căn chỉnh hiển thị đẹp mắt)!';
          }
        } else {
          // Mode SEO Chuyên sâu cho AI & Digital Marketing
          if (keywordRow) keywordRow.classList.remove('hidden');
          if (seoWidget) seoWidget.classList.remove('hidden');
          if (mainEditor) {
            mainEditor.classList.remove('lg:col-span-12');
            mainEditor.classList.add('lg:col-span-7');
          }
          if (editorTitleText && !isEditMode) editorTitleText.textContent = '✍️ Soạn Thảo Bài Viết Mới Chuẩn SEO v3.0';
          if (contentLabel) contentLabel.textContent = 'NỘI DUNG CHI TIẾT HTML / MARKDOWN *';
          if (pContent) {
            pContent.placeholder = 'Soạn thảo nội dung bài viết HTML / Markdown chuẩn SEO v3.0 ở đây...';
          }
        }
      }

      if (pCat) pCat.addEventListener('change', toggleCategoryEditorMode);

      function resetForm() {
        if (postForm) postForm.reset();
        isEditMode = false;
        isSlugManuallyEdited = false;
        editPostId = '';
        if (editorTitleText) editorTitleText.textContent = '✍️ Soạn Thảo Bài Viết Mới Chuẩn SEO v3.0';
        const now = new Date();
        const nowIso = new Date(now.getTime() - (now.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
        if (pPubDate) pPubDate.value = nowIso;
        if (pStatus) pStatus.value = 'public';
        if (pSlug) pSlug.readOnly = false;
        if (pCat) pCat.disabled = false;
        toggleCategoryEditorMode();
        runRealtimeSEOAnalyzer();
      }

      const handleOpenPostModal = (e?: Event) => {
        if (e) e.preventDefault();
        resetForm();
        if (postModal) {
          postModal.classList.remove('hidden');
          postModal.classList.add('flex');
        }
        document.body.style.overflow = 'hidden';
        setTimeout(() => pTitle?.focus(), 50);
      };

      const handleClosePostModal = () => {
        if (postModal) {
          postModal.classList.add('hidden');
          postModal.classList.remove('flex');
        }
        document.body.style.overflow = 'auto';
        resetForm();
      };

      (window as any).openPostEditorModal = handleOpenPostModal;

      if (addPostBtn) {
        addPostBtn.addEventListener('click', handleOpenPostModal);
      }

      if (closeEditorBtn) {
        closeEditorBtn.addEventListener('click', handleClosePostModal);
      }

      if (postModal) {
        postModal.addEventListener('click', (e) => {
          if (e.target === postModal) {
            handleClosePostModal();
          }
        });
      }

      // Generate markdown string helper


      // Form Submit Handler
      if (postForm) {
        postForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          if (!pTitle.value || !pDesc.value || !pContent.value || !pCat.value || !pSlug.value) {
            showToast('Vui lòng điền đầy đủ các trường bắt buộc (*)!', true);
            return;
          }

          function formatPlainTextToHtml(text: string): string {
            if (!text) return '';
            if (text.trim().startsWith('<')) return text;

            const rawLines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
            return rawLines.map(line => {
              const cleanLine = line.replace(/^[#\-\*]+\s*/, '');
              const hasLetters = /[a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/.test(cleanLine);
              const isAllCaps = hasLetters && cleanLine.length >= 4 && cleanLine.length < 150 && cleanLine === cleanLine.toUpperCase();
              const isHeading = isAllCaps || line.startsWith('#');

              if (isHeading) {
                return `<h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-8 mb-3 leading-snug">${cleanLine}</h2>`;
              }
              return `<p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-6 text-base sm:text-lg">${line}</p>`;
            }).join('\n');
          }

          const tagsArr = pTags?.value ? pTags.value.split(',').map(t => t.trim()).filter(Boolean) : [];
          const formattedBody = formatPlainTextToHtml(pContent.value);

          const payload = {
            title: pTitle.value,
            description: pDesc.value,
            category: pCat.value,
            slug: pSlug.value,
            pubDate: pPubDate.value,
            status: pStatus?.value || 'public',
            tags: tagsArr,
            content: formattedBody,
            author: 'Quang',
            image: pImg?.value || ''
          };

          try {
            if (savePostBtn) savePostBtn.disabled = true;

            // 1. Save to custom_saved_posts in localStorage so it persists 100% in SSG mode
            const customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
            const existingIdx = customPosts.findIndex((p: any) => p.slug === payload.slug || p.id === `${payload.category}/${payload.slug}`);
            const newPostObj = {
              id: `${payload.category}/${payload.slug}`,
              ...payload
            };
            if (existingIdx !== -1) {
              customPosts[existingIdx] = newPostObj;
            } else {
              customPosts.push(newPostObj);
            }
            localStorage.setItem('custom_saved_posts', JSON.stringify(customPosts));

            // 2. Remove from deleted_post_slugs if previously deleted
            let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
            deletedSlugs = deletedSlugs.filter((s: string) => s !== payload.slug && s !== `${payload.category}/${payload.slug}` && s !== payload.title && s !== 'cuoc-song' && s !== 'marketing' && s !== 'ai');
            localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));

            // 3. Safely call backend API if active
            try {
              const res = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const contentType = res.headers.get('content-type') || '';
              if (contentType.includes('application/json')) {
                const result = await res.json();
                if (!result.success) console.warn('API warning:', result.error);
              }
            } catch (apiErr) {
              console.warn('API fetch warning:', apiErr);
            }

            showToast(isEditMode ? 'Bài viết đã cập nhật thành công!' : 'Đã xuất bản bài viết thành công!');
            handleClosePostModal();
            loadAllData();
          } catch (err: any) {
            showToast('Lỗi khi lưu bài viết: ' + err.message, true);
          } finally {
            if (savePostBtn) savePostBtn.disabled = false;
          }
        });
      }

      // Edit & Delete Post click attachments
      function attachPostEvents() {
        // Edit Post
        document.querySelectorAll('.edit-post-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const post = currentPosts.find(p => p.id === id);
            if (!post) return;

            isEditMode = true;
            editPostId = id || '';
            
            if (editorTitleText) editorTitleText.textContent = `✍️ Chỉnh Sửa Bài Viết: ${post.title}`;
            
            pTitle.value = post.title;
            pDesc.value = post.description;
            pContent.value = post.content || '';
            pCat.value = post.category;
            pSlug.value = post.slug;
            let pubVal = post.pubDate || '';
            if (pubVal && !pubVal.includes('T')) {
              pubVal = `${pubVal}T09:00`;
            }
            if (pPubDate) pPubDate.value = pubVal.slice(0, 16);
            if (pStatus) pStatus.value = post.status || (post.draft ? 'private' : 'public');
            if (pImg) pImg.value = post.image || '';
            if (pTags) pTags.value = post.tags ? post.tags.join(', ') : '';

            // Block editing of slug and category in edit mode to prevent file moving/clashing errors
            pSlug.readOnly = true;
            pCat.disabled = true;

            toggleCategoryEditorMode();

            if (postModal) {
              postModal.classList.remove('hidden');
              postModal.classList.add('flex');
            }
            document.body.style.overflow = 'hidden';
            runRealtimeSEOAnalyzer();
            pTitle.focus();
          });
        });

        // Global Delete Post Helper Function
        (window as any).deletePostItem = async (id: string, category: string, slug: string) => {
          if (!slug && !id) return;
          const deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
          if (slug && !deletedSlugs.includes(slug)) deletedSlugs.push(slug);
          if (id && !deletedSlugs.includes(id)) deletedSlugs.push(id);
          localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));

          // Clear from custom_saved_posts as well
          let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
          customPosts = customPosts.filter((p: any) => p.slug !== slug && p.id !== id);
          localStorage.setItem('custom_saved_posts', JSON.stringify(customPosts));

          currentPosts = currentPosts.filter(p => p.slug !== slug && p.id !== id);
          renderPosts();
          updateOverviewStats();
          showToast('Bài viết đã được xóa thành công!');

          try {
            const res = await fetch('/api/posts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', category, slug, title: slug })
            });
            const contentType = res.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
              await res.json();
            }
          } catch (err) {
            console.error('Delete post fetch error:', err);
          }
        };

        // Delete Post Button Listener
        document.querySelectorAll('.delete-post-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const id = btn.getAttribute('data-id') || '';
            const category = btn.getAttribute('data-category') || '';
            const slug = btn.getAttribute('data-slug') || '';
            (window as any).deletePostItem(id, category, slug);
          });
        });
      };

      // ==========================================
      // PRODUCTS MANAGER CONTROLLER
      // ==========================================
      const productModal = document.getElementById('product-editor-modal');
      const addProductBtn = document.getElementById('add-product-btn');
      const closeProductEditorBtn = document.getElementById('close-product-editor-btn');
      const productForm = document.getElementById('product-form') as HTMLFormElement;
      
      const prId = document.getElementById('product-id') as HTMLInputElement;
      const prTitle = document.getElementById('product-title') as HTMLInputElement;
      const prDesc = document.getElementById('product-description') as HTMLTextAreaElement;
      const prType = document.getElementById('product-type') as HTMLInputElement;
      const prStatus = document.getElementById('product-status') as HTMLSelectElement;
      const prPrice = document.getElementById('product-price') as HTMLInputElement;
      const prIcon = document.getElementById('product-icon') as HTMLInputElement;
      const productEditorTitle = document.getElementById('product-editor-title');
      const saveProductBtn = document.getElementById('save-product-btn');

      let isProductEditMode = false;

      function resetProductForm() {
        if (productForm) productForm.reset();
        isProductEditMode = false;
        if (productEditorTitle) productEditorTitle.textContent = '📦 Soạn Thảo Sản Phẩm Mới';
        if (prId) prId.readOnly = false;
      }

      if (addProductBtn) {
        addProductBtn.addEventListener('click', () => {
          resetProductForm();
          if (productModal) productModal.classList.remove('hidden');
          prTitle.focus();
        });
      }

      if (closeProductEditorBtn) {
        closeProductEditorBtn.addEventListener('click', () => {
          if (productModal) productModal.classList.add('hidden');
          resetProductForm();
        });
      }

      function renderProducts() {
        const tbody = document.getElementById('products-table-body');
        if (!tbody) return;

        if (currentProducts.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="5" class="p-8 text-center text-slate-500">Chưa có sản phẩm nào. Bấm nút Thêm sản phẩm mới!</td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = currentProducts.map(prod => {
          const statusBadgeClass = prod.status === 'Đang hoạt động' || prod.status === 'Miễn phí'
            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
            : prod.status === 'Sắp ra mắt'
            ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
            : 'bg-slate-500/10 text-slate-400 border border-slate-500/20';

          return `
            <tr class="hover:bg-slate-900/20 transition-all align-top">
              <td class="p-4 font-bold text-slate-200">
                <span class="text-xl mr-2">${prod.icon || '📦'}</span> ${prod.title}
                <span class="block text-xs font-mono text-slate-500 font-normal">id: ${prod.id}</span>
              </td>
              <td class="p-4 text-xs font-bold text-slate-300 font-mono">${prod.type}</td>
              <td class="p-4 text-xs font-semibold text-slate-200 font-mono">${prod.price || 'Liên hệ'}</td>
              <td class="p-4 text-xs text-slate-300 max-w-sm whitespace-pre-wrap leading-relaxed">${prod.description}</td>
              <td class="p-4">
                <span class="px-2 py-1 rounded text-xs font-bold whitespace-nowrap uppercase tracking-wider ${statusBadgeClass}">
                  ${prod.status}
                </span>
              </td>
              <td class="p-4 text-right">
                <div class="flex gap-2 justify-end">
                  <button data-id="${prod.id}" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold transition-all edit-product-btn cursor-pointer">Sửa</button>
                  <button onclick="window.deleteProductItem && window.deleteProductItem('${prod.id}')" class="px-3 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-400 text-xs font-bold transition-all delete-product-btn cursor-pointer">Xóa</button>
                </div>
              </td>
            </tr>
          `;
        }).join('');

        // Attach product click events
        attachProductEvents();
      }

      function attachProductEvents() {
        // Edit Product click
        document.querySelectorAll('.edit-product-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const prod = currentProducts.find(p => p.id === id);
            if (!prod) return;

            isProductEditMode = true;
            if (productEditorTitle) productEditorTitle.textContent = `📦 Chỉnh Sửa Sản Phẩm: ${prod.title}`;

            prId.value = prod.id;
            prTitle.value = prod.title;
            prDesc.value = prod.description;
            prType.value = prod.type;
            prStatus.value = prod.status;
            prPrice.value = prod.price || 'Liên hệ';
            prIcon.value = prod.icon || '';

            // Block id edit in edit mode
            prId.readOnly = true;

            if (productModal) productModal.classList.remove('hidden');
            prTitle.focus();
            window.scrollTo({ top: productModal.offsetTop - 100, behavior: 'smooth' });
          });
        });

        // Emoji quick selection handler
        document.querySelectorAll('.emoji-select-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const emoji = btn.textContent?.trim() || '';
            if (prIcon) {
              prIcon.value = emoji;
              prIcon.classList.add('border-brand-green', 'bg-brand-green/10');
              setTimeout(() => prIcon.classList.remove('border-brand-green', 'bg-brand-green/10'), 400);
            }
          });
        });

        // Delete Product click
        (window as any).deleteProductItem = async (id: string) => {
          if (!id) return;
          try {
            const deletedIds = JSON.parse(localStorage.getItem('deleted_product_ids') || '[]');
            if (!deletedIds.includes(id)) {
              deletedIds.push(id);
              localStorage.setItem('deleted_product_ids', JSON.stringify(deletedIds));
            }
            currentProducts = currentProducts.filter(p => p.id !== id);
            renderProducts();
            updateOverviewStats();
            showToast('Đã xóa sản phẩm thành công!');

            await fetch('/api/products', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', id })
            });
          } catch (err: any) {
            console.error('Delete product error:', err);
          }
        };

        document.querySelectorAll('.delete-product-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            if (id) (window as any).deleteProductItem(id);
          });
        });
      };

      if (productForm) {
        productForm.addEventListener('submit', async (e) => {
          e.preventDefault();

          if (!prId.value || !prTitle.value || !prDesc.value || !prType.value || !prStatus.value || !prPrice.value || !prIcon.value) {
            showToast('Vui lòng điền đầy đủ các trường bắt buộc (*)!', true);
            return;
          }

          const payload = {
            id: prId.value,
            title: prTitle.value,
            description: prDesc.value,
            type: prType.value,
            status: prStatus.value,
            price: prPrice.value,
            icon: prIcon.value
          };

          try {
            if (saveProductBtn) saveProductBtn.disabled = true;
            const res = await fetch('/api/products', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
              showToast('Lưu thông tin sản phẩm thành công!');
              if (productModal) productModal.classList.add('hidden');
              resetProductForm();
              loadAllData();
            } else {
              showToast(result.error || 'Lỗi khi lưu sản phẩm', true);
            }
          } catch (err: any) {
            showToast(err.message, true);
          } finally {
            if (saveProductBtn) saveProductBtn.disabled = false;
          }
        });
      }

      // Start auth check
      checkAuth();
    };

    // Run immediately since Astro modules are deferred
    initAdmin();
    
    // Support ViewTransitions if added later
    document.addEventListener('astro:page-load', initAdmin);
  </script>
</Layout>
