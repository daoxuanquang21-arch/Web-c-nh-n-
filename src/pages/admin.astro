  <script>
    // Config login password hash (SHA-256 of 'admin123')
    const PASS_HASH = '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9';

    async function sha256(message: string): Promise<string> {
      try {
        if (typeof window !== 'undefined' && window.crypto && window.crypto.subtle) {
          const msgBuffer = new TextEncoder().encode(message);
          const hashBuffer = await window.crypto.subtle.digest('SHA-256', msgBuffer);
          const hashArray = Array.from(new Uint8Array(hashBuffer));
          return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        }
      } catch (e) {
        console.warn('Crypto subtle unavailable:', e);
      }
      return '';
    }

    const initAdmin = () => {
      const lockscreen = document.getElementById('lockscreen');
      const dashboard = document.getElementById('dashboard');
      const loginForm = document.getElementById('login-form');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('logout-btn');
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toast-message');
      const toastIcon = document.getElementById('toast-icon');

      // Toast utility function
      function showToast(message: string, isError = false) {
        if (!toast || !toastMessage || !toastIcon) return;
        toastMessage.textContent = message;
        toastIcon.textContent = isError ? '⚠️' : '✓';
        toast.className = `fixed bottom-6 left-6 z-[200] bg-slate-900 border ${isError ? 'border-rose-800 text-rose-200' : 'border-emerald-800 text-emerald-200'} text-sm px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 translate-y-0 opacity-100`;
        
        setTimeout(() => {
          toast.className = `fixed bottom-6 left-6 z-[200] transform translate-y-20 opacity-0 bg-slate-900 border border-slate-800 text-slate-100 text-sm px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 pointer-events-none`;
        }, 3000);
      }

      // Auth validation
      function checkAuth() {
        const token = localStorage.getItem('admin_auth_token');
        if (token === PASS_HASH || token === 'admin123') {
          if (lockscreen) lockscreen.classList.add('hidden');
          if (dashboard) dashboard.classList.remove('hidden');
          loadAllData();
        } else {
          if (lockscreen) lockscreen.classList.remove('hidden');
          if (dashboard) dashboard.classList.add('hidden');
        }
      }

      // Login form handling
      if (loginForm) {
        loginForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!passwordInput) return;
          const pass = passwordInput.value.trim();
          let hash = '';
          try {
            hash = await sha256(pass);
          } catch (err) {
            console.warn(err);
          }
          if (pass === 'admin123' || hash === PASS_HASH) {
            localStorage.setItem('admin_auth_token', PASS_HASH);
            if (loginError) loginError.classList.add('hidden');
            checkAuth();
            showToast('Đăng nhập quản trị an toàn thành công!');
          } else {
            if (loginError) loginError.classList.remove('hidden');
            passwordInput.focus();
            passwordInput.value = '';
          }
        });
      }

      // Logout handler
      const logoutBtnMobile = document.getElementById('logout-btn-mobile');
      const handleLogout = () => {
        localStorage.removeItem('admin_auth_token');
        checkAuth();
        showToast('Đã đăng xuất khỏi hệ thống!');
      };
      if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
      if (logoutBtnMobile) logoutBtnMobile.addEventListener('click', handleLogout);

