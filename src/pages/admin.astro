      // Heading Standardization & Live Preview Engine
      function standardizeArticleHeadings(text: string): string {
        if (!text) return '';
        const lines = text.split(/\r?\n/);
        const formatted = lines.map(line => {
          const trimmed = line.trim();
          if (!trimmed) return '';
          
          // Already properly marked H2 or H3
          if (/^##\s+/.test(trimmed) || /^###\s+/.test(trimmed)) {
            return trimmed;
          }
          if (/^#\s+/.test(trimmed)) {
            return `## ${trimmed.replace(/^#+\s*/, '')}`;
          }

          // Check blockquote
          if (/^>/.test(trimmed)) return trimmed;
          if (/^[“"'][\s\S]+[”"']$/.test(trimmed) && trimmed.length < 220 && !trimmed.includes('\n')) {
            return `> ${trimmed.replace(/^[“"']|[”"']$/g, '')}`;
          }

          // Check list items
          if (/^[\-\*\+•]\s+/.test(trimmed)) {
            return `- ${trimmed.replace(/^[\-\*\+•]\s+/, '')}`;
          }

          const cleanLine = trimmed.replace(/^[#\-\*•\+]\s*/, '');
          const hasLetters = /[a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/.test(cleanLine);
          const lastChar = cleanLine.slice(-1);
          const isPunctuationEnd = ['.', ',', ';', '?', '!'].includes(lastChar);
          
          // Pattern detection for H3 (Sub-methods, steps, tips, branches, etc.)
          const isH3Pattern = /^(phương pháp|bước|cách|gợi ý|lưu ý|bí quyết|mẹo|ví dụ|\d+\.\d+)\s*\d*[:\.]/i.test(cleanLine);
          
          // Pattern detection for H2 (Major numbered sections, summary, conclusions, Roman numerals)
          const isH2Explicit = /^(bài này dành cho|\d+\.|\d+\/|phần \d+|chương \d+|mục \d+|[IVXLCDM]+\.|\d+\s*[-–—]|tóm lại|kết luận|cái bẫy|nguyên nhân|giải pháp|tổng kết|đúc kết|lời khuyên)/i.test(cleanLine);
          const isShortHeadingLine = hasLetters && cleanLine.length >= 4 && cleanLine.length <= 110 && !isPunctuationEnd && !line.includes('http') && !line.includes('://');
          const isAllCaps = hasLetters && cleanLine.length >= 4 && cleanLine.length < 120 && cleanLine === cleanLine.toUpperCase();

          if (isH3Pattern) {
            return `### ${cleanLine}`;
          }
          if (isH2Explicit || isAllCaps || (isShortHeadingLine && !line.startsWith('*') && !line.startsWith('-') && !line.startsWith('>'))) {
            return `## ${cleanLine}`;
          }
          return line;
        });
        return formatted.join('\n');
      }

      function renderMarkdownToHtml(md: string): string {
        if (!md) return '<p class="text-slate-500 italic">Chưa có nội dung để xem trước...</p>';
        const lines = md.split(/\r?\n/);
        let inList = false;
        let htmlParts: string[] = [];

        lines.forEach(line => {
          const trimmed = line.trim();
          if (!trimmed) {
            if (inList) {
              htmlParts.push('</ul>');
              inList = false;
            }
            return;
          }

          if (trimmed.startsWith('### ')) {
            if (inList) { htmlParts.push('</ul>'); inList = false; }
            const hText = trimmed.substring(4);
            htmlParts.push(`<h3 class="text-lg sm:text-xl font-bold text-emerald-400 mt-6 mb-2 pl-3 border-l-4 border-emerald-500">${hText}</h3>`);
          } else if (trimmed.startsWith('## ')) {
            if (inList) { htmlParts.push('</ul>'); inList = false; }
            const hText = trimmed.substring(3);
            htmlParts.push(`<h2 class="text-xl sm:text-2xl font-extrabold text-blue-400 mt-8 mb-3 pb-2 border-b-2 border-slate-800">${hText}</h2>`);
          } else if (trimmed.startsWith('> ')) {
            if (inList) { htmlParts.push('</ul>'); inList = false; }
            const qText = trimmed.substring(2);
            htmlParts.push(`<blockquote class="border-l-4 border-emerald-500/80 bg-emerald-950/20 p-4 rounded-r-xl my-4 italic text-slate-300">${qText}</blockquote>`);
          } else if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
            if (!inList) {
              htmlParts.push('<ul class="list-disc pl-6 space-y-1.5 my-3 text-slate-300">');
              inList = true;
            }
            const lText = trimmed.substring(2);
            htmlParts.push(`<li>${lText}</li>`);
          } else {
            if (inList) { htmlParts.push('</ul>'); inList = false; }
            // Bold text conversion **text**
            const pFormatted = trimmed.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-white">$1</strong>');
            htmlParts.push(`<p class="text-slate-300 leading-relaxed mb-4 text-sm sm:text-base">${pFormatted}</p>`);
          }
        });

        if (inList) htmlParts.push('</ul>');
        return htmlParts.join('\n');
      }

      // Toolbar Actions Setup
      const btnFmtH2 = document.getElementById('btn-fmt-h2');
      const btnFmtH3 = document.getElementById('btn-fmt-h3');
      const btnFmtQuote = document.getElementById('btn-fmt-quote');
      const btnFmtList = document.getElementById('btn-fmt-list');
      const btnAutoHeading = document.getElementById('btn-auto-heading');
      const btnPreviewContent = document.getElementById('btn-preview-content');
      const previewPane = document.getElementById('content-preview-pane');
      const previewBtnText = document.getElementById('preview-btn-text');

      function insertPrefixAtCursor(prefix: string) {
        if (!pContent) return;
        const start = pContent.selectionStart;
        const end = pContent.selectionEnd;
        const val = pContent.value;
        
        if (start !== end) {
          const selected = val.substring(start, end);
          const replaced = prefix + selected;
          pContent.value = val.substring(0, start) + replaced + val.substring(end);
        } else {
          pContent.value = val.substring(0, start) + prefix + val.substring(end);
        }
        pContent.focus();
        runRealtimeSEOAnalyzer();
      }

      if (btnFmtH2) btnFmtH2.addEventListener('click', () => insertPrefixAtCursor('\n## '));
      if (btnFmtH3) btnFmtH3.addEventListener('click', () => insertPrefixAtCursor('\n### '));
      if (btnFmtQuote) btnFmtQuote.addEventListener('click', () => insertPrefixAtCursor('\n> '));
      if (btnFmtList) btnFmtList.addEventListener('click', () => insertPrefixAtCursor('\n- '));

      if (btnAutoHeading) {
        btnAutoHeading.addEventListener('click', () => {
          if (!pContent || !pContent.value.trim()) {
            showToast('Chưa có nội dung để chuẩn hóa!', true);
            return;
          }
          pContent.value = standardizeArticleHeadings(pContent.value);
          runRealtimeSEOAnalyzer();
          showToast('⚡ Đã tự động phân loại Heading (H2 Navy / H3 Xanh Lá) chuẩn đồng bộ!');
        });
      }

      // AUTOMATIC PASTE & BLUR HEADING SEPARATION LISTENER
      if (pContent) {
        pContent.addEventListener('paste', () => {
          setTimeout(() => {
            if (!pContent.value.trim()) return;
            const formatted = standardizeArticleHeadings(pContent.value);
            if (formatted !== pContent.value) {
              pContent.value = formatted;
              runRealtimeSEOAnalyzer();
              showToast('⚡ Đã tự động phân chia Heading H2 (Xanh Navy) & H3 (Xanh Lá) đồng bộ 100%!');
            }
          }, 80);
        });

        pContent.addEventListener('blur', () => {
          if (!pContent.value.trim()) return;
          const formatted = standardizeArticleHeadings(pContent.value);
          if (formatted !== pContent.value) {
            pContent.value = formatted;
            runRealtimeSEOAnalyzer();
          }
        });
      }

      let isPreviewing = false;
      if (btnPreviewContent && previewPane && pContent) {
        btnPreviewContent.addEventListener('click', () => {
          isPreviewing = !isPreviewing;
          if (isPreviewing) {
            previewPane.innerHTML = renderMarkdownToHtml(pContent.value);
            pContent.classList.add('hidden');
            previewPane.classList.remove('hidden');
            if (previewBtnText) previewBtnText.textContent = '✏️ Quay lại sửa';
            btnPreviewContent.classList.add('bg-brand-green/20', 'text-brand-green', 'border-brand-green/40');
            btnPreviewContent.classList.remove('bg-slate-900', 'text-slate-300');
          } else {
            previewPane.classList.add('hidden');
            pContent.classList.remove('hidden');
            if (previewBtnText) previewBtnText.textContent = '👁️ Xem trước hiển thị';
            btnPreviewContent.classList.remove('bg-brand-green/20', 'text-brand-green', 'border-brand-green/40');
            btnPreviewContent.classList.add('bg-slate-900', 'text-slate-300');
            pContent.focus();
          }
        });
      }

      // Form Submit Handler
      if (postForm) {
        postForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          if (!pTitle.value || !pDesc.value || !pContent.value || !pCat.value || !pSlug.value) {
            showToast('Vui lòng điền đầy đủ các trường bắt buộc (*)!', true);
            return;
          }

          // Auto-standardize headings before saving
          const formattedBody = standardizeArticleHeadings(pContent.value);
          pContent.value = formattedBody;

          const tagsArr = pTags?.value ? pTags.value.split(',').map(t => t.trim()).filter(Boolean) : [];

          const payload = {
            title: pTitle.value,
            description: pDesc.value,
            category: pCat.value,
            slug: pSlug.value,
            originalSlug: pSlug.dataset.originalSlug || '',
            originalCategory: pCat.dataset.originalCategory || '',
            pubDate: pPubDate.value,
            status: pStatus?.value || 'public',
            tags: tagsArr,
            content: formattedBody,
            author: 'Quang',
            image: pImg?.value || ''
          };

          try {
            if (savePostBtn) savePostBtn.disabled = true;

            // 1. Save to custom_saved_posts in localStorage so it persists 100% in SSG mode
            const customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
            
            // Clean up old slug record if slug or category was edited
            const origSlug = pSlug.dataset.originalSlug;
            const origCat = pCat.dataset.originalCategory;
            if (origSlug && origCat && (origSlug !== payload.slug || origCat !== payload.category)) {
              const oldIdx = customPosts.findIndex((p: any) => p.slug === origSlug && p.category === origCat);
              if (oldIdx !== -1) customPosts.splice(oldIdx, 1);
              
              let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
              if (!deletedSlugs.includes(origSlug)) deletedSlugs.push(origSlug);
              if (!deletedSlugs.includes(`${origCat}/${origSlug}`)) deletedSlugs.push(`${origCat}/${origSlug}`);
              localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));
            }

            const existingIdx = customPosts.findIndex((p: any) => p.slug === payload.slug || p.id === `${payload.category}/${payload.slug}`);
            const newPostObj = {
              id: `${payload.category}/${payload.slug}`,
              ...payload
            };
            if (existingIdx !== -1) {
              customPosts[existingIdx] = newPostObj;
            } else {
              customPosts.push(newPostObj);
            }
            localStorage.setItem('custom_saved_posts', JSON.stringify(customPosts));

            // 2. Remove from deleted_post_slugs if previously deleted
            let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
            deletedSlugs = deletedSlugs.filter((s: string) => s !== payload.slug && s !== `${payload.category}/${payload.slug}` && s !== payload.title && s !== 'cuoc-song' && s !== 'marketing' && s !== 'ai');
            localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));

            // 3. Safely call backend API if active
            try {
              const res = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              const contentType = res.headers.get('content-type') || '';
              if (contentType.includes('application/json')) {
                const result = await res.json();
                if (!result.success) console.warn('API warning:', result.error);
              }
            } catch (apiErr) {
              console.warn('API fetch warning:', apiErr);
            }

            showToast(isEditMode ? 'Bài viết đã cập nhật thành công!' : 'Đã xuất bản bài viết thành công!');
            handleClosePostModal();
            loadAllData();
          } catch (err: any) {
            showToast('Lỗi khi lưu bài viết: ' + err.message, true);
          } finally {
            if (savePostBtn) savePostBtn.disabled = false;
          }
        });
      }

      // Edit & Delete Post click attachments
      function attachPostEvents() {
        // Edit Post
        document.querySelectorAll('.edit-post-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const post = currentPosts.find(p => p.id === id);
            if (!post) return;

            isEditMode = true;
            editPostId = id || '';
            
            if (editorTitleText) editorTitleText.textContent = `✍️ Chỉnh Sửa Bài Viết: ${post.title}`;
            
            pTitle.value = post.title;
            pDesc.value = post.description;
            pContent.value = post.content || '';
            pCat.value = post.category;
            pSlug.value = post.slug;
            let pubVal = post.pubDate || '';
            if (pubVal && !pubVal.includes('T')) {
              pubVal = `${pubVal}T09:00`;
            }
            if (pPubDate) pPubDate.value = pubVal.slice(0, 16);
            if (pStatus) pStatus.value = post.status || (post.draft ? 'private' : 'public');
            if (pImg) pImg.value = post.image || '';
            if (pTags) pTags.value = post.tags ? post.tags.join(', ') : '';

            // Set datasets to track original slug/category for file renaming on the server
            pSlug.dataset.originalSlug = post.slug;
            pCat.dataset.originalCategory = post.category;

            pSlug.readOnly = false;
            pCat.disabled = false;

            toggleCategoryEditorMode();

            if (postModal) {
              postModal.classList.remove('hidden');
              postModal.classList.add('flex');
            }
            document.body.style.overflow = 'hidden';
            runRealtimeSEOAnalyzer();
            pTitle.focus();
          });
        });

        // Global Delete Post Helper Function
        (window as any).deletePostItem = async (id: string, category: string, slug: string) => {
          if (!slug && !id) return;
          const deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
          if (slug && !deletedSlugs.includes(slug)) deletedSlugs.push(slug);
          if (id && !deletedSlugs.includes(id)) deletedSlugs.push(id);
          localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));

          // Clear from custom_saved_posts as well
          let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
          customPosts = customPosts.filter((p: any) => p.slug !== slug && p.id !== id);
          localStorage.setItem('custom_saved_posts', JSON.stringify(customPosts));

          currentPosts = currentPosts.filter(p => p.slug !== slug && p.id !== id);
          renderPosts();
          updateOverviewStats();
          showToast('Bài viết đã được xóa thành công!');

          try {
            const res = await fetch('/api/posts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', category, slug, title: slug })
            });
            const contentType = res.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
              await res.json();
            }
          } catch (err) {
            console.error('Delete post fetch error:', err);
          }
        };

        // Delete Post Button Listener
        document.querySelectorAll('.delete-post-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const id = btn.getAttribute('data-id') || '';
            const category = btn.getAttribute('data-category') || '';
            const slug = btn.getAttribute('data-slug') || '';
            (window as any).deletePostItem(id, category, slug);
          });
        });
      };

      // ==========================================
      // PRODUCTS MANAGER CONTROLLER (ENHANCED)
      // ==========================================
      const productModal = document.getElementById('product-editor-modal');
      const addProductBtn = document.getElementById('add-product-btn');
      const closeProductEditorBtn = document.getElementById('close-product-editor-btn');
      const cancelProductBtn = document.getElementById('cancel-product-btn');
      const productForm = document.getElementById('product-form') as HTMLFormElement;
      const productSearchInput = document.getElementById('product-search-input') as HTMLInputElement;
      const productTypeFilter = document.getElementById('product-type-filter') as HTMLSelectElement;
      
      const prId = document.getElementById('product-id') as HTMLInputElement;
      const prTitle = document.getElementById('product-title') as HTMLInputElement;
      const prDesc = document.getElementById('product-description') as HTMLTextAreaElement;
      const prType = document.getElementById('product-type') as HTMLInputElement;
      const prStatus = document.getElementById('product-status') as HTMLSelectElement;
      const prPrice = document.getElementById('product-price') as HTMLInputElement;
      const prIcon = document.getElementById('product-icon') as HTMLInputElement;
      const prImage = document.getElementById('product-image') as HTMLInputElement;
      const prLink = document.getElementById('product-link') as HTMLInputElement;
      const productEditorTitle = document.getElementById('product-editor-title');
      const saveProductBtn = document.getElementById('save-product-btn') as HTMLButtonElement;
      const btnAutoSlug = document.getElementById('btn-auto-slug');
      const btnClearImg = document.getElementById('btn-clear-img');

      // Live Preview Elements
      const previewTitle = document.getElementById('preview-card-title');
      const previewDesc = document.getElementById('preview-card-desc');
      const previewType = document.getElementById('preview-card-type');
      const previewPrice = document.getElementById('preview-card-price');
      const previewIcon = document.getElementById('preview-card-icon');
      const previewStatus = document.getElementById('preview-card-status');
      const previewImg = document.getElementById('preview-card-img') as HTMLImageElement;
      const previewImgPlaceholder = document.getElementById('preview-card-img-placeholder');
      const previewBtn = document.getElementById('preview-card-btn');
      const selectedIconPreview = document.getElementById('selected-icon-preview');

      let isProductEditMode = false;

      function generateSlug(str: string): string {
        return str
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }

      function updateLivePreview() {
        const title = prTitle?.value.trim() || 'Tiêu đề sản phẩm';
        const desc = prDesc?.value.trim() || 'Mô tả ngắn gọn về sản phẩm sẽ hiển thị tại đây...';
        const type = prType?.value.trim() || 'Ebook';
        const price = prPrice?.value.trim() || '299.000đ';
        const status = prStatus?.value.trim() || '';
        const icon = prIcon?.value.trim() || '📘';
        const imgUrl = prImage?.value.trim() || '';
        const linkUrl = prLink?.value.trim() || '';

        if (previewTitle) previewTitle.textContent = title;
        if (previewDesc) previewDesc.textContent = desc;
        if (previewType) previewType.textContent = type;
        if (previewPrice) previewPrice.textContent = price;
        if (previewIcon) previewIcon.textContent = icon;
        if (selectedIconPreview) selectedIconPreview.textContent = icon;

        if (previewStatus) {
          if (status) {
            previewStatus.textContent = status;
            previewStatus.classList.remove('hidden');
            if (status === 'Sắp ra mắt') {
              previewStatus.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30';
            } else if (status === 'Nội bộ') {
              previewStatus.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-500/20 text-slate-300 border border-slate-500/30';
            } else if (status === 'Miễn phí') {
              previewStatus.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30';
            } else {
              previewStatus.className = 'text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
            }
          } else {
            previewStatus.classList.add('hidden');
          }
        }

        if (previewImg && previewImgPlaceholder) {
          if (imgUrl) {
            previewImg.src = imgUrl;
            previewImg.classList.remove('hidden');
            previewImgPlaceholder.classList.add('hidden');
          } else {
            previewImg.classList.add('hidden');
            previewImgPlaceholder.classList.remove('hidden');
          }
        }

        if (previewBtn) {
          if (linkUrl) {
            previewBtn.textContent = 'Xem thêm →';
          } else if (status === 'Sắp ra mắt') {
            previewBtn.textContent = 'Xem thêm';
          } else if (status === 'Nội bộ') {
            previewBtn.textContent = 'Chỉ dùng nội bộ';
          } else {
            previewBtn.textContent = 'Nhắn tin Zalo tư vấn';
          }
        }
      }

      // Live sync listeners
      [prTitle, prDesc, prType, prPrice, prStatus, prIcon, prImage, prLink].forEach(el => {
        if (el) {
          el.addEventListener('input', updateLivePreview);
          el.addEventListener('change', updateLivePreview);
        }
      });

      // Auto-slug button
      if (btnAutoSlug) {
        btnAutoSlug.addEventListener('click', () => {
          if (prTitle.value.trim() && !isProductEditMode) {
            prId.value = generateSlug(prTitle.value.trim());
          }
        });
      }

      // Title auto-slug when typing new product
      if (prTitle) {
        prTitle.addEventListener('input', () => {
          if (!isProductEditMode && (!prId.value || prId.dataset.autoSlug === 'true')) {
            prId.value = generateSlug(prTitle.value);
            prId.dataset.autoSlug = 'true';
          }
        });
      }
      if (prId) {
        prId.addEventListener('input', () => {
          prId.dataset.autoSlug = 'false';
        });
      }

      // Clear image button
      if (btnClearImg) {
        btnClearImg.addEventListener('click', () => {
          if (prImage) {
            prImage.value = '';
            updateLivePreview();
          }
        });
      }

      // Quick Type buttons
      document.querySelectorAll('.quick-type-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (prType) {
            prType.value = btn.textContent?.trim() || '';
            updateLivePreview();
          }
        });
      });

      // Quick Price buttons
      document.querySelectorAll('.quick-price-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          if (prPrice) {
            prPrice.value = btn.textContent?.trim() || '';
            updateLivePreview();
          }
        });
      });

      // Quick Image buttons
      document.querySelectorAll('.quick-img-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const img = btn.getAttribute('data-img');
          if (prImage && img) {
            prImage.value = img;
            updateLivePreview();
          }
        });
      });

      // Emoji picker
      document.querySelectorAll('.emoji-select-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const emoji = btn.textContent?.trim() || '';
          if (prIcon) {
            prIcon.value = emoji;
            updateLivePreview();
          }
        });
      });

      function resetProductForm() {
        if (productForm) productForm.reset();
        isProductEditMode = false;
        if (productEditorTitle) productEditorTitle.textContent = '📦 Soạn Thảo Sản Phẩm Mới';
        if (prId) {
          prId.readOnly = false;
          prId.dataset.autoSlug = 'true';
        }
        if (prImage) prImage.value = '';
        if (prIcon) prIcon.value = '📘';
        if (prType) prType.value = 'Ebook';
        if (prPrice) prPrice.value = '299.000đ';
        updateLivePreview();
      }

      function openProductModal(isEdit = false, prod: any = null) {
        if (!productModal) return;
        isProductEditMode = isEdit;
        if (isEdit && prod) {
          if (productEditorTitle) productEditorTitle.textContent = `📦 Chỉnh Sửa Sản Phẩm: ${prod.title}`;
          prId.value = prod.id || '';
          prId.readOnly = true;
          prTitle.value = prod.title || '';
          prDesc.value = prod.description || '';
          prType.value = prod.type || 'Ebook';
          prStatus.value = prod.status || '';
          prPrice.value = prod.price || '';
          prIcon.value = prod.icon || '📘';
          prImage.value = prod.image || '';
          prLink.value = prod.link || (prod.id === 'ebook-tao-blog' ? '/ebook-tao-blog' : '');
        } else {
          resetProductForm();
        }
        updateLivePreview();
        productModal.classList.remove('hidden');
        productModal.classList.add('flex');
        prTitle.focus();
      }

      function closeProductModal() {
        if (!productModal) return;
        productModal.classList.add('hidden');
        productModal.classList.remove('flex');
        resetProductForm();
      }

      if (addProductBtn) {
        addProductBtn.addEventListener('click', () => openProductModal(false));
      }
      if (closeProductEditorBtn) {
        closeProductEditorBtn.addEventListener('click', closeProductModal);
      }
      if (cancelProductBtn) {
        cancelProductBtn.addEventListener('click', closeProductModal);
      }

      // Filter & Search handler
      function getFilteredProducts() {
        const q = (productSearchInput?.value || '').toLowerCase().trim();
        const typeFilter = productTypeFilter?.value || 'all';

        let list = [...currentProducts];
        if (q) {
          list = list.filter(p => 
            (p.title || '').toLowerCase().includes(q) || 
            (p.id || '').toLowerCase().includes(q) ||
            (p.description || '').toLowerCase().includes(q)
          );
        }
        if (typeFilter !== 'all') {
          list = list.filter(p => (p.type || '').toLowerCase() === typeFilter.toLowerCase());
        }
        return list;
      }

      if (productSearchInput) {
        productSearchInput.addEventListener('input', () => renderProducts());
      }
      if (productTypeFilter) {
        productTypeFilter.addEventListener('change', () => renderProducts());
      }

      function renderProducts() {
        const tbody = document.getElementById('products-table-body');
        if (!tbody) return;

        const displayList = getFilteredProducts();

        if (displayList.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-500">
                ${currentProducts.length === 0 
                  ? 'Chưa có sản phẩm nào. Bấm nút "Thêm Sản Phẩm Mới" để bắt đầu!' 
                  : 'Không tìm thấy sản phẩm phù hợp với bộ lọc tìm kiếm.'}
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = displayList.map(prod => {
          const statusBadgeClass = prod.status === 'Đang bán' || prod.status === 'Đang hoạt động'
            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
            : prod.status === 'Sắp ra mắt'
            ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
            : prod.status === 'Miễn phí'
            ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
            : prod.status === 'Nội bộ'
            ? 'bg-slate-500/10 text-slate-400 border border-slate-500/20'
            : 'text-slate-500 border border-slate-800';

          return `
            <tr class="hover:bg-slate-900/40 transition-all align-top">
              <!-- Cột 1: Icon & Tên -->
              <td class="p-4 font-bold text-slate-200">
                <div class="flex items-start gap-3">
                  ${prod.image 
                    ? `<img src="${prod.image}" alt="${prod.title}" class="w-12 h-10 rounded-lg object-cover bg-slate-800 border border-slate-700 shrink-0" />` 
                    : `<span class="text-2xl p-1 bg-slate-800 rounded-lg shrink-0">${prod.icon || '📦'}</span>`
                  }
                  <div class="min-w-0">
                    <span class="text-sm font-bold text-white block leading-snug">${prod.title}</span>
                    <span class="block text-[11px] font-mono text-emerald-400 mt-0.5">id: ${prod.id}</span>
                  </div>
                </div>
              </td>

              <!-- Cột 2: Phân loại -->
              <td class="p-4 text-xs font-semibold text-slate-300">
                <span class="px-2 py-1 rounded bg-slate-800 border border-slate-700/60 font-mono">${prod.type || 'Ebook'}</span>
              </td>

              <!-- Cột 3: Giá bán -->
              <td class="p-4 text-xs font-bold text-emerald-400 font-mono whitespace-nowrap">
                ${prod.price || 'Liên hệ'}
              </td>

              <!-- Cột 4: Link đích -->
              <td class="p-4 text-xs">
                ${prod.link 
                  ? `<a href="${prod.link}" target="_blank" class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300 font-mono hover:underline max-w-[120px] truncate" title="${prod.link}">
                      🔗 ${prod.link}
                    </a>`
                  : `<span class="text-slate-500 text-[11px] italic">Zalo tư vấn</span>`
                }
              </td>

              <!-- Cột 5: Mô tả -->
              <td class="p-4 text-xs text-slate-400 max-w-xs leading-relaxed">
                <span class="line-clamp-2" title="${prod.description}">${prod.description || '—'}</span>
              </td>

              <!-- Cột 6: Trạng thái -->
              <td class="p-4">
                ${prod.status 
                  ? `<span class="px-2.5 py-1 rounded text-[11px] font-bold whitespace-nowrap uppercase tracking-wider ${statusBadgeClass}">
                      ${prod.status}
                    </span>`
                  : `<span class="text-slate-500 text-xs">—</span>`
                }
              </td>

              <!-- Cột 7: Thao tác -->
              <td class="p-4 text-right">
                <div class="flex items-center gap-1.5 justify-end">
                  <button data-id="${prod.id}" class="edit-product-btn px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-bold transition-all cursor-pointer flex items-center gap-1">
                    ✏️ Sửa
                  </button>
                  ${prod.link 
                    ? `<a href="${prod.link}" target="_blank" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold transition-all cursor-pointer">
                        👁️
                      </a>`
                    : ''
                  }
                  <button data-id="${prod.id}" data-title="${prod.title}" class="delete-product-btn px-2.5 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-400 text-xs font-bold transition-all cursor-pointer">
                    🗑️
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');

        attachProductEvents();
      }

      function attachProductEvents() {
        // Edit button
        document.querySelectorAll('.edit-product-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const prod = currentProducts.find(p => p.id === id);
            if (prod) openProductModal(true, prod);
          });
        });

        // Delete button
        document.querySelectorAll('.delete-product-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const title = btn.getAttribute('data-title') || id;
            if (!id) return;

            const confirmed = window.confirm(`Bạn có chắc chắn muốn xóa sản phẩm "${title}" không?\nThao tác này sẽ gỡ sản phẩm khỏi trang /san-pham.`);
            if (!confirmed) return;

            try {
              const res = await fetch('/api/products', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'delete', id })
              });
              const result = await res.json();
              if (result.success) {
                currentProducts = currentProducts.filter(p => p.id !== id);
                renderProducts();
                updateOverviewStats();
                showToast(`Đã xóa sản phẩm "${title}" thành công!`);
              } else {
                showToast(result.error || 'Lỗi khi xóa sản phẩm', true);
              }
            } catch (err: any) {
              showToast('Lỗi kết nối máy chủ: ' + err.message, true);
            }
          });
        });
      }

      // Save product submission
      if (productForm) {
        productForm.addEventListener('submit', async (e) => {
          e.preventDefault();

          const idVal = prId.value.trim();
          const titleVal = prTitle.value.trim();
          const descVal = prDesc.value.trim();

          if (!idVal || !titleVal) {
            showToast('Vui lòng nhập Tên sản phẩm và Mã định danh (ID)!', true);
            return;
          }

          const payload = {
            id: idVal,
            title: titleVal,
            description: descVal,
            type: prType.value.trim() || 'Ebook',
            status: prStatus.value.trim(),
            price: prPrice.value.trim() || 'Liên hệ',
            icon: prIcon.value.trim() || '📦',
            image: prImage.value.trim(),
            link: prLink.value.trim() || (idVal === 'ebook-tao-blog' ? '/ebook-tao-blog' : '')
          };

          try {
            if (saveProductBtn) saveProductBtn.disabled = true;
            const res = await fetch('/api/products', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
              showToast(isProductEditMode ? 'Cập nhật sản phẩm thành công!' : 'Tạo sản phẩm mới thành công!');
              closeProductModal();
              // Refresh data
              loadAllData();
            } else {
              showToast(result.error || 'Lỗi khi lưu sản phẩm', true);
            }
          } catch (err: any) {
            showToast(err.message || 'Lỗi lưu sản phẩm', true);
          } finally {
            if (saveProductBtn) saveProductBtn.disabled = false;
          }
        });
      }

      // ==========================================
      // CRM ORDERS & CUSTOMERS CONTROLLER
      // ==========================================
      const orderModal = document.getElementById('order-editor-modal');
      const addOrderBtn = document.getElementById('add-order-btn');
      const closeOrderEditorBtn = document.getElementById('close-order-editor-btn');
      const cancelOrderBtn = document.getElementById('cancel-order-btn');
      const orderForm = document.getElementById('order-form') as HTMLFormElement;
      const orderSearchInput = document.getElementById('order-search-input') as HTMLInputElement;
      const orderStatusFilter = document.getElementById('order-status-filter') as HTMLSelectElement;
      const btnExportOrdersCsv = document.getElementById('btn-export-orders-csv');
      const saveOrderBtn = document.getElementById('save-order-btn') as HTMLButtonElement;
      const orderEditorTitle = document.getElementById('order-editor-title');

      const ordIdInput = document.getElementById('order-id') as HTMLInputElement;
      const ordNameInput = document.getElementById('order-customer-name') as HTMLInputElement;
      const ordEmailInput = document.getElementById('order-email') as HTMLInputElement;
      const ordPhoneInput = document.getElementById('order-phone') as HTMLInputElement;
      const ordProductInput = document.getElementById('order-product') as HTMLInputElement;
      const ordAmountInput = document.getElementById('order-amount') as HTMLInputElement;
      const ordStatusSelect = document.getElementById('order-status') as HTMLSelectElement;
      const ordMethodSelect = document.getElementById('order-payment-method') as HTMLSelectElement;
      const ordNotesInput = document.getElementById('order-notes') as HTMLTextAreaElement;

      let isOrderEditMode = false;

      function getFilteredOrders() {
        const q = (orderSearchInput?.value || '').toLowerCase().trim();
        const statusVal = orderStatusFilter?.value || 'all';

        let list = [...currentOrders];
        if (q) {
          list = list.filter(o => 
            (o.id || '').toLowerCase().includes(q) ||
            (o.customerName || '').toLowerCase().includes(q) ||
            (o.email || '').toLowerCase().includes(q) ||
            (o.phone || '').toLowerCase().includes(q) ||
            (o.product || '').toLowerCase().includes(q) ||
            (o.notes || '').toLowerCase().includes(q)
          );
        }
        if (statusVal !== 'all') {
          list = list.filter(o => (o.status || '').toLowerCase() === statusVal.toLowerCase());
        }
        return list;
      }

      function updateCrmKpiStats() {
        const crmRevEl = document.getElementById('crm-stat-revenue');
        const crmOrdEl = document.getElementById('crm-stat-orders');
        const crmCustEl = document.getElementById('crm-stat-customers');
        const crmRateEl = document.getElementById('crm-stat-rate');

        let totalRev = 0;
        let paidCount = 0;
        const uniqueEmails = new Set<string>();

        currentOrders.forEach((o: any) => {
          if (o.email) uniqueEmails.add(o.email.toLowerCase().trim());
          if (o.status === 'Đã thanh toán' || o.status === 'Đã hoàn tất') {
            paidCount++;
            const num = parseInt(String(o.amount || '0').replace(/[^0-9]/g, ''), 10) || 0;
            totalRev += num;
          }
        });

        if (crmRevEl) crmRevEl.textContent = totalRev > 0 ? totalRev.toLocaleString('vi-VN') + 'đ' : '0đ';
        if (crmOrdEl) crmOrdEl.textContent = String(currentOrders.length);
        if (crmCustEl) crmCustEl.textContent = String(uniqueEmails.size);
        if (crmRateEl) {
          const rate = currentOrders.length > 0 ? Math.round((paidCount / currentOrders.length) * 100) : 100;
          crmRateEl.textContent = `${rate}%`;
        }
      }

      function formatOrderDate(ord: any) {
        if (ord && ord.timestamp) {
          return new Date(ord.timestamp).toLocaleString('vi-VN', {
            timeZone: 'Asia/Ho_Chi_Minh',
            hour12: false
          });
        }
        return ord?.date || '—';
      }

      function renderOrders() {
        const tbody = document.getElementById('orders-table-body');
        if (!tbody) return;

        updateCrmKpiStats();
        const displayList = getFilteredOrders();

        if (displayList.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-500">
                ${currentOrders.length === 0 
                  ? 'Chưa có đơn hàng nào trong hệ thống CRM. Bấm "Tạo Đơn Thủ Công" để thêm khách hàng đầu tiên!' 
                  : 'Không tìm thấy đơn hàng phù hợp với điều kiện tìm kiếm.'}
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = displayList.map(ord => {
          const statusClass = ord.status === 'Đã thanh toán'
            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
            : ord.status === 'Chờ xác nhận'
            ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
            : ord.status === 'Đã hoàn tất'
            ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
            : 'bg-rose-500/10 text-rose-400 border border-rose-500/20';

          const cleanPhone = (ord.phone || '').replace(/[^0-9]/g, '');
          const initial = (ord.customerName || 'K').trim().charAt(0).toUpperCase();

          let displayNotes = (ord.notes || '').trim();
          if (ord.status === 'Đã thanh toán' || ord.status === 'Đã hoàn tất') {
            displayNotes = displayNotes
              .replace(/Đang chờ chuyển khoản[^\n|]*\s*\|\s*/gi, '')
              .replace(/Đang chờ chuyển khoản[^\n|]*/gi, '')
              .trim();
          }

          return `
            <tr class="hover:bg-slate-900/40 transition-all align-top">
              <!-- Cột 1: Mã đơn & Ngày -->
              <td class="p-4 font-mono text-xs whitespace-nowrap">
                <span class="px-2 py-0.5 rounded bg-cyan-950/50 text-cyan-400 border border-cyan-800/40 font-bold block w-fit mb-1 cursor-pointer hover:bg-cyan-900/60" title="Bấm để sao chép" onclick="navigator.clipboard.writeText('${ord.id}')">
                  ${ord.id}
                </span>
                <span class="text-[11px] text-slate-400 block">${formatOrderDate(ord)}</span>
              </td>

              <!-- Cột 2: Khách hàng -->
              <td class="p-4">
                <div class="flex items-start gap-2.5">
                  <span class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 text-brand-green font-extrabold flex items-center justify-center text-xs shrink-0 mt-0.5">
                    ${initial}
                  </span>
                  <div class="min-w-0">
                    <span class="text-sm font-bold text-white block leading-snug">${ord.customerName || 'Chưa có tên'}</span>
                    <a href="mailto:${ord.email}" class="text-xs text-slate-400 hover:text-emerald-400 block truncate" title="${ord.email}">
                      ${ord.email || '—'}
                    </a>
                    ${ord.phone ? `
                      <div class="flex items-center gap-1.5 mt-1">
                        <span class="text-[11px] font-mono text-slate-300">${ord.phone}</span>
                        ${cleanPhone ? `<a href="https://zalo.me/${cleanPhone}" target="_blank" class="text-[10px] px-1.5 py-0.2 rounded bg-blue-950/60 text-blue-300 hover:bg-blue-900/80 border border-blue-800/40 font-bold" title="Nhắn Zalo">Zalo</a>` : ''}
                      </div>
                    ` : ''}
                  </div>
                </div>
              </td>

              <!-- Cột 3: Sản phẩm -->
              <td class="p-4 text-xs font-medium text-slate-200 max-w-xs">
                <span class="line-clamp-2" title="${ord.product}">${ord.product || 'Ebook Tạo Blog'}</span>
              </td>

              <!-- Cột 4: Số tiền -->
              <td class="p-4 text-sm font-bold text-emerald-400 font-mono whitespace-nowrap">
                ${ord.amount || '0đ'}
              </td>

              <!-- Cột 5: Trạng thái -->
              <td class="p-4 whitespace-nowrap">
                <span class="px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider ${statusClass}">
                  ${ord.status || 'Đã thanh toán'}
                </span>
              </td>

              <!-- Cột 6: Phương thức & Ghi chú -->
              <td class="p-4 text-xs max-w-xs">
                <span class="px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 font-medium block w-fit mb-1">
                  ${ord.paymentMethod || 'Chuyển khoản QR'}
                </span>
                ${displayNotes ? `<p class="text-slate-400 text-[11px] italic line-clamp-2" title="${displayNotes}">${displayNotes}</p>` : '<span class="text-slate-600 text-[11px]">—</span>'}
              </td>

              <!-- Cột 7: Thao tác -->
              <td class="p-4 text-right whitespace-nowrap">
                <div class="flex items-center gap-1.5 justify-end">
                  <button data-id="${ord.id}" data-name="${ord.customerName || ord.id}" class="manage-drip-btn px-2.5 py-1.5 rounded-lg bg-orange-500/10 hover:bg-orange-500 hover:text-white text-orange-400 text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="Quản lý Chuỗi Email Chăm Sóc 7 Ngày">
                    📬 Chuỗi 7N
                  </button>
                  <button data-id="${ord.id}" data-email="${ord.email}" class="resend-order-email-btn px-2.5 py-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500 hover:text-white text-emerald-400 text-xs font-bold transition-all cursor-pointer flex items-center gap-1" title="Gửi lại Email Ebook">
                    ✉️ Gửi Ebook
                  </button>
                  <button data-id="${ord.id}" class="edit-order-btn px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-bold transition-all cursor-pointer">
                    ✏️ Sửa
                  </button>
                  <button data-id="${ord.id}" data-name="${ord.customerName || ord.id}" class="delete-order-btn px-2.5 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-400 text-xs font-bold transition-all cursor-pointer">
                    🗑️
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');

        attachOrderEvents();
      }

      function attachOrderEvents() {
        // Manage Drip Email button
        document.querySelectorAll('.manage-drip-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const ord = currentOrders.find(o => o.id === id);
            if (ord) openDripModal(ord);
          });
        });

        // Resend email button
        document.querySelectorAll('.resend-order-email-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const email = btn.getAttribute('data-email');
            if (!id || !email) return;

            const confirmed = window.confirm(`Bạn có chắc chắn muốn gửi lại Email bàn giao Ebook tới địa chỉ: ${email}?`);
            if (!confirmed) return;

            const origText = btn.innerHTML;
            btn.innerHTML = '⏳ Đang gửi...';
            (btn as HTMLButtonElement).disabled = true;

            try {
              const res = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'resend_email', id })
              });
              const result = await res.json();
              if (result.success) {
                showToast(`Đã gửi lại Ebook thành công tới ${email}!`);
                loadAllData();
              } else {
                showToast(result.error || 'Lỗi gửi email', true);
              }
            } catch (err: any) {
              showToast('Lỗi kết nối máy chủ: ' + err.message, true);
            } finally {
              btn.innerHTML = origText;
              (btn as HTMLButtonElement).disabled = false;
            }
          });
        });

        // Edit button
        document.querySelectorAll('.edit-order-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const ord = currentOrders.find(o => o.id === id);
            if (ord) openOrderModal(true, ord);
          });
        });

        // Delete button
        document.querySelectorAll('.delete-order-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name') || id;
            if (!id) return;

            const confirmed = window.confirm(`Bạn có chắc muốn xóa đơn hàng "${id}" của khách "${name}" không?`);
            if (!confirmed) return;

            try {
              const res = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'delete', id })
              });
              const result = await res.json();
              if (result.success) {
                currentOrders = currentOrders.filter(o => o.id !== id);
                renderOrders();
                updateOverviewStats();
                showToast('Đã xóa đơn hàng thành công!');
              } else {
                showToast(result.error || 'Lỗi khi xóa đơn', true);
              }
            } catch (err: any) {
              showToast('Lỗi máy chủ: ' + err.message, true);
            }
          });
        });
      }

      function openOrderModal(isEdit = false, ord: any = null) {
        if (!orderModal) return;
        isOrderEditMode = isEdit;
        if (isEdit && ord) {
          if (orderEditorTitle) orderEditorTitle.textContent = `💳 Sửa Đơn Hàng: ${ord.id}`;
          if (ordIdInput) {
            ordIdInput.value = ord.id || '';
            ordIdInput.readOnly = true;
          }
          if (ordNameInput) ordNameInput.value = ord.customerName || '';
          if (ordEmailInput) ordEmailInput.value = ord.email || '';
          if (ordPhoneInput) ordPhoneInput.value = ord.phone || '';
          if (ordProductInput) ordProductInput.value = ord.product || 'Ebook Tạo Blog – Cỗ máy bán hàng tự động bằng AI';
          if (ordAmountInput) ordAmountInput.value = ord.amount || '299.000đ';
          if (ordStatusSelect) ordStatusSelect.value = ord.status || 'Đã thanh toán';
          if (ordMethodSelect) ordMethodSelect.value = ord.paymentMethod || 'Chuyển khoản QR';
          let currentNotes = ord.notes || '';
          if (ord.status === 'Đã thanh toán' || ord.status === 'Đã hoàn tất') {
            currentNotes = currentNotes
              .replace(/Đang chờ chuyển khoản[^\n|]*\s*\|\s*/gi, '')
              .replace(/Đang chờ chuyển khoản[^\n|]*/gi, '')
              .trim();
          }
          if (ordNotesInput) ordNotesInput.value = currentNotes;
        } else {
          if (orderForm) orderForm.reset();
          isOrderEditMode = false;
          if (orderEditorTitle) orderEditorTitle.textContent = '💳 Tạo Đơn Hàng Mới (CRM)';
          if (ordIdInput) {
            ordIdInput.value = '';
            ordIdInput.readOnly = false;
          }
          if (ordProductInput) ordProductInput.value = 'Ebook Tạo Blog – Cỗ máy bán hàng tự động bằng AI';
          if (ordAmountInput) ordAmountInput.value = '299.000đ';
          if (ordStatusSelect) ordStatusSelect.value = 'Đã thanh toán';
          if (ordMethodSelect) ordMethodSelect.value = 'Chuyển khoản QR';
        }

        orderModal.classList.remove('hidden');
        orderModal.classList.add('flex');
        if (ordNameInput) ordNameInput.focus();
      }

      function closeOrderModal() {
        if (!orderModal) return;
        orderModal.classList.add('hidden');
        orderModal.classList.remove('flex');
        if (orderForm) orderForm.reset();
        isOrderEditMode = false;
      }

      if (addOrderBtn) addOrderBtn.addEventListener('click', () => openOrderModal(false));
      if (closeOrderEditorBtn) closeOrderEditorBtn.addEventListener('click', closeOrderModal);
      if (cancelOrderBtn) cancelOrderBtn.addEventListener('click', closeOrderModal);

      // Search & Status filter
      if (orderSearchInput) orderSearchInput.addEventListener('input', () => renderOrders());
      if (orderStatusFilter) orderStatusFilter.addEventListener('change', () => renderOrders());

      // Quick amount buttons
      document.querySelectorAll('.quick-order-amount-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const amt = btn.getAttribute('data-amt');
          if (ordAmountInput && amt) ordAmountInput.value = amt;
        });
      });

      // Export CSV
      if (btnExportOrdersCsv) {
        btnExportOrdersCsv.addEventListener('click', () => {
          if (currentOrders.length === 0) {
            showToast('Không có đơn hàng nào để xuất file!', true);
            return;
          }

          const headers = ['Mã đơn', 'Khách hàng', 'Email', 'Số điện thoại', 'Sản phẩm', 'Số tiền', 'Trạng thái', 'Phương thức thanh toán', 'Ngày đặt', 'Ghi chú'];
          const rows = currentOrders.map(o => [
            `"${(o.id || '').replace(/"/g, '""')}"`,
            `"${(o.customerName || '').replace(/"/g, '""')}"`,
            `"${(o.email || '').replace(/"/g, '""')}"`,
            `"${(o.phone || '').replace(/"/g, '""')}"`,
            `"${(o.product || '').replace(/"/g, '""')}"`,
            `"${(o.amount || '').replace(/"/g, '""')}"`,
            `"${(o.status || '').replace(/"/g, '""')}"`,
            `"${(o.paymentMethod || '').replace(/"/g, '""')}"`,
            `"${formatOrderDate(o).replace(/"/g, '""')}"`,
            `"${(o.notes || '').replace(/"/g, '""')}"`
          ]);

          const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
          const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `danh-sach-don-hang-${new Date().toISOString().slice(0, 10)}.csv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('📥 Đã xuất file CSV đơn hàng thành công!');
        });
      }

      // Order Form Submit
      if (orderForm) {
        orderForm.addEventListener('submit', async (e) => {
          e.preventDefault();

          const customerName = ordNameInput?.value.trim();
          const email = ordEmailInput?.value.trim();
          if (!customerName || !email) {
            showToast('Vui lòng nhập Họ tên và Email khách hàng!', true);
            return;
          }

          const payload = {
            action: isOrderEditMode ? 'update' : 'create',
            id: ordIdInput?.value.trim(),
            customerName,
            email,
            phone: ordPhoneInput?.value.trim(),
            product: ordProductInput?.value.trim() || 'Ebook Tạo Blog – Cỗ máy bán hàng tự động bằng AI',
            amount: ordAmountInput?.value.trim() || '299.000đ',
            status: ordStatusSelect?.value || 'Đã thanh toán',
            paymentMethod: ordMethodSelect?.value || 'Chuyển khoản QR',
            notes: ordNotesInput?.value.trim()
          };

          try {
            if (saveOrderBtn) saveOrderBtn.disabled = true;
            const res = await fetch('/api/orders', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
              showToast(isOrderEditMode ? 'Cập nhật đơn hàng thành công!' : 'Tạo đơn hàng mới thành công!');
              closeOrderModal();
              loadAllData();
            } else {
              showToast(result.error || 'Lỗi khi lưu đơn hàng', true);
            }
          } catch (err: any) {
            showToast('Lỗi máy chủ: ' + err.message, true);
          } finally {
            if (saveOrderBtn) saveOrderBtn.disabled = false;
          }
        });
      }

      // ===== DRIP CAMPAIGN 7 DAYS CONTROLLER =====
      const dripModal = document.getElementById('order-drip-modal');
      const closeDripBtn = document.getElementById('close-order-drip-btn');
      const closeDripFooterBtn = document.getElementById('close-order-drip-footer-btn');
      const btnScheduleAllDrip = document.getElementById('btn-schedule-all-drip');
      const triggerDripCronBtn = document.getElementById('trigger-drip-cron-btn');

      let activeDripOrder: any = null;

      const DRIP_METADATA_CLIENT = [
        { day: 1, badge: 'Bạn không đi một mình', subject: 'Thứ quyết định bạn có blog hay không, không nằm trong ebook.' },
        { day: 2, badge: 'Gỡ kẹt cùng nhau', subject: 'Cả cuối tuần. Một trang trắng.' },
        { day: 3, badge: 'Chọn ngách ra tiền', subject: 'Mình viết rất chăm. Và không ra nổi một đồng.' },
        { day: 4, badge: 'Bài viết đầu tiên', subject: 'Bài viết “chẳng hay ho gì” vẫn đang mang tiền về cho mình.' },
        { day: 5, badge: 'Đừng dừng ở giữa', subject: 'Mình đã bỏ cuộc 5 lần. Đây là điều mình ước có người nói với mình.' },
        { day: 6, badge: 'Cùng nhìn lại', subject: 'Một tuần trước, tất cả những ô này đều trống.' },
        { day: 7, badge: 'Một tuần nhìn lại', subject: '7 ngày trước, bạn chưa có blog. Hôm nay thì sao?' }
      ];

      function openDripModal(ord: any) {
        activeDripOrder = ord;
        if (!dripModal) return;
        dripModal.classList.remove('hidden');
        dripModal.classList.add('flex');
        renderDripModalContent();
      }

      function closeDripModal() {
        if (!dripModal) return;
        dripModal.classList.add('hidden');
        dripModal.classList.remove('flex');
        activeDripOrder = null;
      }

      if (closeDripBtn) closeDripBtn.addEventListener('click', closeDripModal);
      if (closeDripFooterBtn) closeDripFooterBtn.addEventListener('click', closeDripModal);

      function renderDripModalContent() {
        if (!activeDripOrder) return;
        const ord = activeDripOrder;
        const customerInfoEl = document.getElementById('drip-customer-info');
        const container = document.getElementById('drip-days-container');

        if (customerInfoEl) {
          customerInfoEl.innerHTML = `
            <div>
              <span class="text-slate-400">Khách hàng:</span>
              <strong class="text-white ml-1">${ord.customerName || 'Chưa có tên'}</strong>
              <span class="text-cyan-400 font-mono ml-2">(${ord.email})</span>
            </div>
            <div>
              <span class="text-slate-400">Mã đơn:</span>
              <strong class="text-cyan-400 font-mono ml-1">${ord.id}</strong>
              <span class="text-slate-400 ml-3">Ngày mua:</span>
              <span class="text-slate-300 ml-1">${formatOrderDate(ord)}</span>
            </div>
          `;
        }

        if (container) {
          const daysData = ord.dripCampaign?.days || [];
          container.innerHTML = DRIP_METADATA_CLIENT.map(meta => {
            const dayRecord = daysData.find((d: any) => d.day === meta.day);
            let statusBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400">⚪ Đang chờ đến hạn</span>';
            
            if (dayRecord) {
              if (dayRecord.status === 'sent') {
                const sentDate = dayRecord.sentAt ? new Date(dayRecord.sentAt).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour12: false }) : '';
                statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">✅ Đã gửi (${sentDate})</span>`;
              } else if (dayRecord.status === 'scheduled') {
                const schDate = dayRecord.scheduledFor ? new Date(dayRecord.scheduledFor).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', hour12: false }) : '';
                statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">⏳ Đã lên lịch (${schDate})</span>`;
              } else if (dayRecord.status === 'failed') {
                statusBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30" title="${dayRecord.error || ''}">⚠️ Lỗi gửi</span>`;
              }
            }

            return `
              <div class="p-3.5 rounded-2xl bg-slate-950/40 border border-slate-800/80 hover:border-slate-700/80 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <span class="px-2 py-0.5 rounded-md bg-orange-500/10 text-orange-400 font-extrabold text-xs border border-orange-500/20">
                      Ngày ${meta.day} · ${meta.badge}
                    </span>
                    ${statusBadge}
                  </div>
                  <p class="text-xs font-medium text-slate-200 truncate" title="${meta.subject}">${meta.subject}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button data-day="${meta.day}" class="send-single-drip-btn px-3 py-1.5 rounded-lg bg-orange-500/20 hover:bg-orange-500 hover:text-white text-orange-400 font-bold text-xs transition-all flex items-center gap-1 cursor-pointer">
                    <span>📨</span> Gửi Thử Ngay
                  </button>
                </div>
              </div>
            `;
          }).join('');

          // Attach event for single drip buttons
          container.querySelectorAll('.send-single-drip-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              const day = btn.getAttribute('data-day');
              if (!day || !activeDripOrder) return;

              const confirmed = window.confirm(`Bạn có chắc muốn gửi Email Ngày ${day} tới ${activeDripOrder.email}?`);
              if (!confirmed) return;

              const origHtml = btn.innerHTML;
              btn.innerHTML = '⏳ Đang gửi...';
              (btn as HTMLButtonElement).disabled = true;

              try {
                const res = await fetch('/api/orders', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'send_drip_day', id: activeDripOrder.id, day })
                });
                const result = await res.json();
                if (result.success) {
                  showToast(`Đã gửi thành công Email Ngày ${day} tới ${activeDripOrder.email}!`);
                  await loadAllData();
                  activeDripOrder = currentOrders.find(o => o.id === activeDripOrder.id) || activeDripOrder;
                  renderDripModalContent();
                } else {
                  showToast(result.error || 'Lỗi gửi mail', true);
                }
              } catch (err: any) {
                showToast('Lỗi mạng: ' + err.message, true);
              } finally {
                btn.innerHTML = origHtml;
                (btn as HTMLButtonElement).disabled = false;
              }
            });
          });
        }
      }

      // Button schedule all
      if (btnScheduleAllDrip) {
        btnScheduleAllDrip.addEventListener('click', async () => {
          if (!activeDripOrder) return;
          const confirmed = window.confirm(`Bạn có muốn tự động lên lịch gửi 7 ngày liên tiếp qua Resend cho đơn ${activeDripOrder.id} (${activeDripOrder.email})?`);
          if (!confirmed) return;

          btnScheduleAllDrip.textContent = '⏳ Đang lên lịch...';
          (btnScheduleAllDrip as HTMLButtonElement).disabled = true;

          try {
            const res = await fetch('/api/orders', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'schedule_drip', id: activeDripOrder.id })
            });
            const result = await res.json();
            if (result.success) {
              showToast(result.message || 'Đã lên lịch thành công chuỗi 7 ngày!');
              await loadAllData();
              activeDripOrder = currentOrders.find(o => o.id === activeDripOrder.id) || activeDripOrder;
              renderDripModalContent();
            } else {
              showToast(result.error || 'Lỗi lên lịch', true);
            }
          } catch (err: any) {
            showToast('Lỗi máy chủ: ' + err.message, true);
          } finally {
            btnScheduleAllDrip.innerHTML = '<span>⚡</span> Lên Lịch Tự Động 7 Ngày (Resend)';
            (btnScheduleAllDrip as HTMLButtonElement).disabled = false;
          }
        });
      }

      // Button trigger cron
      if (triggerDripCronBtn) {
        triggerDripCronBtn.addEventListener('click', async () => {
          const confirmed = window.confirm('Quét toàn bộ danh sách đơn hàng và gửi các email chăm sóc đã đến hạn hôm nay?');
          if (!confirmed) return;

          const origText = triggerDripCronBtn.innerHTML;
          triggerDripCronBtn.innerHTML = '<span>⏳</span> Đang quét & gửi...';
          (triggerDripCronBtn as HTMLButtonElement).disabled = true;

          try {
            const res = await fetch('/api/cron/send-drip');
            const result = await res.json();
            if (result.success) {
              showToast(result.message || `Đã quét xong. Gửi thành công ${result.sentCount} email.`);
              loadAllData();
            } else {
              showToast(result.error || 'Lỗi khi chạy quét đơn', true);
            }
          } catch (err: any) {
            showToast('Lỗi kết nối: ' + err.message, true);
          } finally {
            triggerDripCronBtn.innerHTML = origText;
            (triggerDripCronBtn as HTMLButtonElement).disabled = false;
          }
        });
      }

      // Start auth check
      checkAuth();
    };

    // Run immediately since Astro modules are deferred
    initAdmin();
    
    // Support ViewTransitions if added later
    document.addEventListener('astro:page-load', initAdmin);
  </script>
</Layout>
