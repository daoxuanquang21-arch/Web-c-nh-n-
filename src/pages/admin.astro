                          <span class="font-extrabold text-emerald-400">H3</span> Phương Pháp / Mục Con
                        </button>

                        <button type="button" id="btn-fmt-quote" title="Chèn trích dẫn Blockquote (Viền xanh lá, nghiêng)" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
                          <span class="font-serif italic font-bold">"</span> Trích Dẫn
                        </button>

                        <button type="button" id="btn-fmt-list" title="Chèn gạch đầu dòng" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-bold transition-all flex items-center gap-1 cursor-pointer">
