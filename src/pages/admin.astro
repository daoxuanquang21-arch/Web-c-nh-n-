        // Global Delete Subscriber Handler
        (window as any).deleteSubItem = async (email: string) => {
          if (!email) return;
          currentSubscribers = currentSubscribers.filter(s => s.email !== email);
          renderSubscribers();
          updateOverviewStats();
          showToast('Đã xóa người nhận bản tin!');

          try {
            await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', email })
            });
          } catch (err) {
            console.error('Delete sub fetch error:', err);
          }
        };

        // Attach subscriber delete events
        document.querySelectorAll('.delete-sub-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const email = btn.getAttribute('data-email') || '';
            (window as any).deleteSubItem(email);
          });
