---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bảng Điều Khiển Quản Trị | daoxuanquang.com.vn" description="Hệ thống quản lý nội dung bài viết, danh sách khách hàng đăng ký và thiết lập website." noindex={true} hideNavFooter={true}>
  <div class="min-h-screen bg-slate-950 text-slate-100 relative overflow-hidden font-['Be_Vietnam_Pro'] antialiased">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute -top-40 -left-40 w-[600px] h-[600px] rounded-full bg-brand-green/5 blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-20 -right-20 w-[600px] h-[600px] rounded-full bg-brand-blue/5 blur-[150px] pointer-events-none"></div>

    <!-- LOCKSCREEN (LOGIN) SCREEN -->
    <div id="lockscreen" class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/90 backdrop-blur-xl transition-all duration-500">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.03),transparent_70%)] pointer-events-none"></div>
      
      <div class="w-full max-w-md p-8 rounded-3xl bg-slate-900/60 border border-slate-800 shadow-2xl relative z-10 text-center space-y-6 backdrop-blur-md">
        <!-- Logo / Icon -->
        <div class="inline-flex items-center justify-center h-16 w-16 rounded-2xl bg-gradient-to-tr from-brand-green to-emerald-400 text-white text-3xl font-bold shadow-lg shadow-brand-green/20 mx-auto">
          🔒
        </div>
        
        <div class="space-y-2">
          <h2 class="text-2xl font-extrabold tracking-tight">Hệ Thống Quản Trị</h2>
          <p class="text-sm text-slate-400">Vui lòng nhập mật khẩu bảo mật để truy cập bảng điều khiển.</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              required 
              placeholder="Nhập mật khẩu truy cập..." 
              class="w-full px-5 py-4 rounded-xl border border-slate-800 bg-slate-950/50 focus:outline-none focus:ring-2 focus:ring-brand-green/30 focus:border-brand-green text-center text-lg tracking-widest placeholder:tracking-normal placeholder:text-sm transition-all"
            />
          </div>
          <button 
            type="submit" 
            class="w-full py-4 rounded-xl bg-brand-green hover:bg-brand-green-dark text-white font-bold text-sm transition-all transform hover:scale-[1.02] shadow-lg shadow-brand-green/10 cursor-pointer"
          >
            Đăng Nhập Hệ Thống &rarr;
          </button>
        </form>
        <p id="login-error" class="text-xs text-rose-500 font-medium hidden">⚠️ Mật khẩu không chính xác. Vui lòng thử lại!</p>
      </div>
    </div>

    <!-- MAIN DASHBOARD SCREEN (HIDDEN BY DEFAULT) -->
    <div id="dashboard" class="hidden min-h-screen flex flex-col md:flex-row relative z-10">
      
      <!-- SIDEBAR / MOBILE NAVIGATION TOP HEADER -->
      <aside class="w-full md:w-64 shrink-0 bg-slate-900/60 border-b md:border-b-0 md:border-r border-slate-800/80 backdrop-blur-md flex flex-col justify-between p-4 sm:p-6 space-y-4 md:space-y-8">
        <div class="space-y-4 md:space-y-8">
          <!-- Logo Brand & Logout Mobile Row -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-xl bg-brand-green text-white font-extrabold text-xl flex items-center justify-center shadow-md">
                Q
              </div>
              <div>
                <span class="font-extrabold text-base sm:text-lg tracking-tight block text-white">daoxuanquang.com.vn</span>
                <span class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">Admin Panel</span>
              </div>
            </div>
            <button id="logout-btn-mobile" class="md:hidden text-xs font-bold text-slate-400 hover:text-rose-400 p-2 rounded-lg bg-slate-800/60 cursor-pointer">
              🚪 Thoát
            </button>
          </div>

          <!-- Touch Scrollable Tabs for Mobile & Vertical for Desktop -->
          <nav class="flex md:flex-col overflow-x-auto no-scrollbar gap-2 pb-1 md:pb-0 md:space-y-1">
            <button data-tab="overview" class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:bg-slate-800/50 text-slate-300 hover:text-white cursor-pointer tab-btn active whitespace-nowrap">
              📊 Tổng quan
            </button>
            <button data-tab="posts" class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:bg-slate-800/50 text-slate-300 hover:text-white cursor-pointer tab-btn whitespace-nowrap">
              ✍️ Bài viết
            </button>
            <button data-tab="subscribers" class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:bg-slate-800/50 text-slate-300 hover:text-white cursor-pointer tab-btn whitespace-nowrap">
              📨 Đăng ký
            </button>
            <button data-tab="leads" class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:bg-slate-800/50 text-slate-300 hover:text-white cursor-pointer tab-btn whitespace-nowrap">
              🤝 Khảo sát
            </button>
            <button data-tab="products" class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all hover:bg-slate-800/50 text-slate-300 hover:text-white cursor-pointer tab-btn whitespace-nowrap">
              📦 Sản phẩm
            </button>
          </nav>
        </div>

        <!-- Sidebar footer info -->
        <div class="hidden md:block border-t border-slate-800/60 pt-6">
          <button id="logout-btn" class="w-full text-left text-xs font-bold text-slate-400 hover:text-rose-400 transition-colors flex items-center gap-2 cursor-pointer">
            🚪 Đăng xuất quản trị
          </button>
        </div>
      </aside>

      <!-- CONTENT AREA -->
      <main class="flex-grow p-6 md:p-10 space-y-8 overflow-y-auto max-h-screen">
        <!-- Top bar -->
        <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-800 pb-6">
          <div>
            <h1 id="page-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">📊 Tổng Quan Dashboard</h1>
            <p class="text-slate-300 text-sm mt-1 font-medium">Xin chào Quảng, chúc một ngày làm việc tự động hóa hiệu quả!</p>
          </div>
          <div class="flex items-center gap-3">
            <a href="/" class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-200 hover:text-white text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
              🌐 Xem trang chủ
            </a>
            <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-[10px] font-mono text-emerald-400 font-bold flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              Live Server Active
            </span>
          </div>
        </header>

        <!-- TAB CONTENT: OVERVIEW -->
        <section id="tab-overview" class="tab-pane space-y-8">
          <!-- Stats Grid -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Stat card 1 -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition-all flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-xs text-slate-300 font-bold uppercase tracking-wider block">Bài viết Blog</span>
                <span id="stat-posts-count" class="text-4xl font-extrabold text-white block">0</span>
              </div>
              <span class="text-2xl p-3 bg-emerald-500/10 text-emerald-400 rounded-xl border border-emerald-500/20">✍️</span>
            </div>
            <!-- Stat card 2 -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition-all flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-xs text-slate-300 font-bold uppercase tracking-wider block">Đăng ký bản tin</span>
                <span id="stat-subscribers-count" class="text-4xl font-extrabold text-white block">0</span>
              </div>
              <span class="text-2xl p-3 bg-blue-500/10 text-blue-400 rounded-xl border border-blue-500/20">📨</span>
            </div>
            <!-- Stat card 3 -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition-all flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-xs text-slate-300 font-bold uppercase tracking-wider block">Yêu cầu kèm cặp</span>
                <span id="stat-leads-count" class="text-4xl font-extrabold text-white block">0</span>
              </div>
              <span class="text-2xl p-3 bg-indigo-500/10 text-indigo-400 rounded-xl border border-indigo-500/20">🤝</span>
            </div>
            <!-- Stat card 4 -->
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800/90 hover:border-slate-700 transition-all flex items-center justify-between">
              <div class="space-y-1">
                <span class="text-xs text-slate-300 font-bold uppercase tracking-wider block">Sản phẩm & công cụ</span>
                <span id="stat-products-count" class="text-4xl font-extrabold text-white block">0</span>
              </div>
              <span class="text-2xl p-3 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">📦</span>
            </div>
          </div>


        </section>

        <!-- TAB CONTENT: POSTS -->
        <section id="tab-posts" class="tab-pane space-y-8 hidden">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <!-- Search & Filters -->
            <div class="flex flex-wrap items-center gap-3">
              <select id="post-category-filter" class="px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900 text-sm focus:outline-none focus:border-brand-green cursor-pointer">
                <option value="all">Tất cả chuyên mục</option>
                <option value="ai">AI</option>
                <option value="marketing">Marketing</option>
                <option value="cuoc-song">Cuộc sống</option>
              </select>
            </div>
            <!-- Add New Post Button -->
            <button id="add-post-btn" onclick="window.openPostEditorModal && window.openPostEditorModal()" class="px-5 py-2.5 rounded-xl bg-brand-green hover:bg-brand-green-dark text-white font-bold text-sm transition-all transform hover:scale-[1.02] shadow-md flex items-center gap-2 cursor-pointer">
              <span>➕</span> Viết Bài Mới
            </button>
          </div>

          <!-- Post Editor Form Modal Overlay (Hidden by default) -->
          <div id="post-editor-modal" class="hidden fixed inset-0 z-[300] bg-slate-950/85 backdrop-blur-md p-4 sm:p-6 md:p-8 overflow-y-auto justify-center items-start">
            <div class="w-full max-w-7xl my-auto rounded-3xl bg-slate-900 border border-slate-800 p-6 md:p-8 space-y-6 shadow-2xl relative animate-in fade-in zoom-in duration-200">
              <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                <h3 id="editor-title" class="text-xl font-bold flex items-center gap-2 text-white">
                  ✍️ Soạn Thảo Bài Viết Mới Chuẩn SEO v3.0
                </h3>
                <button type="button" id="close-editor-btn" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-bold text-xs transition-all cursor-pointer">✖ Đóng form</button>
              </div>

              <form id="post-form" class="space-y-6">
                <!-- 1. Top Metadata Row: 4 inline columns -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 bg-slate-950/50 p-4 rounded-2xl border border-slate-800/80">
                  <div>
                    <label for="post-slug" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">ĐƯỜNG DẪN TĨNH (SLUG) *</label>
                    <input type="text" id="post-slug" required placeholder="vd: cam-nang-marketing-automation" class="w-full px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900 focus:outline-none focus:border-brand-green font-mono text-sm text-slate-200" />
                  </div>
                  <div>
                    <label for="post-category" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">DANH MỤC *</label>
                    <select id="post-category" required class="w-full px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900 focus:outline-none focus:border-brand-green text-sm cursor-pointer text-slate-200 font-medium">
                      <option value="">-- Chọn danh mục --</option>
                      <option value="ai">AI</option>
                      <option value="marketing">Digital Marketing</option>
                      <option value="cuoc-song">Cuộc sống & Tư duy</option>
                    </select>
                  </div>
                  <div>
                    <label for="post-status" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">CHẾ ĐỘ HIỂN THỊ *</label>
                    <select id="post-status" required class="w-full px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900 focus:outline-none focus:border-brand-green text-sm cursor-pointer font-bold text-emerald-400">
                      <option value="public">Công khai (Public)</option>
                      <option value="private">Riêng tư / Nháp (Draft)</option>
                    </select>
                  </div>
                  <div>
                    <label for="post-pubdate" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">NGÀY/GIỜ ĐĂNG BÀI</label>
                    <input type="datetime-local" id="post-pubdate" class="w-full px-4 py-2.5 rounded-xl border border-slate-800 bg-slate-900 focus:outline-none focus:border-brand-green text-sm text-slate-200" />
                  </div>
                </div>

                <!-- 2. SEO Primary Keyword Banner Row -->
                <div id="seo-keyword-banner-row" class="p-4 rounded-2xl bg-slate-950/80 border border-teal-500/30 flex flex-col md:flex-row items-stretch md:items-center gap-3">
                  <div class="flex-grow space-y-1.5">
                    <label for="post-primary-keyword" class="block text-xs font-extrabold text-teal-400 uppercase tracking-wider flex items-center gap-1.5">
                      <span>✨</span> TỪ KHÓA CHÍNH (SEO PRIMARY KEYWORD) *
                    </label>
                    <input type="text" id="post-primary-keyword" placeholder="Nhập từ khóa chính bài viết..." class="w-full px-4 py-2.5 rounded-xl border border-teal-500/30 bg-slate-900 focus:outline-none focus:border-teal-400 text-sm font-semibold text-white placeholder:font-normal placeholder:text-slate-500" />
                  </div>
                  <button type="button" id="copy-modal-seo-prompt-btn" class="md:self-end px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-extrabold text-xs transition-all shadow-md flex items-center justify-center gap-2 whitespace-nowrap cursor-pointer">
                    ⚡ Tạo Mẫu Prompt SEO v3.0
                  </button>
                </div>

                <!-- 3. Main Grid: Left Editor & Right SEO Analyzer -->
                <div class="grid lg:grid-cols-12 gap-6 items-start">
                  <!-- Left side: Main Editor fields -->
                  <div id="main-editor-container" class="lg:col-span-7 space-y-4 transition-all duration-300">
                    <div>
                      <label for="post-title" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">TIÊU ĐỀ BÀI VIẾT * (TITLE)</label>
                      <input type="text" id="post-title" required placeholder="Nhập tiêu đề bài viết..." class="w-full px-4 py-3 rounded-xl border border-slate-800 bg-slate-950/50 focus:outline-none focus:border-brand-green text-sm font-bold text-white" />
                    </div>

                    <div>
                      <label for="post-description" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">TÓM TẮT NGẮN / SAPO * (SEO DESCRIPTION)</label>
                      <textarea id="post-description" required rows="3" placeholder="Nhập tóm tắt Sapo chuẩn 145-160 ký tự..." class="w-full px-4 py-3 rounded-xl border border-slate-800 bg-slate-950/50 focus:outline-none focus:border-brand-green text-sm leading-relaxed text-slate-200"></textarea>
                    </div>

                    <div>
                      <label id="post-content-label" for="post-content" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">NỘI DUNG CHI TIẾT HTML / MARKDOWN *</label>
                      <textarea id="post-content" required rows="16" placeholder="Soạn thảo nội dung bài viết HTML / Markdown chuẩn SEO v3.0 ở đây..." class="w-full px-4 py-4 rounded-xl border border-slate-800 bg-slate-950/50 focus:outline-none focus:border-brand-green font-sans text-sm leading-relaxed text-slate-200"></textarea>
                    </div>

                    <!-- Submit Action Button -->
                    <div class="pt-2">
                      <button type="submit" id="save-post-btn" class="w-full py-3.5 rounded-xl bg-brand-green hover:bg-brand-green-dark text-white font-extrabold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer">
                        Xuất bản
                      </button>
                    </div>
                  </div>

              <!-- Right side: REAL-TIME SEO V3.0 ANALYZER & PROMPT ENGINE WIDGET -->
              <div id="seo-analyzer-widget" class="lg:col-span-5 space-y-4 bg-slate-950/70 border border-slate-800/80 p-5 rounded-2xl backdrop-blur-md flex flex-col justify-between max-h-[750px] overflow-y-auto transition-all duration-300">
                <div class="space-y-4">
                  <!-- Tab Header Switcher inside Post Modal -->
                  <div class="grid grid-cols-2 gap-2 border-b border-slate-800 pb-3">
                    <button type="button" id="btn-modal-seo-analyzer" class="py-2 px-2.5 rounded-lg text-xs font-bold bg-brand-green/20 text-brand-green border border-brand-green/30 transition-all cursor-pointer text-center">
                      📊 Phân Tích Realtime
                    </button>
                    <button type="button" id="btn-modal-seo-prompt" class="py-2 px-2.5 rounded-lg text-xs font-bold bg-slate-900 text-slate-400 hover:text-slate-200 border border-slate-800 transition-all cursor-pointer text-center">
                      🚀 Tiêu Chuẩn & Prompt v3.0
                    </button>
                  </div>

                  <!-- SUB-PANEL 1: Realtime Analyzer -->
                  <div id="modal-seo-analyzer-panel" class="space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-800/60 pb-2">
                      <span class="text-xs font-extrabold uppercase tracking-wider text-slate-300">13 Tiêu Chuẩn Realtime</span>
                      <span id="seo-score-badge" class="px-2.5 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-mono font-bold text-slate-300">
                        0/13 Tiêu chuẩn
                      </span>
                    </div>

                    <!-- Real-time Checklist Items Container -->
                    <div id="seo-checklist-container" class="space-y-3 text-xs divide-y divide-slate-800/40">
                      <!-- Item 1 -->
                      <div id="seo-item-1" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-rose-500 font-bold text-base leading-none shrink-0 mt-0.5">✕</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Từ khóa chính xuất hiện trong tiêu đề</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Tiêu đề nên chứa từ khóa chính</span>
                        </div>
                      </div>

                      <!-- Item 2 -->
                      <div id="seo-item-2" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5">⚠️</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Độ dài tiêu đề tốt (6-12 từ, hiện tại: 0 từ)</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Tiêu đề lý tưởng là từ 6-12 từ</span>
                        </div>
                      </div>

                      <!-- Item 3 -->
                      <div id="seo-item-3" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-rose-500 font-bold text-base leading-none shrink-0 mt-0.5">✕</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Từ khóa chính xuất hiện trong Sapo</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Sapo cần chứa từ khóa chính</span>
                        </div>
                      </div>

                      <!-- Item 4 -->
                      <div id="seo-item-4" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5">⚠️</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Từ khóa nằm trong 60 ký tự đầu Sapo</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Đẩy từ khóa lên đầu Sapo giúp AI dễ nhận biết hơn</span>
                        </div>
                      </div>

                      <!-- Item 5 -->
                      <div id="seo-item-5" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5">⚠️</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Độ dài Sapo tối ưu (145-160 ký tự, hiện tại: 0)</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Nên điều chỉnh Sapo về khoảng 145-160 ký tự</span>
                        </div>
                      </div>

                      <!-- Item 6 -->
                      <div id="seo-item-6" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5">⚠️</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Sapo chứa tên thương hiệu hoặc tác giả</span>
                          <span class="seo-desc text-[11px] text-slate-400 block">Nên chèn tác giả (e.g. Đào Xuân Quảng) tăng E-E-A-T</span>
                        </div>
                      </div>

                      <!-- Item 7 -->
                      <div id="seo-item-7" class="pt-2 flex items-start gap-3">
                        <span class="seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5">⚠️</span>
                        <div class="space-y-0.5">
                          <span class="seo-title font-bold block text-slate-200">Bài viết chuyên sâu (Tối thiểu 1500 từ, hiện tại: 0 từ)</span>
