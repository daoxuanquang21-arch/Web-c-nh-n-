          updateOverviewStats();
          showToast('Đã xóa người nhận bản tin!');

          try {
            await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', email })
            });
          } catch (err) {
            console.error('Delete sub fetch error:', err);
