      // POST EDIT OR CREATE DIALOG TRIGGER
      const postModal = document.getElementById('post-editor-modal');
      const addPostBtn = document.getElementById('add-post-btn');
      const closeEditorBtn = document.getElementById('close-editor-btn');
      const postForm = document.getElementById('post-form') as HTMLFormElement;
      
      const pTitle = document.getElementById('post-title') as HTMLInputElement;
      const pDesc = document.getElementById('post-description') as HTMLTextAreaElement;
      const pContent = document.getElementById('post-content') as HTMLTextAreaElement;
      const pCat = document.getElementById('post-category') as HTMLSelectElement;
      const pSlug = document.getElementById('post-slug') as HTMLInputElement;
      const pPubDate = document.getElementById('post-pubdate') as HTMLInputElement;
      const pStatus = document.getElementById('post-status') as HTMLSelectElement;
      const pImg = document.getElementById('post-image') as HTMLInputElement | null;
      const pTags = document.getElementById('post-tags') as HTMLInputElement | null;
      const editorTitleText = document.getElementById('editor-title');
      const savePostBtn = document.getElementById('save-post-btn');

      let isEditMode = false;
      let editPostId = '';

      function runRealtimeSEOAnalyzer() {
        try {
          const pKeyword = document.getElementById('post-primary-keyword') as HTMLInputElement;
          const kw = (pKeyword?.value || '').trim().toLowerCase();
          const title = (pTitle?.value || '').trim();
          const desc = (pDesc?.value || '').trim();
          const content = (pContent?.value || '').trim();

          let passedCount = 0;

          const setItem = (id: string, status: 'pass' | 'warn' | 'fail', titleText: string, descText: string) => {
            const el = document.getElementById(id);
            if (!el) return;
            const icon = el.querySelector('.seo-icon');
            const titleEl = el.querySelector('.seo-title');
            const descEl = el.querySelector('.seo-desc');

            if (titleEl) titleEl.textContent = titleText;
            if (descEl) descEl.textContent = descText;

            if (status === 'pass') {
              passedCount++;
              if (icon) {
                icon.textContent = '✓';
                icon.className = 'seo-icon text-emerald-400 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            } else if (status === 'warn') {
              if (icon) {
                icon.textContent = '⚠️';
                icon.className = 'seo-icon text-amber-400 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            } else {
              if (icon) {
                icon.textContent = '✕';
                icon.className = 'seo-icon text-rose-500 font-bold text-base leading-none shrink-0 mt-0.5';
              }
            }
          };

          // 1. Primary keyword in title
          if (!kw) {
            setItem('seo-item-1', 'fail', 'Từ khóa chính xuất hiện trong tiêu đề', 'Vui lòng nhập từ khóa chính ở trên');
          } else if (title.toLowerCase().includes(kw)) {
            setItem('seo-item-1', 'pass', 'Từ khóa chính xuất hiện trong tiêu đề', `Từ khóa '${kw}' đã có trong tiêu đề`);
          } else {
            setItem('seo-item-1', 'fail', 'Từ khóa chính xuất hiện trong tiêu đề', `Tiêu đề nên chứa từ khóa '${kw}'`);
          }

          // 2. Title length (6-12 words)
          const titleWords = title ? title.split(/\s+/).filter(Boolean).length : 0;
          if (titleWords >= 6 && titleWords <= 12) {
            setItem('seo-item-2', 'pass', `Độ dài tiêu đề tốt (6-12 từ, hiện tại: ${titleWords} từ)`, 'Tiêu đề đạt độ dài lý tưởng');
          } else {
            setItem('seo-item-2', 'warn', `Độ dài tiêu đề tốt (6-12 từ, hiện tại: ${titleWords} từ)`, 'Tiêu đề lý tưởng là từ 6-12 từ');
          }

          // 3. Primary keyword in Sapo
          if (!kw) {
            setItem('seo-item-3', 'fail', 'Từ khóa chính xuất hiện trong Sapo', 'Vui lòng nhập từ khóa chính');
          } else if (desc.toLowerCase().includes(kw)) {
            setItem('seo-item-3', 'pass', 'Từ khóa chính xuất hiện trong Sapo', `Sapo đã chứa từ khóa '${kw}'`);
          } else {
            setItem('seo-item-3', 'fail', 'Từ khóa chính xuất hiện trong Sapo', `Sapo cần chứa từ khóa '${kw}'`);
          }

          // 4. Primary keyword in first 60 chars of Sapo
          if (kw && desc.toLowerCase().indexOf(kw) >= 0 && desc.toLowerCase().indexOf(kw) < 60) {
            setItem('seo-item-4', 'pass', 'Từ khóa nằm trong 60 ký tự đầu Sapo', 'Từ khóa nằm ở vị trí ưu tiên đầu Sapo');
          } else {
            setItem('seo-item-4', 'warn', 'Từ khóa nằm trong 60 ký tự đầu Sapo', 'Đẩy từ khóa lên đầu Sapo giúp AI dễ nhận biết hơn');
          }

          // 5. Sapo length (Max 165 chars)
          const descLen = desc.length;
          const sapoCounter = document.getElementById('sapo-char-counter');
          if (sapoCounter) {
            sapoCounter.textContent = `${descLen}/165`;
            sapoCounter.className = descLen > 165 ? 'text-[11px] font-mono text-rose-400 font-bold' : 'text-[11px] font-mono text-brand-green font-bold';
          }

          if (descLen >= 50 && descLen <= 165) {
            setItem('seo-item-5', 'pass', `Độ dài Sapo chuẩn SEO (Tối đa 165 ký tự, hiện tại: ${descLen})`, 'Độ dài Sapo tối ưu cho hiển thị Google & mạng xã hội');
          } else if (descLen > 165) {
            setItem('seo-item-5', 'warn', `Độ dài Sapo vượt quá 165 ký tự (Hiện tại: ${descLen})`, 'Hãy rút ngắn Sapo về dưới 165 ký tự');
          } else {
            setItem('seo-item-5', 'warn', `Độ dài Sapo tối ưu (Tối đa 165 ký tự, hiện tại: ${descLen})`, 'Nên viết Sapo đầy đủ từ 50-165 ký tự');
          }

          // 6. Sapo contains brand / author
          const brandRegex = /(quảng|đào xuân quảng|daoxuanquang|anna|wepower)/i;
          if (brandRegex.test(desc)) {
            setItem('seo-item-6', 'pass', 'Sapo chứa tên thương hiệu hoặc tác giả', 'Đã có thông tin tác giả/thương hiệu tăng E-E-A-T');
          } else {
            setItem('seo-item-6', 'warn', 'Sapo chứa tên thương hiệu hoặc tác giả', 'Nên chèn tác giả (e.g. Đào Xuân Quảng) tăng E-E-A-T');
          }

          // 7. In-depth content (>= 1500 words)
          const contentWords = content ? content.split(/\s+/).filter(Boolean).length : 0;
          if (contentWords >= 1500) {
            setItem('seo-item-7', 'pass', `Bài viết chuyên sâu (Tối thiểu 1500 từ, hiện tại: ${contentWords} từ)`, 'Đã đạt độ dài chuyên sâu chuẩn v3.0');
          } else {
            setItem('seo-item-7', 'warn', `Bài viết chuyên sâu (Tối thiểu 1500 từ, hiện tại: ${contentWords} từ)`, 'Nên triển khai nội dung chi tiết hơn (đích: 2200-4000 từ)');
          }

          // 8. No forbidden characters (!, ngoặc kép, bold markdown **)
          const forbiddenCharsRegex = /[!"“”]|\*\*/;
          if (!forbiddenCharsRegex.test(content) && !forbiddenCharsRegex.test(title) && !forbiddenCharsRegex.test(desc)) {
            setItem('seo-item-8', 'pass', 'Không có ký tự cấm (!, ngoặc kép, bold markdown **)', 'Nội dung sạch, không vi phạm ký tự cấm');
          } else {
            setItem('seo-item-8', 'fail', 'Có ký tự cấm (!, ngoặc kép, bold markdown **)', 'Vui lòng xóa !, ngoặc kép hoặc markdown **');
          }

          // 9. No forbidden words (cam kết, 100%, tuyệt đối, chắc chắn, thần tốc, tuyệt vời)
          const forbiddenWordsRegex = /(cam kết|100%|tuyệt đối|chắc chắn|thần tốc|tuyệt vời|chữa khỏi|trị dứt điểm)/i;
          if (!forbiddenWordsRegex.test(content) && !forbiddenWordsRegex.test(title) && !forbiddenWordsRegex.test(desc)) {
            setItem('seo-item-9', 'pass', 'Không sử dụng từ ngữ bị cấm (cam kết, 100%, tuyệt đối...)', 'Nội dung không chứa từ ngữ quảng cáo quá đà');
          } else {
            setItem('seo-item-9', 'fail', 'Sử dụng từ ngữ bị cấm (cam kết, 100%, tuyệt đối...)', 'Phát hiện từ ngữ bị cấm trong bài viết');
          }

          // 10. All H2, H3 headings are questions (?)
          const headings = content.match(/<h[23][^>]*>(.*?)<\/h[23]>|#{2,3}\s+(.*)/gi) || [];
          const questionHeadings = headings.filter(h => h.trim().endsWith('?') || h.trim().endsWith('?</span>') || h.includes('?'));
          if (headings.length > 0 && questionHeadings.length === headings.length) {
            setItem('seo-item-10', 'pass', 'Tất cả headings H2, H3 là câu hỏi (?)', '100% headings H2/H3 đã có dấu ?');
          } else {
            setItem('seo-item-10', 'warn', 'Tất cả headings H2, H3 là câu hỏi (?)', 'Bổ sung dấu ? cho tất cả H2, H3');
          }

          // 11. Has Quote-box Featured Snippet
          if (/class=['"]quote-box['"]|quote-box/i.test(content)) {
            setItem('seo-item-11', 'pass', 'Có Quote-box Featured Snippet', 'Đã có Quote-box 40-60 từ tối ưu Featured Snippet');
          } else {
            setItem('seo-item-11', 'warn', 'Có Quote-box Featured Snippet', 'Bổ sung class=\'quote-box\' sau các H2');
          }

          // 12. Internal links count (>= 8 links)
          const linkMatches = content.match(/<a\s+[^>]*href=["'][^"']+["'][^>]*>|\[.*?\]\(.*?\)/gi) || [];
          const internalLinkCount = linkMatches.length;
          if (internalLinkCount >= 8) {
            setItem('seo-item-12', 'pass', `Số lượng internal links (Tối thiểu 8 links, hiện tại: ${internalLinkCount})`, 'Đã đủ 8 internal links phân bổ chuẩn');
          } else {
            setItem('seo-item-12', 'warn', `Số lượng internal links (Tối thiểu 8 links, hiện tại: ${internalLinkCount})`, 'Bổ sung thêm links liên kết');
          }

          // 13. Bold internal links (strong/bold)
          if (/<strong[^>]*>\s*<a|<a[^>]*>\s*<strong|<b>\s*<a|<a[^>]*>\s*<b>|\*\*\[.*?\]\(.*?\)\*\*/i.test(content)) {
            setItem('seo-item-13', 'pass', 'Có internal links được in đậm (strong/bold)', 'Đã bôi đậm internal links cho AI dễ quét');
          } else {
            setItem('seo-item-13', 'warn', 'Có internal links được in đậm (strong/bold)', 'Cần bôi đậm (strong) liên kết để AI dễ quét');
          }

          // Score badge update
          const scoreBadge = document.getElementById('seo-score-badge');
          if (scoreBadge) {
            scoreBadge.textContent = `${passedCount}/13 Tiêu chuẩn`;
            if (passedCount >= 10) {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-xs font-mono font-bold text-emerald-400';
            } else if (passedCount >= 5) {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-xs font-mono font-bold text-amber-400';
            } else {
              scoreBadge.className = 'px-2.5 py-1 rounded-full bg-rose-500/20 border border-rose-500/40 text-xs font-mono font-bold text-rose-400';
            }
          }
        } catch (err) {
          console.error('Realtime SEO analyzer calculation error:', err);
        }
      }

      function generateVietnameseSlug(str: string): string {
        return str
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .replace(/([^0-9a-z-\s])/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }

