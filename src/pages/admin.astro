---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { parseMarkdownFile } from '../utils/markdown';

const contentDir = path.resolve('./src/content');
const categories = ['ai', 'marketing', 'cuoc-song'];
const initialServerPosts: any[] = [];

for (const cat of categories) {
  const catDir = path.join(contentDir, cat);
  if (fs.existsSync(catDir)) {
    const files = fs.readdirSync(catDir).filter(f => f.endsWith('.md') || f.endsWith('.mdx'));
    for (const file of files) {
      const filePath = path.join(catDir, file);
      const parsed = parseMarkdownFile(filePath);
      if (parsed) {
        const slug = file.replace(/\.mdx?$/, '');
        let formattedPubDate = '';
        if (parsed.pubDate) {
          try {
            const d = new Date(parsed.pubDate);
            if (!isNaN(d.getTime())) {
              const year = d.getFullYear();
              const month = String(d.getMonth() + 1).padStart(2, '0');
              const day = String(d.getDate()).padStart(2, '0');
              const hours = String(d.getHours()).padStart(2, '0');
              const minutes = String(d.getMinutes()).padStart(2, '0');
              formattedPubDate = `${year}-${month}-${day} ${hours}:${minutes}`;
            }
          } catch (e) {}
        }
        initialServerPosts.push({
          id: `${cat}/${slug}`,
          slug: slug,
          category: cat,
          title: parsed.title,
          description: parsed.description,
          pubDate: formattedPubDate || new Date().toISOString().split('T')[0] + ' 09:00',
          status: parsed.status,
          draft: parsed.draft,
          author: parsed.author,
          tags: parsed.tags,
          content: parsed.content,
          image: parsed.image
        });
      }
    }
  }
}

initialServerPosts.sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
