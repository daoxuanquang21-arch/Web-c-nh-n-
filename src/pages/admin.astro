              <td colspan="5" class="p-8 text-center text-slate-500">Không tìm thấy bài viết nào.</td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = filtered.map(post => {
          const tagsStr = post.tags && post.tags.length > 0
            ? post.tags.map((t: string) => `<span class="px-2 py-0.5 rounded bg-slate-800 text-[10px] text-slate-300 font-mono">${t}</span>`).join(' ')
            : '<span class="text-slate-600 text-xs">-</span>';

          const catBadgeClass = post.category === 'ai' 
            ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' 
            : post.category === 'marketing'
            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
            : 'bg-blue-500/10 text-blue-400 border border-blue-500/20';

          const isScheduled = post.pubDate && new Date(post.pubDate).getTime() > Date.now();
          const statusBadge = post.status === 'private' || post.draft
            ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20">🔒 Riêng tư</span>'
            : isScheduled
            ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20">⏰ Hẹn giờ đăng</span>'
            : '<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">🌐 Công khai</span>';

          let formattedPubDate = post.pubDate || '';
          if (post.pubDate) {
            try {
              const d = new Date(post.pubDate);
              if (!isNaN(d.getTime())) {
                const datePart = d.toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit' });
                const timePart = d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                formattedPubDate = `${datePart} ${timePart}`;
              }
            } catch (e) {}
          }

          return `
            <tr class="hover:bg-slate-900/20 transition-all">
              <td class="p-4 font-bold text-slate-200">
                <div class="flex items-center gap-2 mb-1">
                  <span class="block text-base">${post.title}</span>
                  ${statusBadge}
                </div>
                <span class="text-xs font-mono text-slate-500 font-normal">slug: ${post.slug}</span>
              </td>
              <td class="p-4">
                <span class="px-2 py-1 rounded text-xs font-bold uppercase tracking-wider ${catBadgeClass}">
                  ${post.category}
                </span>
              </td>
              <td class="p-4 font-mono text-xs text-slate-300 font-semibold">${formattedPubDate}</td>
              <td class="p-4 flex flex-wrap gap-1 items-center max-w-[200px]">${tagsStr}</td>
              <td class="p-4 text-right">
                <div class="flex gap-2 justify-end">
                  <button data-id="${post.id}" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold transition-all edit-post-btn cursor-pointer">Sửa</button>
                  <button onclick="window.deletePostItem('${post.id}', '${post.category}', '${post.slug}')" data-id="${post.id}" data-category="${post.category}" data-slug="${post.slug}" class="px-3 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-400 text-xs font-bold transition-all delete-post-btn cursor-pointer">Xóa</button>
                </div>
              </td>
            </tr>
          `;
        }).join('');

        // Attach action events
        attachPostEvents();
      };

