          if (act.type === 'order') {
            icon = '💳';
            badgeClass = 'text-amber-400 bg-amber-500/10';
          } else if (act.type === 'lead') {
            icon = '🤝';
            badgeClass = 'text-emerald-400 bg-emerald-500/10';
          }

          let timeStr = '';
          try {
            timeStr = act.date.toLocaleDateString('vi-VN', {
              hour: '2-digit',
              minute: '2-digit'
            });
          } catch (_) {
            timeStr = '';
          }

          return `
            <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-slate-800/20 transition-all border border-transparent hover:border-slate-800/40">
              <span class="text-lg p-2 rounded-lg ${badgeClass}">${icon}</span>
              <div class="flex-grow space-y-0.5">
                <p class="text-xs font-bold text-slate-200">
                  ${act.name} <span class="font-normal text-slate-400">(${act.email})</span>
                </p>
                <p class="text-[11px] text-slate-400">${act.desc}</p>
                <span class="text-[9px] text-slate-500 font-mono block">${timeStr}</span>
              </div>
            </div>
          `;
        }).join('');
