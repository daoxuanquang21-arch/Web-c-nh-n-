          let serverPosts: any[] = [];
          try {
            const postsRes = await fetch('/api/posts?t=' + Date.now());
            if (postsRes.ok) {
              const contentType = postsRes.headers.get('content-type') || '';
              if (contentType.includes('application/json')) {
                const data = await postsRes.json();
                if (data && data.success && Array.isArray(data.posts) && data.posts.length > 0) {
                  serverPosts = data.posts;
                }
              }
            }
          } catch(e) {}

          const customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
          
          // ANY post returned by serverPosts or defaultPosts is an ACTIVE REAL POST on the server.
          // It MUST ALWAYS be displayed in Admin, and NEVER hidden by stale localStorage!
          const activeServerSlugs = new Set();
          defaultPosts.forEach((p: any) => {
            if (p.slug) activeServerSlugs.add(p.slug);
            if (p.id) activeServerSlugs.add(p.id);
            if (p.category && p.slug) activeServerSlugs.add(`${p.category}/${p.slug}`);
          });
          serverPosts.forEach((p: any) => {
            if (p.slug) activeServerSlugs.add(p.slug);
            if (p.id) activeServerSlugs.add(p.id);
            if (p.category && p.slug) activeServerSlugs.add(`${p.category}/${p.slug}`);
          });

          // Clean up deleted_post_slugs in localStorage
          let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
          deletedSlugs = deletedSlugs.filter((s: string) => 
            !activeServerSlugs.has(s) && 
            !activeServerSlugs.has(s.replace(/\.mdx?$/, ''))
          );
          localStorage.setItem('deleted_post_slugs', JSON.stringify(deletedSlugs));

          // Also clean up custom_saved_posts so it doesn't override real server posts with stale data
          let customPostsArr = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
          customPostsArr = customPostsArr.filter((p: any) => 
            p && p.slug && !activeServerSlugs.has(p.slug) && !deletedSlugs.includes(p.slug)
          );
          localStorage.setItem('custom_saved_posts', JSON.stringify(customPostsArr));

          const mergedMap = new Map();
          defaultPosts.forEach((p: any) => { if (p && p.slug) mergedMap.set(p.slug, p); });
          serverPosts.forEach((p: any) => { if (p && p.slug) mergedMap.set(p.slug, p); });
          customPostsArr.forEach((p: any) => { if (p && p.slug && !mergedMap.has(p.slug)) mergedMap.set(p.slug, p); });

          currentPosts = Array.from(mergedMap.values());
          renderPosts();

          // 2. Fetch Subscribers
          try {
            localStorage.removeItem('deleted_sub_emails');
            const subRes = await fetch('/api/subscribe?t=' + Date.now());
            if (subRes.ok && (subRes.headers.get('content-type') || '').includes('application/json')) {
              const data = await subRes.json();
              if (data && data.success && Array.isArray(data.subscribers)) {
                currentSubscribers = data.subscribers;
              }
            }
          } catch (e) {}
          renderSubscribers();

          // 3. Fetch Leads
          try {
            localStorage.removeItem('deleted_lead_emails');
            const leadsRes = await fetch('/api/leads?t=' + Date.now());
            if (leadsRes.ok && (leadsRes.headers.get('content-type') || '').includes('application/json')) {
              const data = await leadsRes.json();
              if (data && data.success && Array.isArray(data.leads)) {
                currentLeads = data.leads;
              }
            }
          } catch (e) {}
          renderLeads();

          // 4. Fetch Products
          try {
            const prodRes = await fetch('/api/products?t=' + Date.now());
            if (prodRes.ok && (prodRes.headers.get('content-type') || '').includes('application/json')) {
              const data = await prodRes.json();
              if (data && data.success && Array.isArray(data.products)) {
                currentProducts = data.products;
              }
            }
          } catch (e) {}
          renderProducts();

          // 5. Fetch Orders (CRM)
          try {
            const ordRes = await fetch('/api/orders?t=' + Date.now());
            if (ordRes.ok && (ordRes.headers.get('content-type') || '').includes('application/json')) {
              const data = await ordRes.json();
              if (data && data.success && Array.isArray(data.orders)) {
                currentOrders = data.orders;
              }
            }
          } catch (e) {}
          renderOrders();

          // 6. Update Stats Overview counts
          updateOverviewStats();
        } catch (error) {
          console.error('Error loading API data:', error);
        }
      };

      function updateOverviewStats() {
        const postsCount = document.getElementById('stat-posts-count');
        const subsCount = document.getElementById('stat-subscribers-count');
        const leadsCount = document.getElementById('stat-leads-count');
        const prodsCount = document.getElementById('stat-products-count');
        const ordersCount = document.getElementById('stat-orders-count');
        const revenueTotal = document.getElementById('stat-revenue-total');
        const ordersNavBadge = document.getElementById('orders-nav-badge');

        const validLeads = currentLeads.filter(l => l && (l.position || l.problem || (!l.product && (l.contact || l.phone))));
        if (postsCount) postsCount.textContent = String(currentPosts.length);
        if (subsCount) subsCount.textContent = String(currentSubscribers.length);
        if (leadsCount) leadsCount.textContent = String(validLeads.length);
        if (prodsCount) prodsCount.textContent = String(currentProducts.length);
        if (ordersCount) ordersCount.textContent = String(currentOrders.length);
        if (ordersNavBadge) ordersNavBadge.textContent = String(currentOrders.length);

        let totalRev = 0;
        currentOrders.forEach((o: any) => {
          if (o.status === 'Đã thanh toán' || o.status === 'Đã hoàn tất') {
            const rawAmt = String(o.amount || '0').replace(/[^0-9]/g, '');
            const num = parseInt(rawAmt, 10) || 0;
            totalRev += num;
          }
        });
        if (revenueTotal) revenueTotal.textContent = totalRev > 0 ? totalRev.toLocaleString('vi-VN') + 'đ' : '0đ';

        // Render Recent Activity Feed
        renderRecentActivity();
      }

      function renderRecentActivity() {
        const list = document.getElementById('recent-activity-list');
        if (!list) return;

        const allActivities: any[] = [];

        currentSubscribers.forEach(sub => {
          allActivities.push({
            type: 'sub',
            name: sub.name || 'Độc giả',
            email: sub.email,
            date: new Date(sub.date),
            desc: `đăng ký bản tin từ trang chủ.`
          });
        });

        currentOrders.forEach(ord => {
          const orderDate = ord.timestamp ? new Date(ord.timestamp) : new Date(ord.date);
          allActivities.push({
            type: 'order',
            name: ord.customerName || ord.name || 'Khách hàng',
            email: ord.email,
            date: isNaN(orderDate.getTime()) ? new Date() : orderDate,
            desc: `đặt mua "${ord.product || 'Ebook'}" (${ord.amount || '299.000đ'}).`
          });
        });

        const validLeads = currentLeads.filter(l => l && (l.position || l.problem || (!l.product && (l.contact || l.phone))));
        validLeads.forEach(lead => {
          allActivities.push({
            type: 'lead',
            name: lead.name || 'Học viên',
            email: lead.email,
            date: new Date(lead.date),
            desc: `đăng ký khảo sát nhận chuyển giao hệ thống 1-1.`
          });
        });

        // Sort by date desc
        allActivities.sort((a, b) => b.date.getTime() - a.date.getTime());

        if (allActivities.length === 0) {
          list.innerHTML = `
            <div class="text-center py-6 text-slate-500 text-xs">
              Chưa ghi nhận hoạt động nào gần đây.
            </div>
