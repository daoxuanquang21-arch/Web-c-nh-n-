            ? post.tags.map((t: string) => `<span class="px-2 py-0.5 rounded bg-slate-800 text-[10px] text-slate-300 font-mono">${t}</span>`).join(' ')
            : '<span class="text-slate-600 text-xs">-</span>';

          const catBadgeClass = post.category === 'ai' 
