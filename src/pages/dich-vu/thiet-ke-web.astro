        <div class="p-8 rounded-2xl bg-white border border-brand-danger/20 shadow-sm">
          <h3 class="text-xl font-bold text-brand-danger mb-6 flex items-center gap-2"><span class="text-2xl">✗</span> Tôi sẽ từ chối nếu:</h3>
          <ul class="space-y-4 text-sm sm:text-base text-brand-text">
            <li class="flex items-start gap-2"><span class="text-brand-danger font-bold">✗</span><span>Bạn muốn làm website giá rẻ chắp vá, không coi trọng chất lượng hiển thị và trải nghiệm khách hàng.</span></li>
            <li class="flex items-start gap-2"><span class="text-brand-danger font-bold">✗</span><span>Bạn chỉ muốn bán hàng ăn xổi trên mạng xã hội mà không muốn đầu tư bài bản cho tài sản số lâu dài.</span></li>
            <li class="flex items-start gap-2"><span class="text-brand-danger font-bold">✗</span><span>Bạn không sẵn lòng dành ra 1 giờ đồng hồ để xem tài liệu SOP hướng dẫn để làm chủ website.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-24 pb-12 bg-brand-paper border-b border-brand-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <!-- Contact Form Box -->
        <div id="contact" class="p-8 sm:p-12 rounded-3xl bg-white border border-brand-line shadow-md scroll-mt-24">
          <div class="text-center max-w-2xl mx-auto mb-8">
            <h3 class="text-2xl sm:text-3xl font-bold text-brand-navy-deep">Bắt đầu sở hữu website chuyên nghiệp của bạn</h3>
            <p class="text-sm sm:text-base text-brand-text mt-2">Hãy để lại thông tin liên hệ, tôi sẽ trực tiếp tư vấn lộ trình xây dựng website thương hiệu tối ưu nhất cho bạn trong 24h.</p>
          </div>
          <form action="https://formspree.io/f/xvggpzoz" method="POST" class="space-y-6 max-w-xl mx-auto">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-xs font-bold text-brand-navy-deep uppercase tracking-wider mb-2">Họ & Tên *</label>
                <input type="text" name="name" id="name" required class="w-full px-4 py-3 rounded-lg border border-brand-line focus:outline-none focus:border-brand-green bg-brand-paper text-sm" placeholder="Nguyễn Văn A">
              </div>
              <div>
                <label for="phone" class="block text-xs font-bold text-brand-navy-deep uppercase tracking-wider mb-2">Số điện thoại / Zalo *</label>
                <input type="tel" name="phone" id="phone" required class="w-full px-4 py-3 rounded-lg border border-brand-line focus:outline-none focus:border-brand-green bg-brand-paper text-sm" placeholder="0987654321">
              </div>
            </div>
            <div>
              <label for="email" class="block text-xs font-bold text-brand-navy-deep uppercase tracking-wider mb-2">Địa chỉ Email *</label>
              <input type="email" name="email" id="email" required class="w-full px-4 py-3 rounded-lg border border-brand-line focus:outline-none focus:border-brand-green bg-brand-paper text-sm" placeholder="name@company.com">
            </div>
            <div>
              <label for="message" class="block text-xs font-bold text-brand-navy-deep uppercase tracking-wider mb-2">Thông tin dự án / Mong muốn của bạn</label>
              <textarea name="message" id="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-brand-line focus:outline-none focus:border-brand-green bg-brand-paper text-sm" placeholder="Hãy chia sẻ ngắn gọn về lĩnh vực kinh doanh của bạn hoặc mong muốn đối với website mới..."></textarea>
            </div>
            <button type="submit" class="w-full py-4 rounded-xl bg-brand-green hover:bg-brand-green-dark text-white font-bold text-base transition-all transform hover:scale-[1.01] shadow-md">Đăng Ký Tư Vấn Ngay &rarr;</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white border-b border-brand-line">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-navy-deep tracking-tight leading-snug"><span class="inline-block">Các câu hỏi thường gặp</span> <span class="inline-block">trước khi bắt đầu</span></h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white rounded-2xl border border-brand-line p-6 shadow-sm [&_summary::-webkit-details-marker]:hidden transition-all duration-300">
            <summary class="flex items-center justify-between gap-4 font-bold text-base sm:text-lg text-brand-navy-deep cursor-pointer select-none">
              <div class="flex-1 text-left" set:html={faq.question}></div>
              <span class="shrink-0 transition-transform duration-300 group-open:rotate-180">
                <svg class="h-5 w-5 text-brand-text" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 text-sm sm:text-base text-brand-text leading-relaxed border-t border-brand-line pt-4 text-left" set:html={faq.answer}></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Dynamic JSON-LD FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />
</Layout>
