    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-navy-deep tracking-tight">Các câu hỏi thường gặp trước khi bắt đầu</h2>
      </div>

      <div class="space-y-4 max-w-3xl mx-auto">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-brand-paper border border-brand-line shadow-sm faq-item transition-all duration-200">
            <button class="w-full text-left flex justify-between items-center focus:outline-none faq-toggle group" aria-expanded="false">
              <h3 class="text-base sm:text-lg font-bold text-brand-navy-deep pr-4 group-hover:text-brand-green transition-colors">
                {faq.question}
              </h3>
              <svg class="w-5 h-5 text-brand-text transform transition-transform duration-200 faq-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <p class="text-sm text-brand-text leading-relaxed mt-4 pt-4 border-t border-brand-line/50" set:html={faq.answer}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    function initFaq() {
      const faqToggles = document.querySelectorAll('.faq-toggle');
      faqToggles.forEach(toggle => {
        if (toggle.getAttribute('data-faq-initialized')) return;
        toggle.setAttribute('data-faq-initialized', 'true');

        toggle.addEventListener('click', () => {
          const item = toggle.closest('.faq-item');
          if (!item) return;
          const answer = item.querySelector('.faq-answer') as HTMLElement;
          const icon = item.querySelector('.faq-icon');
          
          const isOpen = item.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          
          if (isOpen) {
            answer.style.maxHeight = answer.scrollHeight + 'px';
            if (icon) icon.classList.add('rotate-180');
          } else {
            answer.style.maxHeight = '0px';
            if (icon) icon.classList.remove('rotate-180');
          }
        });
      });
    }

    initFaq();
    document.addEventListener('astro:page-load', initFaq);
  </script>

</Layout>
