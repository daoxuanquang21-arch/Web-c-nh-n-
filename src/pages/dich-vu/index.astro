---
import Layout from '../../layouts/Layout.astro';

const services = [
  {
    title: 'Thiết kế Website chuẩn SEO',
    description: 'Xây dựng website tối ưu SEO, giao diện độc bản chuyên nghiệp, nâng cao trải nghiệm người dùng và tỷ lệ chuyển đổi.',
    link: '/dich-vu/thiet-ke-web',
    icon: '💻'
  },
  {
    title: 'Đào tạo & Chuyển giao',
    description: 'Chương trình đào tạo thực chiến về AI, tự động hóa và Growth Marketing trực tiếp cho doanh nghiệp hoặc cá nhân.',
    link: '/dich-vu/dao-tao',
    icon: '🎓'
  }
];
---

<Layout title="Dịch Vụ | daoxuanquang.com.vn" description="Các dịch vụ thiết kế web tối giản và đào tạo thực chiến.">
  <section class="py-8 sm:py-16 px-4 sm:px-6 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-brand-green/10 text-brand-green dark:bg-brand-green/20 dark:text-brand-green mb-3 uppercase tracking-wider">
        ⚡ DỊCH VỤ & GIẢI PHÁP
      </span>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-brand-navy-deep dark:text-white mb-3">
        <span class="inline-block">Dịch Vụ</span> <span class="inline-block">Chuyên Nghiệp</span>
      </h1>
      <p class="text-sm sm:text-base md:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Giúp bạn xây dựng website chuyên nghiệp và làm chủ quy trình vận hành tự động thông qua chuyển giao thực chiến.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16 max-w-4xl mx-auto">
      {services.map(service => (
        <div class="p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-xl hover:border-brand-green dark:hover:border-brand-green transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-brand-green/10 dark:bg-brand-green/20 flex items-center justify-center text-2xl mb-4 shadow-sm group-hover:scale-105 transition-transform">
              {service.icon}
            </div>
            <h2 class="text-xl sm:text-2xl font-bold mb-3 text-brand-navy-deep dark:text-white group-hover:text-brand-green transition-colors">
              {service.title}
            </h2>
            <p class="text-slate-600 dark:text-slate-400 mb-6 leading-relaxed text-sm sm:text-base">
              {service.description}
            </p>
          </div>
          
          <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80">
            <a 
              href={service.link} 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-brand-green text-white font-bold text-sm hover:bg-brand-green-dark transition-all shadow-md group-hover:shadow-lg"
            >
              <span>Tìm hiểu chi tiết</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
