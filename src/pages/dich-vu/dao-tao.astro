  <script>
    const initLeadsForm = () => {
      const form = document.querySelector('#contact-form form') as HTMLFormElement;
      if (!form) return;



      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Get fields
        const nameInput = document.getElementById('name') as HTMLInputElement;
        const contactInput = document.getElementById('contact') as HTMLInputElement;
        const emailInput = document.getElementById('email') as HTMLInputElement;
        const positionInput = document.getElementById('position') as HTMLSelectElement;
        const commitmentInput = document.getElementById('commitment') as HTMLSelectElement;
        const problemInput = document.getElementById('problem') as HTMLTextAreaElement;

        if (!nameInput || !contactInput || !emailInput || !positionInput || !commitmentInput || !problemInput) return;

        const payload = {
          name: nameInput.value,
          contact: contactInput.value,
          email: emailInput.value,
          position: positionInput.value,
          commitment: commitmentInput.value,
          problem: problemInput.value
        };

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalText = submitBtn ? submitBtn.textContent : 'Gửi thông tin khảo sát đăng ký &rarr;';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Đang gửi thông tin...';
        }

        try {
          // 1. Submit to local leads API
          await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          
          // 2. Submit to Formspree in background
          const formData = new FormData(form);
          await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });
        } catch (err) {
          console.error('Leads submit error:', err);
        }

        // Show success state
        const parent = form.parentElement;
        if (parent) {
          parent.innerHTML = `
            <div class="text-center py-12 space-y-6">
              <div class="inline-flex items-center justify-center h-20 w-20 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 text-4xl font-bold mb-2">✓</div>
              <div class="space-y-2">
                <h3 class="text-3xl font-extrabold text-brand-navy-deep">Gửi thông tin thành công!</h3>
                <p class="text-base text-brand-text max-w-xl mx-auto leading-relaxed">
                  Cảm ơn <strong>${payload.name}</strong> đã hoàn thành bản khảo sát. Tôi sẽ xem xét kỹ bài toán của bạn và phản hồi trực tiếp lịch hẹn qua Zalo/Email trong vòng 24 giờ tới.
                </p>
              </div>
            </div>
          `;
        }
      });
    };
    initLeadsForm();
    document.addEventListener('astro:page-load', initLeadsForm);
  </script>
