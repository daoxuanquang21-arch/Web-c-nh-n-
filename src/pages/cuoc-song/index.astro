---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('cuoc-song');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Góc Nhìn Cuộc Sống | daoxuanquang.com.vn" description="Chia sẻ suy ngẫm cá nhân, triết lý sống tối giản và hành trình phát triển bản thân.">
  <section class="py-16 px-4 max-w-7xl mx-auto">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 text-slate-900 dark:text-white">Góc Nhìn Cuộc Sống</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Chậm lại một nhịp giữa thế giới vội vã để chiêm nghiệm về cuộc sống, nuôi dưỡng nội lực và tự do tâm trí.
      </p>
    </div>

    <div class="posts-grid-container grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map((post) => (
        <article data-post-slug={post.id} class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden">
          <div>
            {post.data.image && (
              <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
                <img 
                  src={post.data.image} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                />
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('vi-VN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>•</span>
                <span class="font-semibold text-gold-accent">Cuộc sống</span>
              </div>

              <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                <a href={`/cuoc-song/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6">
            <a href={`/cuoc-song/${post.id}`} class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
              Đọc tiếp &rarr;
            </a>
          </div>
        </article>
      ))}

      {sortedPosts.length === 0 && (
        <div class="posts-empty-state col-span-full p-8 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center text-slate-500">
          Đang cập nhật các bài viết mới...
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      // 1. Sanitize deleted_post_slugs in localStorage
      let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
      const broadCategories = ['cuoc-song', 'marketing', 'ai'];
      const cleanedDeletedSlugs = deletedSlugs.filter((s: string) => !broadCategories.includes(s));
      if (cleanedDeletedSlugs.length !== deletedSlugs.length) {
        localStorage.setItem('deleted_post_slugs', JSON.stringify(cleanedDeletedSlugs));
        deletedSlugs = cleanedDeletedSlugs;
      }

      // 2. Hide deleted posts cleanly with exact match
      if (deletedSlugs.length > 0) {
        document.querySelectorAll('[data-post-slug]').forEach(el => {
          const fullId = el.getAttribute('data-post-slug') || '';
          const slugOnly = fullId.split('/').pop() || '';
          if (deletedSlugs.includes(fullId) || deletedSlugs.includes(slugOnly)) {
            el.remove();
          }
        });
      }

      // 3. Render custom posts saved from Admin
      const customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
      const categoryPosts = customPosts.filter((p: any) => p.category === 'cuoc-song' && !deletedSlugs.includes(p.slug) && !deletedSlugs.includes(p.id));
      
      const gridContainer = document.querySelector('.posts-grid-container');
      const emptyStateContainer = document.querySelector('.posts-empty-state');

      if (categoryPosts.length > 0 && gridContainer) {
        if (emptyStateContainer) emptyStateContainer.remove();
        
        categoryPosts.forEach((post: any) => {
          const postSlug = post.slug || post.id?.split('/').pop() || '';
          if (!postSlug) return;

          const existingCard = document.querySelector(`[data-post-slug="${post.id}"]`) || document.querySelector(`[data-post-slug="${postSlug}"]`);
          if (existingCard) return;

          const articleEl = document.createElement('article');
          articleEl.setAttribute('data-post-slug', postSlug);
          articleEl.className = 'rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden';
          
          const pubDateObj = post.pubDate ? new Date(post.pubDate) : new Date();
          const formattedDate = pubDateObj.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' });

          const imageHtml = post.image ? `
            <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
              <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
            </div>
          ` : '';

          articleEl.innerHTML = `
            <div>
              ${imageHtml}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                  <time datetime="${pubDateObj.toISOString()}">${formattedDate}</time>
                  <span>•</span>
                  <span class="font-semibold text-gold-accent">Cuộc sống</span>
                </div>
                <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                  <a href="/cuoc-song/${postSlug}">${post.title}</a>
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">${post.description}</p>
              </div>
            </div>
            <div class="px-6 pb-6">
              <a href="/cuoc-song/${postSlug}" class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
                Đọc tiếp &rarr;
              </a>
            </div>
          `;
          gridContainer.prepend(articleEl);
        });
      }
    } catch (e) {
      console.error('Render cuoc-song posts error:', e);
    }
  });
</script>
