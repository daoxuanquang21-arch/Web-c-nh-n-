---
import Layout from '../../layouts/Layout.astro';
import { getPostsByCategory } from '../../utils/markdown';

const normalizeTextServer = (s: string) => {
  return (s || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[đĐ]/g, 'd')
    .toLowerCase()
    .replace(/[^a-z0-9]/g, '');
};

const posts = getPostsByCategory('cuoc-song');
const seenSSGTitles = new Set();
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(p => {
    const nt = normalizeTextServer(p.data.title);
    if (!nt) return false;
    for (let t of Array.from(seenSSGTitles) as string[]) {
      if (t === nt || (t.length > 10 && (t.indexOf(nt) !== -1 || nt.indexOf(t) !== -1))) return false;
    }
    seenSSGTitles.add(nt);
    return true;
  });

const postsPerPage = 6;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1') || 1;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
const activePage = Math.max(1, Math.min(currentPage, totalPages || 1));

const startIndex = (activePage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = sortedPosts.slice(startIndex, endIndex);

const formatCleanTitle = (t: string) => {
  if (!t) return '';
  const lettersOnly = t.replace(/[^a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/g, '');
  if (lettersOnly.length > 5 && lettersOnly === lettersOnly.toUpperCase()) {
    let lower = t.toLowerCase();
    lower = lower.charAt(0).toUpperCase() + lower.slice(1);
    return lower.replace(/\b(ai|seo|sop|hot|vps|ui|ux|ads|cpm|cpc)\b/gi, (m) => m.toUpperCase());
  }
  return t;
};
---

<Layout title="Góc Nhìn Cuộc Sống | daoxuanquang.com.vn" description="Chia sẻ suy ngẫm cá nhân, triết lý sống tối giản và hành trình phát triển bản thân.">
  <section class="py-16 px-4 max-w-7xl mx-auto">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-brand-green/10 text-brand-green dark:bg-brand-green/20 dark:text-brand-green mb-3 uppercase tracking-wider">
        🌱 CUỘC SỐNG & CHIÊM NGHIỆM
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 text-brand-navy-deep dark:text-white">Góc Nhìn Cuộc Sống</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Chậm lại một nhịp giữa thế giới vội vã để chiêm nghiệm về cuộc sống, nuôi dưỡng nội lực và tự do tâm trí.
      </p>
    </div>

    <div class="posts-grid-container grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {paginatedPosts.map((post) => (
        <article data-post-slug={post.id} data-post-title={post.data.title} class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden">
          <div>
            {post.data.image && (
              <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
                <img 
                  src={post.data.image} 
                  alt={formatCleanTitle(post.data.title)} 
                  class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                />
              </div>
            )}
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('vi-VN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>•</span>
                <span class="font-semibold text-gold-accent">Cuộc sống</span>
              </div>

              <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                <a href={`/cuoc-song/${post.id.replace(/\.mdx?$/, '')}`}>
                  {formatCleanTitle(post.data.title)}
                </a>
              </h2>
              
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                {post.data.description}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6">
            <a href={`/cuoc-song/${post.id.replace(/\.mdx?$/, '')}`} class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
              Đọc tiếp &rarr;
            </a>
          </div>
        </article>
      ))}

      {paginatedPosts.length === 0 && (
        <div class="posts-empty-state col-span-full p-8 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl text-center text-slate-500">
          Đang cập nhật các bài viết mới...
        </div>
      )}
    </div>

    {totalPages > 1 && (
      <div class="flex justify-center items-center gap-2 mt-12 pt-6 border-t border-slate-100 dark:border-slate-800">
        {activePage > 1 ? (
          <a
            href={`?page=${activePage - 1}`}
            class="px-4 py-2 text-sm font-semibold rounded-xl bg-slate-100 dark:bg-dark-surface hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors"
          >
            &larr; Trang trước
          </a>
        ) : (
          <span class="px-4 py-2 text-sm font-semibold rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-300 dark:text-slate-700 cursor-not-allowed">
            &larr; Trang trước
          </span>
        )}

        <div class="flex items-center gap-1.5">
          {Array.from({ length: totalPages }).map((_, i) => {
            const pageNum = i + 1;
            const isCurrent = pageNum === activePage;
            return (
              <a
                href={`?page=${pageNum}`}
                class={`px-3.5 py-2 text-sm font-bold rounded-xl transition-all duration-150 ${
                  isCurrent
                    ? 'bg-brand-green text-white shadow-sm'
                    : 'bg-slate-100 dark:bg-dark-surface hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'
                }`}
              >
                {pageNum}
              </a>
            );
          })}
        </div>

        {activePage < totalPages ? (
          <a
            href={`?page=${activePage + 1}`}
            class="px-4 py-2 text-sm font-semibold rounded-xl bg-slate-100 dark:bg-dark-surface hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition-colors"
          >
            Trang sau &rarr;
          </a>
        ) : (
          <span class="px-4 py-2 text-sm font-semibold rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-300 dark:text-slate-700 cursor-not-allowed">
            Trang sau &rarr;
          </span>
        )}
      </div>
    )}
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const formatCleanTitle = (t: string) => {
        if (!t) return '';
        const lettersOnly = t.replace(/[^a-zA-ZÁÀẢẢÃẠĂẮẰẲẴẶÂẤẦẨẪẬĐÉÈẺẼẸÊẾỀỂỄỆÍÌỈĨỊÓÒỎÕỌÔỐỒỔỖỘƠỚỜỞỠỢÚÙỦŨỤƯỨỪỬỮỰÝỲỶỸỊ]/g, '');
        if (lettersOnly.length > 5 && lettersOnly === lettersOnly.toUpperCase()) {
          let lower = t.toLowerCase();
          lower = lower.charAt(0).toUpperCase() + lower.slice(1);
          return lower.replace(/\b(ai|seo|sop|hot|vps|ui|ux|ads|cpm|cpc)\b/gi, (m) => m.toUpperCase());
        }
        return t;
      };

      const normalizeText = (s: string) => {
        return (s || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[đĐ]/g, 'd')
          .toLowerCase()
          .replace(/[^a-z0-9]/g, '');
      };

      // 1. Sanitize deleted_post_slugs in localStorage
      let deletedSlugs = JSON.parse(localStorage.getItem('deleted_post_slugs') || '[]');
      const broadCategories = ['cuoc-song', 'marketing', 'ai'];
      const cleanedDeletedSlugs = deletedSlugs.filter((s: string) => !broadCategories.includes(s));
      if (cleanedDeletedSlugs.length !== deletedSlugs.length) {
        localStorage.setItem('deleted_post_slugs', JSON.stringify(cleanedDeletedSlugs));
        deletedSlugs = cleanedDeletedSlugs;
      }

      // Collect existing card identifiers from actual DOM h2 text and normalize slug matching
      const existingNormalizedTitles = new Set();
      const existingNormalizedSlugs = new Set();
      document.querySelectorAll('.posts-grid-container article').forEach(el => {
        const fullId = el.getAttribute('data-post-slug') || '';
        const slugOnly = fullId.split('/').pop() || '';
        const h2Text = el.querySelector('h2')?.textContent || '';
        
        const normFullId = normalizeText(fullId);
        const normSlugOnly = normalizeText(slugOnly);
        const normTitle = normalizeText(h2Text);

        const isDeleted = deletedSlugs.some((del: string) => {
          const normDel = normalizeText(del);
          return normDel && (
            normDel === normFullId ||
            normDel === normSlugOnly ||
            normDel === normTitle ||
            (normDel.length > 8 && normTitle.includes(normDel)) ||
            (normDel.length > 8 && normFullId.includes(normDel))
          );
        });

        if (isDeleted) {
          el.remove();
        } else {
          // Check if custom_saved_posts has updated pubDate or title for existing DOM card
          const customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
          const matchingCustom = customPosts.find((p: any) => {
            const ps = normalizeText(p.slug || p.id);
            const pt = normalizeText(p.title);
            return (ps && (ps === normSlugOnly || ps === normFullId)) || (pt && pt === normTitle);
          });

          if (matchingCustom && matchingCustom.pubDate) {
            const timeEl = el.querySelector('time');
            if (timeEl) {
              const pubDateObj = new Date(matchingCustom.pubDate);
              if (!isNaN(pubDateObj.getTime())) {
                timeEl.setAttribute('datetime', pubDateObj.toISOString());
                timeEl.textContent = pubDateObj.toLocaleDateString('vi-VN', { day: '2-digit', month: 'long', year: 'numeric' });
              }
            }
          }

          if (fullId) existingNormalizedSlugs.add(normFullId);
          if (slugOnly) existingNormalizedSlugs.add(normSlugOnly);
          if (h2Text) existingNormalizedTitles.add(normTitle);
        }
      });

      // 3. Render custom posts saved from Admin for this category that are not already in the DOM
      let customPosts = JSON.parse(localStorage.getItem('custom_saved_posts') || '[]');
      const categoryPosts = customPosts.filter((p: any) => {
        if (!p || p.category !== 'cuoc-song') return false;
        const pSlug = p.slug || p.id?.split('/').pop() || '';
        const normSlug = normalizeText(pSlug);
        const normTitle = normalizeText(p.title);

        if (deletedSlugs.includes(pSlug) || deletedSlugs.includes(p.id)) return false;

        const isAlreadyInDom = Array.from(existingNormalizedTitles).some((t: any) => 
          t === normTitle || (normTitle && t && (normTitle.indexOf(t) !== -1 || t.indexOf(normTitle) !== -1))
        ) || Array.from(existingNormalizedSlugs).some((s: any) => 
          s === normSlug || (normSlug && s && (normSlug.indexOf(s) !== -1 || s.indexOf(normSlug) !== -1))
        );

        return !isAlreadyInDom;
      });

      const gridContainer = document.querySelector('.posts-grid-container');
      const emptyStateContainer = document.querySelector('.posts-empty-state');

      const urlParams = new URLSearchParams(window.location.search);
      const currentPageNum = parseInt(urlParams.get('page') || '1') || 1;

      if (currentPageNum === 1 && categoryPosts.length > 0 && gridContainer) {
        if (emptyStateContainer) emptyStateContainer.remove();
        
        categoryPosts.forEach((post: any) => {
          const postSlug = post.slug || post.id?.split('/').pop() || '';
          if (!postSlug) return;

          const articleEl = document.createElement('article');
          articleEl.setAttribute('data-post-slug', postSlug);
          articleEl.className = 'rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-200 group flex flex-col justify-between overflow-hidden';
          
          const pubDateObj = post.pubDate ? new Date(post.pubDate) : new Date();
          const formattedDate = pubDateObj.toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' });
          const cleanTitle = formatCleanTitle(post.title);

          const imageHtml = post.image ? `
            <div class="aspect-video w-full overflow-hidden border-b border-slate-100 dark:border-slate-800 bg-slate-100 dark:bg-slate-900">
              <img src="${post.image}" alt="${cleanTitle}" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
            </div>
          ` : '';

          articleEl.innerHTML = `
            <div>
              ${imageHtml}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
                  <time datetime="${pubDateObj.toISOString()}">${formattedDate}</time>
                  <span>•</span>
                  <span class="font-semibold text-gold-accent">Cuộc sống</span>
                </div>
                <h2 class="text-2xl font-bold mb-3 text-slate-900 dark:text-white group-hover:text-gold-accent transition-colors">
                  <a href="/cuoc-song/${postSlug}">${cleanTitle}</a>
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">${post.description}</p>
              </div>
            </div>
            <div class="px-6 pb-6">
              <a href="/cuoc-song/${postSlug}" class="inline-flex items-center text-sm font-semibold text-brand-600 dark:text-brand-500 hover:underline">
                Đọc tiếp &rarr;
              </a>
            </div>
          `;
          gridContainer.prepend(articleEl);
        });
      }

      // 4. Limit to strictly at most 6 posts per page
      if (gridContainer) {
        const articles = gridContainer.querySelectorAll('article');
        if (articles.length > 6) {
          for (let i = 6; i < articles.length; i++) {
            articles[i].remove();
          }
        }
      }
    } catch (e) {
      console.error('Render cuoc-song posts error:', e);
    }
  });
</script>
