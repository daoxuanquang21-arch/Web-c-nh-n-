---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
---

<Layout title="Sản Phẩm & Công Cụ | daoxuanquang.com.vn" description="Các công cụ, hệ thống SaaS và sản phẩm số được tối ưu hóa cho Marketing và tăng trưởng doanh nghiệp.">
  <section class="py-16 px-4 max-w-7xl mx-auto">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-mono font-bold bg-brand-green/10 text-brand-green dark:bg-brand-green/20 dark:text-brand-green mb-3 uppercase tracking-wider">
        🛠️ SẢN PHẨM & CÔNG CỤ SỐ
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 text-brand-navy-deep dark:text-white">Sản Phẩm & Công Cụ Số</h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Các giải pháp tự động hóa, SaaS tinh gọn và tài nguyên số giúp tối ưu quy trình kinh doanh và gia tăng hiệu suất.
      </p>
    </div>

    <!-- Products Grid -->
    {products.length === 0 ? (
      <div class="text-center py-12 text-slate-500 dark:text-slate-400">
        Hiện chưa có sản phẩm nào. Vui lòng quay lại sau!
      </div>
    ) : (
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        {products.map(product => (
          <div data-id={product.id} class="product-card p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
            <div>
              {product.image && (
                <div class="w-full aspect-video rounded-xl overflow-hidden mb-4 bg-slate-100 dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80">
                  <img src={product.image} alt={product.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
              )}
              <div class="flex items-center justify-between mb-4">
                {product.image ? null : <span class="text-3xl">{product.icon}</span>}
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${
                  product.status === 'Nội bộ' 
                    ? 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
                    : product.status === 'Sắp ra mắt'
                    ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-400'
                    : 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/30 dark:text-indigo-400'
                }`}>
                  {product.status}
                </span>
              </div>
              
              <p class="text-xs text-brand-600 dark:text-brand-400 font-bold uppercase tracking-wider mb-1">
                {product.type}
              </p>
              <h2 class="text-xl font-bold mb-3 group-hover:text-brand-600 dark:group-hover:text-brand-500 transition-colors" style="text-wrap: wrap;">
                {product.title}
              </h2>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                {product.description}
              </p>
            </div>

            <div class="flex items-center justify-between mb-4 pt-4 border-t border-slate-100 dark:border-slate-800/60">
              <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Giá bán:</span>
              <span class="text-sm font-bold text-slate-950 dark:text-white">{product.price || 'Liên hệ'}</span>
            </div>
            {product.status === 'Sắp ra mắt' ? (
              <button class="w-full py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors">
                Đăng ký nhận thông tin
              </button>
            ) : product.status === 'Nội bộ' ? (
              <button class="w-full py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors">
                Chỉ dùng nội bộ
              </button>
            ) : (
              <a 
                href={`https://zalo.me/0702286928?text=${encodeURIComponent(`Chào bạn, mình muốn tìm hiểu về sản phẩm: ${product.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors hover:text-brand-green"
              >
                Trải nghiệm ngay
              </a>
            )}
          </div>
        ))}
      </div>
    )}

    <script>
      (function() {
        const grid = document.querySelector('.grid');
        if (!grid) return;

        // 1. Purge deleted products
        const deletedIds = JSON.parse(localStorage.getItem('deleted_product_ids') || '[]');
        if (deletedIds.length > 0) {
          document.querySelectorAll('.product-card').forEach(card => {
            const id = card.getAttribute('data-id');
            if (id && deletedIds.includes(id)) {
              (card as HTMLElement).style.display = 'none';
            }
          });
        }

        // 2. Render custom added products from Admin
        const customProducts = JSON.parse(localStorage.getItem('custom_products') || '[]');
        if (Array.isArray(customProducts) && customProducts.length > 0) {
          const existingIds = Array.from(document.querySelectorAll('.product-card')).map(c => c.getAttribute('data-id'));
          customProducts.forEach(product => {
            if (!product.id || existingIds.includes(product.id) || deletedIds.includes(product.id)) return;

            const card = document.createElement('div');
            card.setAttribute('data-id', product.id);
            card.className = 'product-card p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-dark-surface hover:shadow-lg transition-all duration-300 flex flex-col justify-between group';
            
            const badgeClass = product.status === 'Nội bộ' 
              ? 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
              : product.status === 'Sắp ra mắt'
              ? 'bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-400'
              : 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/30 dark:text-indigo-400';

            let actionHtml = '';
            if (product.status === 'Sắp ra mắt') {
              actionHtml = `<button class="w-full py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors">Đăng ký nhận thông tin</button>`;
            } else if (product.status === 'Nội bộ') {
              actionHtml = `<button class="w-full py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors">Chỉ dùng nội bộ</button>`;
            } else {
              const zaloUrl = `https://zalo.me/0702286928?text=${encodeURIComponent(`Chào bạn, mình muốn tìm hiểu về sản phẩm: ${product.title || ''}`)}`;
              actionHtml = `<a href="${zaloUrl}" target="_blank" rel="noopener noreferrer" class="block w-full text-center py-2.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-900 text-sm font-semibold transition-colors hover:text-brand-green">Trải nghiệm ngay</a>`;
            }

            const imageHtml = product.image
              ? `<div class="w-full aspect-video rounded-xl overflow-hidden mb-4 bg-slate-100 dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80">
                  <img src="${product.image}" alt="${product.title || ''}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>`
              : '';
            const iconHtml = product.image ? '' : `<span class="text-3xl">${product.icon || '📦'}</span>`;

            card.innerHTML = `
              <div>
                ${imageHtml}
                <div class="flex items-center justify-between mb-4">
                  ${iconHtml}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full ${badgeClass}">
                    ${product.status || 'Đang hoạt động'}
                  </span>
                </div>
                <p class="text-xs text-brand-600 dark:text-brand-400 font-bold uppercase tracking-wider mb-1">
                  ${product.type || 'Sản phẩm'}
                </p>
                <h2 class="text-xl font-bold mb-3 group-hover:text-brand-600 dark:group-hover:text-brand-500 transition-colors" style="text-wrap: wrap;">
                  ${product.title || ''}
                </h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
                  ${product.description || ''}
                </p>
              </div>

              <div class="flex items-center justify-between mb-4 pt-4 border-t border-slate-100 dark:border-slate-800/60">
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">Giá bán:</span>
                <span class="text-sm font-bold text-slate-950 dark:text-white">${product.price || 'Liên hệ'}</span>
              </div>
              
              ${actionHtml}
            `;
            grid.appendChild(card);
          });
        }
      })();
    </script>
  </section>
</Layout>
