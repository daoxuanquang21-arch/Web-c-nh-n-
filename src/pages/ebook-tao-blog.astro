/* Chồng ảnh bằng chứng: gạt qua lại */

(function(){

  var wrap=document.getElementById('stack-cards'); if(!wrap) return;

  var cards=[].slice.call(wrap.querySelectorAll('.sc')), n=cards.length, cur=0;

  var count=document.getElementById('sn-count');

  var small=function(){return innerWidth<640;};

  function layout(){

    var k=small()?0.6:1;

    cards.forEach(function(c,i){

      var pos=(i-cur+n)%n; c.classList.remove('dragging');

      var t,z,o=1;

      if(pos===0){t='translate(0,0) rotate(0) scale(1)';z=10;}

      else if(pos===1){t='translate('+28*k+'px,'+14*k+'px) rotate(3deg) scale(.95)';z=9;}

      else if(pos===2){t='translate('+52*k+'px,'+26*k+'px) rotate(6deg) scale(.9)';z=8;}

      else if(pos===n-1){t='translate('+(-28*k)+'px,'+14*k+'px) rotate(-3deg) scale(.95)';z=7;}

      else {t='translate(0,30px) scale(.85)';z=1;o=0;}

      c.style.transform=t; c.style.zIndex=z; c.style.opacity=o;

      c.setAttribute('aria-hidden',pos===0?'false':'true');

      c.querySelector('.proof-img').tabIndex=pos===0?0:-1;

    });

    if(count) count.textContent=(cur+1)+' / '+n;

  }

  function go(d){cur=(cur+d+n)%n;layout();}

  var pv=document.getElementById('sn-prev'); if(pv) pv.addEventListener('click',function(){go(-1);});

  var nx=document.getElementById('sn-next'); if(nx) nx.addEventListener('click',function(){go(1);});

  wrap.addEventListener('keydown',function(e){if(e.key==='ArrowRight')go(1);if(e.key==='ArrowLeft')go(-1);});

  var sx=0,dx=0,active=null,moved=false,pid=null;

  wrap.addEventListener('pointerdown',function(e){

    var c=e.target.closest('.sc'); if(!c||cards.indexOf(c)!==cur) return;

    active=c;sx=e.clientX;dx=0;moved=false;pid=e.pointerId;

  });

  wrap.addEventListener('pointermove',function(e){

    if(!active) return; dx=e.clientX-sx; if(!moved&&Math.abs(dx)>6){moved=true;active.classList.add('dragging');try{active.setPointerCapture(pid);}catch(_){}} if(!moved) return;

    active.style.transform='translate('+dx+'px,0) rotate('+dx/25+'deg)';

  });

  function end(){

    if(!active) return; var c=active; active=null;

    if(Math.abs(dx)>80){ go(dx<0?1:-1); } else { layout(); }

  }

  wrap.addEventListener('pointerup',end); wrap.addEventListener('pointercancel',end);

  /* chặn mở ảnh khi vừa gạt */

  wrap.addEventListener('click',function(e){ if(moved){e.stopPropagation();e.preventDefault();moved=false;} },true);

  addEventListener('resize',layout);

  layout();

})();

/* Nút sao chép prompt minh họa */

(function(){

  var b=document.getElementById('copy-demo'); if(!b) return;

  b.addEventListener('click',function(){

    var t=document.getElementById('demo-prompt').innerText, lbl=b.querySelector('span');

    function ok(){lbl.textContent='Đã sao chép';setTimeout(function(){lbl.textContent='Sao chép';},1800);}

    if(navigator.clipboard){navigator.clipboard.writeText(t).then(ok,ok);}else{var r=document.createRange();r.selectNodeContents(document.getElementById('demo-prompt'));var sel=getSelection();sel.removeAllRanges();sel.addRange(r);try{document.execCommand('copy');}catch(e){}ok();}

  });

})();

