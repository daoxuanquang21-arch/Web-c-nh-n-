---
import MetaPixel from '../components/MetaPixel.astro';
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Làm Website Bằng AI</title>
<meta name="description" content="Tự tay dựng một website chạy thật trên tên miền riêng bằng AI, không cần code: sao chép prompt, dán vào Agent Coding và làm theo.">
<meta property="og:type" content="website">
<meta property="og:title" content="Làm Website Bằng AI">
<meta property="og:description" content="Cách đơn giản để tự dựng website chạy thật trên tên miền của bạn bằng AI, không cần biết code.">
<meta name="theme-color" content="#14183E">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Crect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%23B8532F%22/%3E%3Ctext x=%2250%22 y=%2268%22 font-size=%2254%22 text-anchor=%22middle%22 fill=%22white%22 font-family=%22Arial%22 font-weight=%22bold%22%3EB%3C/text%3E%3C/svg%3E">
<MetaPixel />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-03YQDCZWTY"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400;1,800&family=Patrick+Hand&family=Dancing+Script:wght@700&display=swap" rel="stylesheet">
<style is:global is:inline>

:root{--navy:#14183E;--navy2:#1B2155;--ink:#1F2340;--txt:#3B3F5C;--green:#22C55E;--green-d:#16A34A;--blue:#3B82F6;--hl:#FFE94D;
--h:'Montserrat',system-ui,sans-serif;--hand:'Patrick Hand','Comic Sans MS',cursive;--ps:'Dancing Script',cursive;--cond:'AntonVN','Anton','Oswald',sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--h);color:var(--txt);background:#fff;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
p{margin:0 0 14px}
h1,h2,h3{margin:0;font-family:var(--h);color:var(--ink);text-wrap:balance}
.w{max-width:1040px;margin:0 auto;padding:0 20px}
.sec{padding:56px 0}
.grid{background-color:#FBFBFD;background-image:linear-gradient(#EEF0F6 1px,transparent 1px),linear-gradient(90deg,#EEF0F6 1px,transparent 1px);background-size:22px 22px}
.attn{background:#1F1F1F;color:#E5E7EB;text-align:center;font-size:12.5px;letter-spacing:.06em;padding:9px 14px;line-height:1.5}
.attn b{color:var(--hl);text-decoration:underline;text-underline-offset:3px;margin-right:6px}
/* HERO */
.hero{padding-top:36px}
h1{font-weight:900;font-size:clamp(28px,4.4vw,46px);line-height:1.3;text-align:center;max-width:960px;margin:0 auto}
.new{background:linear-gradient(90deg,#38BDF8,#3B82F6);-webkit-background-clip:text;background-clip:text;color:transparent;margin-right:8px}
.hero-sub{text-align:center;font-style:italic;font-size:20px;margin:14px 0 28px}
.stage{display:grid;grid-template-columns:150px minmax(0,1fr) 150px;gap:14px;align-items:center;max-width:960px;margin:0 auto}
.sk-col{display:flex;flex-direction:column;gap:12px}
.sk{position:relative;background:#fff;border:1px solid #E5E7EB;box-shadow:3px 4px 0 #D1D5DB;padding:14px 10px 10px;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center}
.sk.t1{transform:rotate(-2deg)}.sk.t2{transform:rotate(1.5deg)}.sk.t3{transform:rotate(-1deg)}.sk.t4{transform:rotate(2deg)}
.sk-n{position:absolute;top:6px;left:8px;width:22px;height:22px;border-radius:50%;background:#1F2937;color:#fff;font-size:12px;font-weight:800;display:grid;place-items:center}
.r .sk-n{left:auto;right:8px}
.sk-i{width:42px;height:42px}
.sk-t{font-family:var(--hand);font-size:17px;line-height:1.15;color:#1F2937;text-transform:uppercase}
.screen{box-shadow:0 18px 40px rgba(20,24,62,.25)}
.screen-bar{background:#3B82F6;color:#fff;font-size:12.5px;font-weight:700;text-align:center;padding:6px}
.screen-in{background:radial-gradient(circle at 30% 20%,#2B3A8C,#14183E 70%);min-height:340px;display:grid;place-items:center;padding:30px}
/* book */
.book{position:relative;width:200px;aspect-ratio:3/4;transform:perspective(900px) rotateY(-18deg);filter:drop-shadow(12px 16px 18px rgba(0,0,0,.35))}
.book-spine{position:absolute;left:-14px;top:3px;bottom:3px;width:16px;background:linear-gradient(90deg,#1E3A8A,#3B82F6);transform:skewY(-12deg)}
.book-cover{position:absolute;inset:0;background:linear-gradient(160deg,#FFFFFF 0%,#EFF6FF 60%,#DBEAFE 100%);border-left:6px solid #F97316;padding:16px 14px;display:flex;flex-direction:column;gap:4px}
.bk-k{font-size:10px;font-weight:800;letter-spacing:.2em;color:#F97316}
.bk-t{font-weight:900;font-size:22px;line-height:1.15;color:#1E3A8A}
.bk-s{font-family:var(--hand);font-size:18px;color:#16A34A}
.bk-ill{width:100%;margin-top:auto}
.bk-a{font-size:9px;font-weight:700;color:#64748B;letter-spacing:.06em;text-transform:uppercase;margin-top:6px}
.book-sm{width:120px}.book-sm .bk-t{font-size:13px}.book-sm .bk-s{font-size:12px}.book-sm .bk-k,.book-sm .bk-a{font-size:7px}
.book-band{width:220px}
.book-fan{position:absolute;left:50%;bottom:0;transform:translateX(-50%) perspective(900px) rotateY(-10deg);width:150px;z-index:20}
.book-fan .bk-t{font-size:16px}.book-fan .bk-s{font-size:14px}
/* offer bar */
.offerbar{display:flex;align-items:center;gap:0;max-width:640px;margin:34px auto 0;position:relative}
.offerbar .book-sm{flex:none;z-index:2;margin-right:-24px}
.ob-in{flex:1;background:var(--navy);color:#fff;border-radius:4px;padding:16px 18px 16px 40px;text-align:center;box-shadow:0 10px 26px rgba(20,24,62,.25)}
.ob-t{font-size:14.5px;line-height:1.5;margin-bottom:10px}
.ob-t b{color:#FBBF24}
/* green button */
.gbtn{display:inline-flex;flex-direction:column;align-items:center;background:var(--green);color:#fff;text-decoration:none;padding:12px 30px;border-radius:2px;box-shadow:0 4px 0 var(--green-d);line-height:1.25;text-align:center;max-width:100%}
.gbtn:hover{background:var(--green-d)}
.gb-main{display:inline-flex;align-items:center;gap:10px;font-weight:800;font-size:19px;letter-spacing:.01em}
.gb-sub{font-weight:400;font-size:15px;opacity:.92;margin-top:4px}
.cart{width:24px;height:24px;flex:none}
.gbtn-xl{padding:18px 44px}.gbtn-xl .gb-main{font-size:24px}.gbtn-xl .gb-sub{font-size:19px}
.squig{display:block;width:300px;max-width:70%;margin:10px auto 0}
.h-navy{font-weight:900;font-size:clamp(26px,3.6vw,38px);line-height:1.3;text-align:center;max-width:860px;margin:24px auto 12px}
.lead{text-align:center;max-width:720px;margin:0 auto 22px;font-size:18px}
/* split / fan */
.split{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px;align-items:center;max-width:900px;margin:0 auto}
.split .gbtn{margin-top:6px}
.fan{position:relative;height:270px}
.fan-c{position:absolute;left:50%;bottom:20px;width:96px;height:150px;margin-left:-48px;transform-origin:50% 160%;transform:rotate(var(--r));background:var(--c);border-radius:4px;box-shadow:0 4px 10px rgba(0,0,0,.18);display:flex;align-items:flex-start;justify-content:center;padding:10px 6px}
.fan-c span{color:#fff;font-weight:800;font-size:10px;text-align:center;line-height:1.2;text-transform:uppercase}
.checks{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-direction:column;gap:10px}
.checks li{position:relative;padding-left:30px;font-weight:700;color:var(--ink)}
.checks li::before{content:"";position:absolute;left:4px;top:5px;width:8px;height:14px;border:solid var(--green);border-width:0 3px 3px 0;transform:rotate(40deg)}
/* three */
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;text-align:center;max-width:900px;margin:48px auto 10px}
.circ{display:grid;place-items:center;width:52px;height:52px;margin:0 auto 10px;border-radius:50%;border:3px solid #3B82F6;font-weight:900;font-size:26px;color:var(--ink);background:#fff;box-shadow:inset 0 -6px 0 #DBEAFE}
.three b{color:var(--ink);font-size:17px;line-height:1.4}
/* proof */
.script{font-family:var(--hand);color:var(--green);font-size:clamp(46px,6vw,64px);line-height:1;text-align:center;margin:44px 0 0}
.cond{font-family:var(--cond);font-weight:400;text-transform:uppercase;font-size:clamp(46px,7vw,76px);line-height:1.2;text-align:center;color:var(--ink);margin:0 0 18px}
.cases{display:flex;flex-direction:column;gap:22px;max-width:900px;margin:0 auto}
.case{background:#fff;border:1px solid #E5E7EB;box-shadow:0 8px 22px rgba(20,24,62,.08);padding:20px 22px 18px}
.case-hd{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.case-no{background:var(--navy);color:#fff;font-weight:900;font-size:13px;letter-spacing:.08em;padding:6px 10px}
.case-av{width:56px;height:56px;border-radius:50%;object-fit:cover;border:3px solid var(--green)}
.case-who{display:flex;flex-direction:column;line-height:1.35;flex:1;min-width:180px}
.case-who b{font-size:18px;color:var(--ink);font-weight:800}
.case-who span{font-size:14px;color:#6B7280}
.case-res{text-align:right;line-height:1.3}
.case-res b{display:block;font-weight:900;font-size:20px;color:var(--green-d)}
.case-res span{font-size:13px;color:#6B7280}
.case-story{font-size:15.5px;margin:14px 0 14px;padding:12px 16px;background:#FFFBEB;border-left:3px solid #FACC15;color:var(--ink)}
.case-story p{margin:0 0 8px}.case-story p:last-child{margin:0}
.case-story q{display:block;font-family:var(--hand);font-size:24px;color:var(--green-d);quotes:"“" "”";margin:6px 0}
.case-story i{color:#7C2D12}
.case-ic{background:none}
.case-shots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.case-shots figure{margin:0}
.case-shots.one{grid-template-columns:minmax(0,1fr)}
.case-shots.one .pf{height:auto;max-height:none;padding:0;border:0}
.case-shots.one .pf img{max-height:none;width:100%}
.case-shots .pf{height:270px;border:1px solid #E5E7EB;background:#fff;padding:6px;overflow:hidden;min-width:0}
.case-shots .pf img{display:block;max-width:100%;max-height:256px;width:auto;height:auto;min-width:0;object-fit:contain}
.case-shots figcaption{font-size:14.5px;font-weight:700;line-height:1.35;text-align:center;color:#4B5563;margin-top:6px}
mark{background:var(--hl);color:inherit;padding:1px 4px}
.fine{text-align:center;font-size:13px;color:#6B7280;margin:14px 0 22px}
.hero .w>.gbtn,.sec .w>.gbtn{display:flex;width:fit-content;margin:0 auto}
/* warning */
.warn-wrap{background:linear-gradient(#FBFBFD 50%,var(--navy) 50%);padding:30px 20px}
.warn{position:relative;max-width:640px;margin:0 auto;background:#fff;padding:52px 34px 30px;text-align:center;border:12px solid transparent;border-image:repeating-linear-gradient(45deg,#111 0 12px,#FACC15 12px 24px) 12}
.warn-tag{position:absolute;top:-34px;left:50%;transform:translateX(-50%);background:#111;color:#FACC15;font-family:'Courier New',monospace;font-weight:700;font-size:30px;letter-spacing:.12em;padding:8px 22px;border:3px solid #FACC15;white-space:nowrap}
.wq{font-size:20px;color:var(--txt)}
.wb{font-size:22px;font-weight:800;color:var(--ink);line-height:1.45;margin:0}
/* navy */
.navy{background:var(--navy);color:#E5E7EB}
.on-navy{color:#C7CBE6}
.bio{display:grid;grid-template-columns:300px minmax(0,1fr);gap:40px;align-items:center;max-width:860px;margin:0 auto}
.polaroid{background:#fff;padding:12px 12px 40px;transform:rotate(-3deg);box-shadow:0 14px 30px rgba(0,0,0,.4)}
.polaroid img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}
.bio-t p{color:#E5E7EB;font-size:18px}
.bio-t b{color:#fff}
.bio-t .strong{color:#fff;font-weight:800;font-size:19px}
.on-navy.script{color:var(--green)}
.h-white{color:#fff;font-weight:900;font-size:clamp(26px,3.6vw,38px);line-height:1.3;text-align:center;max-width:860px;margin:6px auto 12px}
.h-white.left{text-align:left;margin-left:0}
.h-white.sm{font-size:clamp(20px,2.6vw,28px);margin-bottom:0}
.h-green{color:var(--green);font-weight:900;font-size:clamp(28px,4vw,42px);line-height:1.25;text-align:center;max-width:860px;margin:6px auto 12px}
.small{font-size:15px}
.demo{max-width:760px;margin:22px auto 26px;box-shadow:0 18px 40px rgba(0,0,0,.4)}
.demo-bar{background:var(--green);color:#fff;font-size:13px;font-weight:700;text-align:center;padding:6px}
.demo-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);background:#111}
.demo-l{padding:22px;display:flex;flex-direction:column;gap:4px;color:#111;background:#FACC15;clip-path:polygon(0 0,100% 0,88% 100%,0 100%);padding-right:40px}
.dl-k{font-family:var(--hand);font-size:18px;color:#7C2D12;margin-top:8px}
.demo-l b{font-size:15px;line-height:1.35}
.demo-r{margin:0;padding:22px;color:#E5E7EB;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13.5px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
/* how */
.how{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:40px;align-items:center;max-width:860px;margin:10px auto 0}
.how-t p{font-size:16.5px}
.how-t .it{font-style:italic;font-weight:800;font-size:22px;color:var(--ink);line-height:1.35}
.how-t .big{font-size:19px;color:var(--ink)}
.post{background:#fff;border:1px solid #E5E7EB;box-shadow:0 18px 36px rgba(20,24,62,.18);max-width:320px;transform:rotate(-2deg);justify-self:center}
.post-h{display:flex;gap:8px;align-items:center;padding:10px 12px;font-size:13px;font-weight:700;color:var(--ink);line-height:1.2}
.post-h img{border-radius:50%;object-fit:cover}
.post-h small{font-weight:400;color:#6B7280}
.post-b{background:var(--navy2);color:#fff;padding:22px 18px;display:flex;flex-direction:column;gap:10px}
.post-b b{font-family:var(--cond);font-weight:400;font-size:30px;line-height:1.2}
.post-b span{font-size:13px;color:#C7CBE6}
.post-f{display:flex;justify-content:space-around;font-size:12px;color:#6B7280;padding:8px}
/* band */
.band .split{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}
.band-art{display:grid;place-items:center}
/* steps */
.step{display:grid;grid-template-columns:minmax(0,1fr) 110px minmax(0,1fr);gap:20px;align-items:center;max-width:860px;margin:30px auto}
.step.rev .step-art{order:3}.step.rev .step-n{order:2}.step.rev .step-t{order:1;text-align:right}
.step-art{display:flex;justify-content:center;gap:12px}
.step-art .sk-i{width:84px;height:84px;background:#fff;border:1px solid #E5E7EB;box-shadow:4px 5px 0 #DBEAFE;padding:12px;border-radius:10px}
.step-n{position:relative;text-align:center;line-height:.9}
.step-n small{display:block;font-weight:900;font-size:22px;color:#93A5D9}
.step-n b{font-family:var(--cond);font-weight:400;font-size:110px;color:var(--ink);-webkit-text-stroke:0}
.step-t h3{font-weight:900;font-size:24px;margin-bottom:8px}
.step-t p{font-size:16px;margin:0}
/* phone */
.phone{width:260px;margin:26px auto 0;background:#fff;border-radius:34px;border:10px solid #E5E7EB;box-shadow:0 20px 50px rgba(0,0,0,.45);padding:10px 12px 18px;display:flex;flex-direction:column;gap:10px}
.ph-notch{width:80px;height:6px;border-radius:3px;background:#D1D5DB;margin:0 auto}
.ph-url{background:#F3F4F6;border-radius:999px;font-size:12px;color:#374151;text-align:center;padding:5px}
.ph-hero{background:linear-gradient(135deg,#1E3A8A,#3B82F6);border-radius:12px;color:#fff;padding:22px 14px;display:flex;flex-direction:column;gap:2px}
.ph-hero b{font-size:18px;color:#fff}.ph-hero span{font-size:12px;color:#DBEAFE}
.ph-row{height:9px;border-radius:5px;background:#E5E7EB}.ph-row.s{width:65%}
.ph-cards{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ph-cards i{height:60px;border-radius:8px;background:#EFF6FF;border:1px solid #DBEAFE}
.ph-btn{background:var(--green);color:#fff;text-align:center;font-weight:700;font-size:13px;border-radius:8px;padding:8px}
/* buy */
.pill-y{display:table;margin:10px auto 24px;background:#FEF3C7;color:#C2410C;font-weight:800;font-size:20px;padding:8px 22px}
.buy{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px;max-width:860px;margin:0 auto;align-items:start}
.guar h3{font-weight:800;font-size:20px;margin:0 0 10px}
.guar p{font-size:16px}
.seal{display:flex;align-items:center;margin-top:16px}
.seal-b{flex:none;width:96px;height:110px;background:linear-gradient(#22C55E,#15803D);clip-path:polygon(0 0,100% 0,100% 80%,50% 100%,0 80%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;z-index:2}
.seal-b span{font-size:10px;font-weight:800;letter-spacing:.06em}.seal-b b{font-size:30px;line-height:1.1;font-weight:900}
.seal-r{flex:1;background:linear-gradient(90deg,#FACC15,#FDE047);clip-path:polygon(0 0,92% 0,100% 50%,92% 100%,0 100%);margin-left:-10px;padding:16px 30px 16px 22px;font-size:17px;color:#111;line-height:1.3}
.form2{background:#fff;border:2px solid #1D4ED8;border-radius:14px;box-shadow:0 18px 40px rgba(20,24,62,.14);overflow:hidden}
.f-head{background:#1D4ED8;color:#fff;text-align:center;padding:16px 18px;display:flex;flex-direction:column;gap:2px}
.f-head b{font-size:21px;font-weight:900}
.f-head span{font-size:14px;color:#DBEAFE}
.f-steps{display:grid;grid-template-columns:1fr 1fr;background:#F8FAFC}
.f-steps>div{display:flex;gap:10px;align-items:center;padding:14px 16px;color:#94A3B8}
.f-steps b{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:15px;background:#E2E8F0;color:#64748B;flex:none}
.f-steps .on b{background:#1D4ED8;color:#fff}
.f-steps span{font-size:12px;font-weight:800;line-height:1.3;letter-spacing:.03em}
.f-steps .on span{color:#1D4ED8}
.f-steps small{font-weight:500;color:#94A3B8;letter-spacing:0}
.f-bar{height:4px;background:#E2E8F0}.f-bar i{display:block;width:50%;height:100%;background:#1D4ED8}
.f-prod{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px dashed #E2E8F0}
.book-xs{width:54px;flex:none;filter:drop-shadow(4px 6px 6px rgba(0,0,0,.25))}
.book-xs .book-cover{padding:5px 4px;gap:1px;border-left-width:3px}.book-xs .book-spine{left:-6px;width:7px}
.book-xs .bk-k,.book-xs .bk-a,.book-xs .bk-ill{display:none}
.book-xs .bk-t{font-size:8px}.book-xs .bk-s{font-size:7px}
.fp-t{flex:1;display:flex;flex-direction:column;line-height:1.35}
.fp-t b{font-size:16px;color:var(--ink);font-weight:800}
.fp-t span{font-size:13px;color:#64748B}
.fp-p{font-weight:900;font-size:20px;color:var(--ink)}
.f-inc{list-style:none;margin:0;padding:12px 18px 4px;display:flex;flex-direction:column;gap:7px;background:#F0FDF4}
.f-inc li{position:relative;padding-left:24px;font-size:14px;line-height:1.45;color:var(--ink)}
.f-inc li::before{content:"";position:absolute;left:4px;top:3px;width:6px;height:11px;border:solid var(--green-d);border-width:0 2.5px 2.5px 0;transform:rotate(40deg)}
.f-inc{padding-bottom:12px}
.f-body{padding:16px 18px 18px}
.field{display:flex;flex-direction:column;gap:6px;margin:0 0 12px}
.field label{font-size:14px;font-weight:700;color:var(--ink)}
.inp{position:relative}
.fi-ic{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:19px;height:19px;color:#94A3B8;pointer-events:none}
.inp input{width:100%;height:52px;border:1.5px solid #CBD5E1;border-radius:10px;background:#fff;padding:0 14px 0 44px;font:inherit;font-size:16px;color:var(--ink);transition:border-color .15s,box-shadow .15s}
.inp input:focus{outline:none;border-color:#3B82F6;box-shadow:0 0 0 4px rgba(59,130,246,.15)}
.inp input[aria-invalid="true"]{border-color:#DC2626}
.err{color:#B91C1C;font-size:13px}
.f-total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #E2E8F0;padding:14px 2px 12px;margin-top:4px}
.f-total span{font-size:15px;font-weight:700;color:#475569}
.f-total b{font-size:26px;font-weight:900;color:var(--green-d)}
.gsubmit{display:flex;flex-direction:column;align-items:center;gap:2px;width:100%;margin:0;background:var(--green);color:#fff;border:0;border-radius:10px;font:inherit;padding:18px 12px;cursor:pointer;box-shadow:0 5px 0 var(--green-d);transition:transform .1s}
.gsubmit span{display:inline-flex;align-items:center;gap:10px;font-weight:900;font-size:20px;letter-spacing:.01em}
.gsubmit .cart{width:24px;height:24px}
.gsubmit small{font-size:13.5px;opacity:.92}
.gsubmit:hover{background:var(--green-d)}
.gsubmit:active{transform:translateY(3px);box-shadow:0 2px 0 var(--green-d)}
.ok{margin:12px 0 0;color:#15803D;font-weight:700;font-size:14px;text-align:center}
.trust{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;margin-top:14px;font-size:12.5px;color:#64748B}
.trust span{display:inline-flex;align-items:center;gap:6px}
.trust svg{width:15px;height:15px;color:var(--green-d)}
/* ps */
.ps-sec{background:#FEF9E3}
.ps-h{font-family:var(--ps);font-weight:700;font-size:clamp(26px,3.4vw,36px);line-height:1.35;text-align:center;color:var(--ink);max-width:820px;margin:0 auto 26px}
.ps-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:34px;align-items:start;max-width:820px;margin:0 auto}
.ps-grid p{font-size:16.5px;color:var(--ink)}
.ps-grid mark{display:inline;background:linear-gradient(transparent 55%,#FDE68A 55%);font-weight:700;padding:0 2px}
.ps-photo img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border:6px solid #fff;box-shadow:0 10px 24px rgba(0,0,0,.18)}
.ps-cta{text-align:center;font-weight:800;font-size:21px;color:var(--ink);margin:28px auto 20px;max-width:560px}
footer{background:#111;color:#D1D5DB;font-size:13px;padding:30px 0 34px}
footer a{color:#fff}
.ft{display:flex;justify-content:space-between;gap:24px;align-items:center;flex-wrap:wrap}
.ft p{margin:0 0 8px;max-width:620px}
.ft-logo{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:.12em;color:#fff}
.ft-logo span{width:38px;height:38px;border:2px solid #fff;border-radius:50%;display:grid;place-items:center;font-size:13px;letter-spacing:0}
.lightbox{position:fixed;inset:0;z-index:60;background:rgba(10,10,20,.9);display:grid;place-items:center;padding:20px;cursor:zoom-out}
.lightbox[hidden]{display:none}
.lightbox img{max-width:min(960px,100%);max-height:90vh;background:#fff;padding:8px}
@media (max-width:820px){
  .stage{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .screen{grid-column:1/-1;order:-1}
  .split,.how,.bio,.buy,.ps-grid,.band .split{grid-template-columns:minmax(0,1fr)}
  .bio{justify-items:center}.polaroid{max-width:240px}
  .three{grid-template-columns:minmax(0,1fr)}
  .case-shots{grid-template-columns:minmax(0,1fr)}
  .case-shots .pf{height:230px}
  .case-res{text-align:left;width:100%}
  .step{grid-template-columns:90px minmax(0,1fr)}
  .step-art{display:none}
  .step.rev .step-t{order:2;text-align:left}
  .step.rev .step-n{order:1}
  .demo-l{clip-path:none;padding-right:22px}
  .step-n b{font-size:80px}
  .h-white.left{text-align:center}
  .band .w{text-align:center}
  .demo-in{grid-template-columns:minmax(0,1fr);background:#111}
  .demo-l{background:#FACC15}
  .warn-tag{font-size:22px}
  .offerbar{flex-direction:column}
  .offerbar .book-sm{margin:0 0 -18px}
  .ob-in{padding:28px 14px 16px}
  .gbtn{padding:12px 18px}.gb-main{font-size:17px}
  .gbtn-xl .gb-main{font-size:19px}
  .gsubmit span{font-size:15.5px}.gsubmit .cart{display:none}.gsubmit small{font-size:12.5px}.gbtn-xl .gb-sub{font-size:15px}
}
@font-face{font-family:'AntonVN';src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:normal;font-display:block}

.sepay-modal-overlay{position:fixed;inset:0;background:rgba(18,13,10,0.88);backdrop-filter:blur(8px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:12px;opacity:1;transition:opacity .25s ease}
.sepay-modal-overlay[hidden]{display:none!important}
.sepay-modal-card{background:#FFFDFB;border-radius:24px;border:1px solid #F5DECF;box-shadow:0 25px 60px rgba(0,0,0,0.45);max-width:680px;width:100%;max-height:92vh;overflow-y:auto;position:relative;animation:sepayModalPop .3s cubic-bezier(0.16,1,0.3,1);font-family:var(--body);color:#1F1915}
@keyframes sepayModalPop{from{opacity:0;transform:scale(0.95) translateY(12px)}to{opacity:1;transform:scale(1) translateY(0)}}
.sepay-modal-close{position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:50%;background:#F4EDE6;border:none;color:#55483F;font-size:22px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;z-index:10}
.sepay-modal-close:hover{background:#E8D8CC;color:#18110D;transform:rotate(90deg)}
.sepay-modal-header{padding:24px 22px 14px;text-align:center;border-bottom:1px solid #F4E8DF}
.sepay-badge-bank{display:inline-flex;align-items:center;gap:8px;background:#FDF3EC;color:#B8532F;font-weight:700;font-size:12.5px;padding:6px 14px;border-radius:999px;margin-bottom:8px;border:1px solid #FBDCCB}
.sepay-pulse-dot{width:8px;height:8px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 0 rgba(34,197,94,0.7);animation:sepayPulse 1.8s infinite}
@keyframes sepayPulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,0.7)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.sepay-title{font-family:var(--display);font-size:clamp(20px,2.4vw,25px);margin:0 0 6px;color:#1B130E;line-height:1.25}
.sepay-sub{font-size:13px;color:#6C5D53;margin:0 auto;max-width:520px;line-height:1.5}
.sepay-modal-body{display:grid;grid-template-columns:260px 1fr;gap:22px;padding:18px 22px 24px;align-items:start}
.sepay-qr-container{display:flex;flex-direction:column;align-items:center;gap:10px}
.sepay-qr-frame{position:relative;background:#fff;padding:12px;border-radius:20px;border:2px solid #EADBCE;box-shadow:0 10px 24px rgba(184,83,47,0.1);width:250px;height:250px;display:flex;align-items:center;justify-content:center}
.sepay-qr-frame img{width:100%;height:100%;object-fit:contain;border-radius:10px;display:block}
.sepay-btn-download{width:100%;max-width:250px;background:#F4EDE6;color:#2D221B;border:1px solid #D8C7B8;border-radius:10px;padding:9px 14px;font-size:12.5px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:all .15s}
.sepay-btn-download:hover{background:#E8D8CC;color:#000}
.sepay-qr-mobile-tip{font-size:11.5px;color:#78695E;line-height:1.4;background:#FAF6F2;padding:8px 10px;border-radius:8px;border:1px dashed #E2D1C2;text-align:center;max-width:250px}
.sepay-qr-status{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:#059669;background:#ECFDF5;padding:5px 12px;border-radius:999px;border:1px solid #A7F3D0}
.sepay-spin{animation:sepaySpin 1.4s linear infinite}
@keyframes sepaySpin{to{transform:rotate(360deg)}}
.sepay-details{display:flex;flex-direction:column;gap:8px}
.sepay-detail-row{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;background:#F9F4EE;border-radius:10px;font-size:13px}
.sepay-detail-row.highlight-code{background:#FEF3C7;border:1.5px dashed #F59E0B}
.sepay-detail-label{color:#6E6056;font-size:12.5px;font-weight:600}
.sepay-detail-val{display:flex;align-items:center;gap:8px}
.sepay-amount{color:#DC2626;font-size:16px;font-weight:800}
.sepay-code{font-family:monospace;font-size:15px;font-weight:800;color:#B45309;background:#FDE68A;padding:2px 8px;border-radius:6px;letter-spacing:1px}
.btn-copy{background:#EADBCE;border:none;border-radius:6px;padding:5px 9px;font-size:11.5px;font-weight:700;cursor:pointer;color:#3D3128;transition:all .2s;white-space:nowrap}
.btn-copy:hover{background:#D3BEAD;color:#000}
.btn-copy.copied{background:#10B981!important;color:#fff!important}
.sepay-commit-box{background:#ECFDF5;border:1px solid #A7F3D0;border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:#065F46;line-height:1.4}
.sepay-btn-zalo{display:flex;align-items:center;justify-content:center;gap:6px;background:#0068FF;color:#fff!important;text-decoration:none;font-weight:700;font-size:13px;padding:10px 16px;border-radius:10px;box-shadow:0 3px 10px rgba(0,104,255,0.25);transition:all .2s}
.sepay-btn-zalo:hover{background:#0056D2}
.sepay-tip-box{font-size:12px;line-height:1.45;color:#92400E;background:#FFFBEB;border:1px solid #FCD34D;border-radius:10px;padding:8px 12px}
.sepay-success-box{padding:40px 24px;text-align:center}
.sepay-success-icon{width:68px;height:68px;border-radius:50%;background:#10B981;color:#fff;font-size:36px;font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;box-shadow:0 12px 28px rgba(16,185,129,0.35)}
.sepay-success-title{font-family:var(--display);font-size:26px;color:#12100E;margin:0 0 10px}
.sepay-success-sub{font-size:14.5px;color:#4B3F36;margin:0 0 18px}
.sepay-success-info{background:#F7F1EB;border-radius:14px;padding:14px 18px;margin-bottom:22px;font-size:13.5px;line-height:1.6}
.sepay-actions{display:flex;justify-content:center;gap:12px}
.sepay-btn-primary{display:inline-flex;align-items:center;gap:8px;background:#B8532F;color:#fff!important;text-decoration:none;font-weight:800;font-size:15px;padding:12px 26px;border-radius:999px;box-shadow:0 8px 20px rgba(184,83,47,0.3);transition:transform .2s,background .2s}
.sepay-btn-primary:hover{background:#9E4222;transform:translateY(-2px)}
@media (max-width:640px){
  .sepay-modal-body{grid-template-columns:1fr;gap:16px;padding:14px 16px 20px}
  .sepay-qr-frame{width:250px;height:250px}
  .sepay-modal-header{padding:20px 16px 12px}
}



