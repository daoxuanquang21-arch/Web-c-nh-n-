/* Đồng hồ đếm ngược tới MỘT HẠN CHÓT THẬT, giống nhau với mọi người xem.

   Muốn đổi hạn: sửa DEADLINE (giờ Việt Nam, +07:00). Sau hạn chót, đồng hồ tự ẩn;

   nhớ cập nhật giá trên trang về giá gốc hoặc đặt hạn mới. */

(function(){

  var DEADLINE = new Date('2026-10-31T23:59:59+07:00');

  var pad=function(n){return String(n).padStart(2,'0');};

  var vn = new Date(DEADLINE.getTime()+7*3600*1000);

  var label = pad(vn.getUTCHours())+':'+pad(vn.getUTCMinutes())+' ngày '+vn.getUTCDate()+'/'+(vn.getUTCMonth()+1);

  document.querySelectorAll('[data-deadline]').forEach(function(e){e.textContent=label;});

  function set(sel,v){document.querySelectorAll(sel).forEach(function(e){e.textContent=v;});}

  var timer;

  function tick(){

    var left=Math.floor((DEADLINE-Date.now())/1000);

    if(left<=0){

      document.querySelectorAll('.cd').forEach(function(e){e.hidden=true;});

      document.querySelectorAll('.cd-over').forEach(function(e){e.hidden=false;});

      clearInterval(timer); return;

    }

    var d=Math.floor(left/86400);

    set('[data-dd]',d); set('[data-hh]',pad(Math.floor(left%86400/3600))); set('[data-mm]',pad(Math.floor(left%3600/60))); set('[data-ss]',pad(left%60));

    document.querySelectorAll('[data-dd]').forEach(function(e){e.style.display=d>0?'':'none'; if(e.nextSibling&&e.nextSibling.nodeType===3) e.nextSibling.textContent=d>0?' ngày ':'';});

  }

  tick(); timer=setInterval(tick,1000);

})();

/* Thanh dính đáy: hiện sau khi cuộn qua hero, ẩn khi tới phần đặt mua */

(function(){

  var bar = document.getElementById('sticky'), hero = document.getElementById('top'), order = document.getElementById('dat-mua');

  function upd(){

    var pastHero = hero.getBoundingClientRect().bottom < 0;

    var r = order.getBoundingClientRect(), atOrder = r.top < innerHeight && r.bottom > 0;

    bar.classList.toggle('hide', !pastHero || atOrder);

  }

  addEventListener('scroll', upd, {passive:true}); upd();

})();

/* Nút mục lục */

(function(){

  var btn = document.getElementById('toc-btn'), menu = document.getElementById('toc-menu');

  function set(open){ menu.hidden = !open; btn.setAttribute('aria-expanded', open); }

  btn.addEventListener('click', function(){ set(menu.hidden); });

  menu.addEventListener('click', function(e){ if(e.target.tagName==='A') set(false); });

  document.addEventListener('keydown', function(e){ if(e.key==='Escape') set(false); });

})();

/* Form đặt mua.

   FORM_ENDPOINT: link Google Apps Script / webhook để lưu đơn (để trống = chỉ hiện thông báo).

   PAYMENT_URL: link trang thanh toán sẽ chuyển tới sau khi gửi form. */

(function(){

  var form = document.getElementById('order-form');
  var submitBtn = form.querySelector('button[type="submit"]');
  var modal = document.getElementById('sepay-modal');
  var modalCloseBtn = document.getElementById('sepay-modal-close-btn');
  var modalPending = document.getElementById('sepay-modal-pending');
  var modalSuccess = document.getElementById('sepay-modal-success');
  var qrImg = document.getElementById('sepay-qr-img');
  var valCode = document.getElementById('sepay-val-code');
  var btnCopyCode = document.getElementById('btn-copy-code');
  var successOrderId = document.getElementById('sepay-success-order-id');
  var successEmail = document.getElementById('sepay-success-email');
  var formOk = document.getElementById('form-ok');

  var pollTimer = null;

  function setErr(id, msg){
    document.getElementById('e-'+id).textContent = msg;
    document.getElementById('f-'+id).setAttribute('aria-invalid', msg ? 'true':'false');
    return !msg;
  }

  // Xử lý sao chép
  document.querySelectorAll('.btn-copy').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var text = btn.getAttribute('data-copy') || '';
      if(!text) return;
      navigator.clipboard.writeText(text).then(function(){
        var origText = btn.textContent;
        btn.textContent = 'Đã chép! ✓';
        btn.classList.add('copied');
        setTimeout(function(){
          btn.textContent = origText;
          btn.classList.remove('copied');
        }, 1800);
      }).catch(function(){
        prompt('Sao chép thông tin:', text);
      });
    });
  });

  // Đóng Modal
  function closeModal(){
    if(modal) modal.hidden = true;
  }

  if(modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
  if(modal) {
    modal.addEventListener('click', function(e){
      if(e.target === modal) closeModal();
    });
  }
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });

  // Xử lý gửi Form
  form.addEventListener('submit', function(ev){
    ev.preventDefault();

    var name = form.name.value.trim();
    var phone = form.phone.value.replace(/\s+/g,'');
    var email = form.email.value.trim();
    var ok = true;

    ok = setErr('name', name.length < 2 ? 'Vui lòng nhập họ và tên.' : '') && ok;
    ok = setErr('phone', /^(\+84|0)\d{9,10}$/.test(phone) ? '' : 'Số điện thoại chưa đúng định dạng.') && ok;
    ok = setErr('email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Email chưa đúng định dạng.') && ok;

    if(!ok) return;

    var origBtnText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Đang tạo mã VietQR...';

    // Gọi API tạo đơn hàng SePay
    fetch('/api/create-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, phone: phone, email: email })
    })
    .then(function(res){ return res.json(); })
    .then(function(data){
      submitBtn.disabled = false;
      submitBtn.innerHTML = origBtnText;

      if(!data.success){
        alert(data.error || 'Có lỗi xảy ra khi tạo mã thanh toán. Vui lòng thử lại!');
        return;
      }

      // Đưa dữ liệu vào Modal
      if(qrImg) qrImg.src = data.qrUrl;
      if(valCode) valCode.textContent = data.orderId;
      if(btnCopyCode) btnCopyCode.setAttribute('data-copy', data.orderId);

      // Hiển thị phần Chờ thanh toán
      if(modalPending) modalPending.hidden = false;
      if(modalSuccess) modalSuccess.hidden = true;
      if(modal) modal.hidden = false;

      // Hủy poll cũ nếu có
      if(pollTimer) clearInterval(pollTimer);

      // Bắt đầu kiểm tra trạng thái thanh toán tự động (mỗi 2 giây)
      pollTimer = setInterval(function(){
        fetch('/api/check-order?id=' + encodeURIComponent(data.orderId) + '&t=' + Date.now())
          .then(function(r){ return r.json(); })
          .then(function(st){
            if(st && st.paid){
              clearInterval(pollTimer);
              pollTimer = null;

              // Chuyển sang màn hình thành công
              if(modalPending) modalPending.hidden = true;
              if(modalSuccess) modalSuccess.hidden = false;
              if(successOrderId) successOrderId.textContent = data.orderId;
              if(successEmail) successEmail.textContent = email;
              if(formOk) formOk.hidden = false;
              form.reset();
            }
          })
          .catch(function(){});
      }, 2000);

    })
    .catch(function(err){
      submitBtn.disabled = false;
      submitBtn.innerHTML = origBtnText;
      alert('Không thể kết nối đến máy chủ thanh toán. Vui lòng kiểm tra kết nối mạng!');
    });

  });

})();

/* Phóng to ảnh bằng chứng */

(function(){

  var lb=document.getElementById('lightbox'), li=document.getElementById('lightbox-img');

  document.querySelectorAll('.proof-img').forEach(function(btn){

    btn.addEventListener('click',function(){ var im=btn.querySelector('img'); li.src=im.src; li.alt=im.alt; lb.hidden=false; });

