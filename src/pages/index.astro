                required 
                placeholder="Nhập họ và tên của bạn..." 
                class="w-full px-4 py-3.5 rounded-xl border border-brand-line bg-brand-paper focus:outline-none focus:ring-2 focus:ring-brand-green/20 focus:border-brand-green text-sm transition-all dark:bg-dark-bg dark:border-dark-border dark:text-white"
              />
            </div>
            <div>
              <label for="newsletter-email" class="block text-xs font-bold text-brand-navy-deep dark:text-white uppercase tracking-wider mb-2">Địa chỉ Email</label>
              <input 
                type="email" 
                id="newsletter-email" 
                name="email" 
                required 
                placeholder="Nhập địa chỉ email của bạn..." 
                class="w-full px-4 py-3.5 rounded-xl border border-brand-line bg-brand-paper focus:outline-none focus:ring-2 focus:ring-brand-green/20 focus:border-brand-green text-sm transition-all dark:bg-dark-bg dark:border-dark-border dark:text-white"
              />
            </div>
            <div class="pt-2">
              <button 
                type="submit" 
                class="w-full py-4 rounded-xl bg-gradient-to-r from-brand-green to-brand-green-dark hover:from-brand-green-dark hover:to-brand-green text-white font-bold text-sm transition-all transform hover:scale-[1.02] shadow-md hover:shadow-brand-green/25 whitespace-nowrap cursor-pointer"
              >
                Đăng Ký Nhận Ngay &rarr;
              </button>
            </div>
          </form>

        </div>
