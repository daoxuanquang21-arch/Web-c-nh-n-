    </div>
  </section>

  <script>
    const initNewsletter = () => {
      const form = document.getElementById('newsletter-form');
      if (!form) return;
      
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('newsletter-name') as HTMLInputElement;
        const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
        if (!nameInput || !emailInput) return;
        
        const name = nameInput.value;
        const email = emailInput.value;
        if (!name || !email) return;

        try {
          await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email })
          });
        } catch (err) {
          console.error('Subscription API error:', err);
        }
        
        // Show success state
        const parent = form.parentElement;
        if (parent) {
          parent.innerHTML = `
            <div class="text-center py-8 space-y-4">
              <div class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 text-2xl font-bold mb-2">✓</div>
              <h3 class="text-xl font-bold text-brand-navy-deep dark:text-white">Đăng ký thành công!</h3>
              <p class="text-sm text-brand-muted dark:text-slate-300 leading-relaxed">Cảm ơn <strong>${name}</strong> đã đăng ký. Bạn sẽ nhận được các bài viết chia sẻ thực chiến mới nhất từ tôi qua email <strong>${email}</strong>.</p>
            </div>
          `;
        }
      });
    };
    initNewsletter();
    document.addEventListener('astro:page-load', initNewsletter);
  </script>

