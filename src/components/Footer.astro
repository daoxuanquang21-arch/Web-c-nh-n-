---
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: 'Khám Phá',
    links: [
      { label: 'Trang chủ', href: '/' },
      { label: 'Cuộc sống', href: '/cuoc-song' },
      { label: 'Marketing', href: '/marketing' },
      { label: 'AI & Vibe Coding', href: '/ai' }
    ]
  },
  {
    title: 'Giải Pháp',
    links: [
      { label: 'Thiết kế Website', href: '/dich-vu/thiet-ke-web' },
      { label: 'Đào tạo thực chiến', href: '/dich-vu/dao-tao' }
    ]
  },
  {
    title: 'Sản Phẩm',
    links: [
      { label: 'Digital Products', href: '/san-pham' },
      { label: 'SaaS & Micro Tools', href: '/san-pham' }
    ]
  }
];
---

<footer class="border-t border-[#164f70] bg-brand-navy-deep text-white">
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 sm:px-6 lg:px-8 lg:pt-16 lg:pb-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Brand column -->
      <div class="space-y-6 lg:col-span-4">
        <a href="/" class="flex items-center gap-2 group" aria-label="Trang chủ">
          <span class="h-8 w-8 rounded-lg bg-brand-green flex items-center justify-center text-white font-bold text-lg">
            Q
          </span>
          <span class="font-extrabold text-white text-lg tracking-tight">
            Đào Xuân Quảng
          </span>
        </a>
        <p class="text-sm text-brand-blue-soft/80 max-w-xs leading-relaxed">
          Nơi chia sẻ trải nghiệm xây dựng hệ thống bán hàng tự động bằng AI, marketing global và câu chuyện cuộc sống của Đào Xuân Quảng.
        </p>
        
        <!-- Social Links -->
        <div class="flex space-x-4">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-brand-blue-soft/60 hover:text-brand-green transition-colors" aria-label="Facebook">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c4.56-.93 8-4.96 8-9.75z"/></svg>
          </a>
          <a href="https://zalo.me" target="_blank" rel="noopener noreferrer" class="text-brand-blue-soft/60 hover:text-brand-green transition-colors" aria-label="Zalo">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6 2h12a4 4 0 0 1 4 4v12a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V6a4 4 0 0 1 4-4zm-1.8 12.3c.73 1.25 2.1 2.1 3.65 2.1.2 0 .4 0 .6-.05.85.5 2.37 1.3 2.37 1.3s-.36-1.5-.47-2.18c2.03-1.3 3.35-3.32 3.35-5.57 0-3.8-3.9-6.9-8.7-6.9S1.3 6.1 1.3 9.9c0 2.2 1.3 4.2 3.3 5.5v.9c0 .28.22.5.5.5s.5-.22.5-.5v-.9z M6.5 8h4v1l-3 3.5h3v1h-4v-1l3 -3.5h-3v-1z M12 9.5c-.8 0-1.5.7-1.5 1.5s.7 1.5 1.5 1.5c.4 0 .8-.2 1-.5v.5h1V9.5h-1v.5c-.2-.3-.6-.5-1-.5zm0 1c.3 0 .5.2.5.5s-.2.5-.5.5-.5-.2-.5-.5.2-.5.5-.5z M15.5 8h1v5.5h-1V8z M18.5 9.5c-.8 0-1.5.7-1.5 1.5s.7 1.5 1.5 1.5 1.5-.7 1.5-1.5-.7-1.5-1.5-1.5zm0 1c.3 0 .5.2.5.5s-.2.5-.5.5-.5-.2-.5-.5.2-.5.5-.5z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links columns -->
      <div class="mt-12 lg:mt-0 grid grid-cols-2 sm:grid-cols-3 gap-8 lg:col-span-8">
        {footerLinks.map((section) => (
          <div>
            <h3 class="text-sm font-semibold tracking-wider text-brand-blue uppercase">
              {section.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a 
                    href={link.href} 
                    class="text-sm text-brand-blue-soft/80 hover:text-brand-green transition-colors duration-150"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="mt-12 border-t border-white/10 pt-8 flex flex-col items-center justify-center text-center gap-3">
      <p class="text-sm text-brand-blue-soft/50">
        &copy; {currentYear} daoxuanquang.com.vn. Tất cả quyền được bảo lưu.
      </p>
      <div class="flex items-center gap-4 text-xs text-brand-blue-soft/40">
        <a href="/chinh-sach-bao-mat" class="hover:text-brand-green transition-colors">Chính sách bảo mật</a>
        <span>•</span>
        <a href="/dieu-khoan" class="hover:text-brand-green transition-colors">Điều khoản dịch vụ</a>
      </div>
    </div>
  </div>
</footer>
