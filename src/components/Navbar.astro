---
const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Cuộc sống', href: '/cuoc-song' },
  { label: 'Marketing', href: '/marketing' },
  { label: 'AI', href: '/ai' },
  { label: 'Dịch vụ', href: '/dich-vu' },
  { label: 'Sản phẩm', href: '/san-pham' }
];
---

<header class="sticky top-0 z-50 w-full border-b border-brand-line bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group" aria-label="Trang chủ">
      <span class="h-8 w-8 rounded-lg bg-brand-green flex items-center justify-center text-white font-bold text-lg">
        Q
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-lg font-bold text-brand-text hover:text-brand-green transition-colors duration-200"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right side: CTA -->
    <div class="flex items-center gap-4">
      <!-- CTA Button -->
      <a 
        href="https://zalo.me/0702286928" 
        class="hidden sm:inline-flex items-center justify-center rounded-full bg-brand-green px-4.5 py-2 text-sm font-bold text-white hover:bg-brand-green-dark transition-all duration-200 shadow-sm"
      >
        Liên hệ ngay
      </a>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-button" 
        type="button" 
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-900 md:hidden text-slate-600 dark:text-slate-300 cursor-pointer"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <!-- Menu Icon -->
        <svg id="menu-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon -->
        <svg id="close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-brand-line bg-white/95 backdrop-blur-md">
    <div class="space-y-1 px-4 py-3">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="block rounded-md px-3 py-2 text-base font-medium text-brand-text hover:bg-brand-paper hover:text-brand-green"
        >
          {item.label}
        </a>
      ))}
      <div class="border-t border-brand-line pt-4 mt-4 pb-2">
        <a 
          href="https://zalo.me/0702286928" 
          class="flex w-full items-center justify-center rounded-full bg-brand-green px-4.5 py-2.5 text-center text-sm font-bold text-white hover:bg-brand-green-dark"
        >
          Liên hệ ngay
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
